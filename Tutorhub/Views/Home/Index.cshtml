            <div class="rounded-2xl overflow-hidden border border-black/5" style="background-color:#FAF9F4;">
                <img src="https://i.ibb.co.com/pB4DZS31/Progress-Tracking.png" alt="Progress Tracking" class="w-full h-36 sm:h-40 md:h-44 object-cover" />
                <div class="p-4 sm:p-5 md:p-6">
                    <h3 class="text-base sm:text-lg font-bold text-[#1F3B2C]">Progress Tracking</h3>
                    <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm leading-5 sm:leading-6" style="color:#6B7568;">
                        Visual dashboards showing subject-wise performance, strengths, and growth
                    </p>
                </div>
            </div>

            <div class="rounded-2xl overflow-hidden border border-black/5" style="background-color:#FAF9F4;">
                <img src="https://i.ibb.co.com/LdYcRnHX/Gamification.webp" alt="Gamification" class="w-full h-36 sm:h-40 md:h-44 object-cover" />
                <div class="p-4 sm:p-5 md:p-6">
                    <h3 class="text-base sm:text-lg font-bold text-[#1F3B2C]">Gamification</h3>
                    <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm leading-5 sm:leading-6" style="color:#6B7568;">
                        Earn points, badges, levels, streaks — compete on leaderboards with friends
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

