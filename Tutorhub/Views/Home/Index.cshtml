@model List<Tutorbub.Models.User>

@{
    ViewData["Title"] = "Home";
}

<!-- ========================================= -->
<!-- HERO SECTION -->
<!-- ========================================= -->
<section class="relative overflow-hidden bg-white">
    <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[85vh]">

        <!-- Left Side -->
        <div class="relative flex flex-col justify-center px-4 sm:px-6 md:px-10 lg:px-20 py-12 sm:py-16 md:py-20 lg:py-0"
             style="background-color:#F3F1E7;
            background-image: radial-gradient(#d8d4c4 1px, transparent 1px);
            background-size: 26px 26px;">

            <div class="relative max-w-lg mx-auto lg:mx-0">
                <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl leading-[1.15] text-[#1F3B2C] text-center lg:text-left">
                    Learn Your Way,<br />
                    Master Every Step
                </h1>

                <p class="mt-4 sm:mt-6 text-sm sm:text-base md:text-lg leading-6 sm:leading-7 md:leading-8 text-center lg:text-left" style="color:#5B6B5E;">
                    Personalized lessons that adapt to you — because every mind
                    learns differently. Turn your weaknesses into strengths with
                    smart, tutor‑driven guidance.
                </p>

                <div class="text-center lg:text-left">
                    <a href="#how-it-works"
                       class="inline-flex items-center gap-1.5 mt-6 sm:mt-8 font-semibold border-b-2 pb-1 transition hover:gap-2.5"
                       style="color:#1F3B2C; border-color:#1F3B2C;">
                        Start Your Journey
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" />
                        </svg>
                    </a>
                </div>
            </div>

            <div class="hidden lg:block absolute top-0 right-0 h-full w-40 pointer-events-none"
                 style="background: linear-gradient(to right, #F3F1E7 0%, rgba(243,241,231,0.7) 35%, rgba(243,241,231,0) 100%);
                transform: translateX(100%);
                z-index: 10;">
            </div>
        </div>

        <!-- Right Side: Image -->
        <div class="relative min-h-[250px] sm:min-h-[300px] md:min-h-[350px] lg:min-h-full order-first lg:order-last">
            <img src="https://i.ibb.co.com/pqbXLMx/learn-learning-education-studying-concept.jpg"
                 alt="Learning concept desk flat lay"
                 class="absolute inset-0 w-full h-full object-cover" />

            <div class="absolute inset-0 pointer-events-none"
                 style="background: linear-gradient(to bottom, rgba(243,241,231,0.3) 0%, rgba(243,241,231,0) 50%, rgba(243,241,231,0) 100%);">
            </div>
        </div>

    </div>
</section>

<!-- ========================================= -->
<!-- HOW IT WORKS -->
<!-- ========================================= -->
<section id="how-it-works" class="py-8 sm:py-10 md:py-12 lg:py-16" style="background-color:#F3F1E7;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#1F3B2C]">
            How It Works
        </h2>
        <p class="mt-3 text-base sm:text-lg" style="color:#5B6B5E;">
            Your personalized learning journey in four simple steps
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 md:gap-6 mt-6 sm:mt-8 md:mt-10 text-left">

            <!-- Step 1 -->
            <div class="p-5 sm:p-6 md:p-7 rounded-2xl border border-black/5" style="background-color:#FAF9F4;">
                <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full flex items-center justify-center mx-auto sm:mx-0" style="background-color:#E7E4D9;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="#1F3B2C" class="w-5 h-5 sm:w-6 sm:h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                    </svg>
                </div>
                <h3 class="mt-4 sm:mt-5 md:mt-6 text-lg sm:text-xl font-bold text-[#1F3B2C] text-center sm:text-left">Choose a Topic</h3>
                <p class="mt-2 sm:mt-3 text-xs sm:text-sm leading-5 sm:leading-6 text-center sm:text-left" style="color:#6B7568;">
                    Pick any subject or topic you want to master — from Algebra to Physics
                </p>
            </div>

            <!-- Step 2 -->
            <div class="p-5 sm:p-6 md:p-7 rounded-2xl border border-black/5" style="background-color:#FAF9F4;">
                <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full flex items-center justify-center mx-auto sm:mx-0" style="background-color:#E7E4D9;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="#1F3B2C" class="w-5 h-5 sm:w-6 sm:h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.369 0 .713.128 1.003.349.283.215.604.401.959.401v0a.656.656 0 0 0 .659-.663 47.703 47.703 0 0 0-.31-4.82.657.657 0 0 0-.66-.611v0c-.355 0-.676.186-.959.401a1.647 1.647 0 0 1-1.003.349c-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.369 0 .713.128 1.003.349.283.215.604.401.959.401v0" />
                    </svg>
                </div>
                <h3 class="mt-4 sm:mt-5 md:mt-6 text-lg sm:text-xl font-bold text-[#1F3B2C] text-center sm:text-left">Practice</h3>
                <p class="mt-2 sm:mt-3 text-xs sm:text-sm leading-5 sm:leading-6 text-center sm:text-left" style="color:#6B7568;">
                    Solve adaptive questions that adjust to your current skill level
                </p>
            </div>

            <!-- Step 3 -->
            <div class="p-5 sm:p-6 md:p-7 rounded-2xl border border-black/5" style="background-color:#FAF9F4;">
                <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full flex items-center justify-center mx-auto sm:mx-0" style="background-color:#E7E4D9;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="#1F3B2C" class="w-5 h-5 sm:w-6 sm:h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
                    </svg>
                </div>
                <h3 class="mt-4 sm:mt-5 md:mt-6 text-lg sm:text-xl font-bold text-[#1F3B2C] text-center sm:text-left">AI Analyzes</h3>
                <p class="mt-2 sm:mt-3 text-xs sm:text-sm leading-5 sm:leading-6 text-center sm:text-left" style="color:#6B7568;">
                    Our AI identifies your mistakes, weak spots, and learning patterns
                </p>
            </div>

            <!-- Step 4 -->
            <div class="p-5 sm:p-6 md:p-7 rounded-2xl border border-black/5" style="background-color:#FAF9F4;">
                <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full flex items-center justify-center mx-auto sm:mx-0" style="background-color:#E7E4D9;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="#1F3B2C" class="w-5 h-5 sm:w-6 sm:h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5 9 3v6.75h4.5L8.25 21v-7.5H3.75Z" />
                    </svg>
                </div>
                <h3 class="mt-4 sm:mt-5 md:mt-6 text-lg sm:text-xl font-bold text-[#1F3B2C] text-center sm:text-left">Improve</h3>
                <p class="mt-2 sm:mt-3 text-xs sm:text-sm leading-5 sm:leading-6 text-center sm:text-left" style="color:#6B7568;">
                    Get personalized recommendations and level up your skills
                </p>
            </div>

        </div>

        <div class="text-center">
            <a href="#key-features"
               class="inline-flex items-center gap-2 mt-6 sm:mt-8 md:mt-10 px-5 sm:px-6 md:px-7 py-2.5 sm:py-3 md:py-3.5 rounded-full font-semibold text-white transition hover:opacity-90 text-sm sm:text-base"
               style="background-color:#1F3B2C;">
                Explore Features
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3 sm:w-4 sm:h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0-4 4m4-4H3" />
                </svg>
            </a>
        </div>

    </div>
</section>

<!-- ========================================= -->
<!-- KEY FEATURES -->
<!-- ========================================= -->
<section id="key-features" class="py-8 sm:py-10 md:py-12 lg:py-16" style="background-color:#F3F1E7;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="text-center">
            <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#1F3B2C]">
                Key Features
            </h2>
            <p class="mt-3 text-base sm:text-lg" style="color:#5B6B5E;">
