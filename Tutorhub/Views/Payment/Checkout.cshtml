@model Tutorbub.Models.PaymentViewModel

@{
    ViewData["Title"] = "Checkout - " + Model.CourseTitle;
    Layout = "_Layout";
}

<style>
    .checkout-wrapper {
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .checkout-grid {
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 30px;
        align-items: start;
    }

    .payment-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.08);
        border: 1px solid rgba(0,0,0,0.04);
    }

    .payment-card h3 {
        font-size: 20px;
        font-weight: 700;
        color: #1F3B2C;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .payment-card h3 i {
        color: #1F3B2C;
    }

    .qr-section {
        text-align: center;
        padding: 20px;
        background: #FAF9F4;
        border-radius: 16px;
        border: 2px dashed #D5CFB8;
        margin-bottom: 24px;
    }

    .qr-section img {
        max-width: 250px;
        width: 100%;
        border-radius: 12px;
        border: 3px solid white;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

    .qr-section .scan-text {
        margin-top: 14px;
        font-size: 14px;
        color: #5B6B5E;
        font-weight: 500;
    }

    .qr-section .scan-text strong {
        color: #1F3B2C;
    }

    .amount-display {
        background: linear-gradient(135deg, #1F3B2C, #2d5a42);
        color: white;
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .amount-display .label {
        font-size: 14px;
        opacity: 0.9;
    }

    .amount-display .value {
        font-size: 28px;
        font-weight: 800;
    }

    .payment-methods {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 24px;
    }

    .payment-method-option {
        position: relative;
    }

    .payment-method-option input[type="radio"] {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .payment-method-option label {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 16px 10px;
        border: 2px solid #E5E1D3;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.25s;
        background: #FAF9F4;
        text-align: center;
    }

    .payment-method-option label:hover {
        border-color: #1F3B2C;
        transform: translateY(-2px);
    }

    .payment-method-option input[type="radio"]:checked + label {
        border-color: #1F3B2C;
        background: #1F3B2C;
        color: white;
        box-shadow: 0 4px 16px rgba(31,59,44,0.25);
    }

    .payment-method-option label .method-icon {
        font-size: 24px;
        margin-bottom: 6px;
    }

    .payment-method-option label .method-name {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.3px;
    }

    .payment-method-option label .method-color {
        font-size: 10px;
        opacity: 0.7;
        margin-top: 2px;
    }

    .field-group {
        margin-bottom: 18px;
    }

    .field-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #1F3B2C;
        margin-bottom: 7px;
    }

    .field-group label .req {
        color: #e74c3c;
    }

    .field-group input {
        width: 100%;
        padding: 12px 16px;
        border: 1.5px solid #E5E1D3;
        border-radius: 10px;
        font-size: 14px;
        background: #FAF9F4;
        outline: none;
        transition: all 0.25s;
        color: #1F3B2C;
        font-family: inherit;
    }

    .field-group input:focus {
        border-color: #1F3B2C;
        background: white;
        box-shadow: 0 0 0 3px rgba(31,59,44,0.08);
    }

    .field-group .hint {
        font-size: 11.5px;
        color: #8A9188;
        margin-top: 5px;
    }

    .btn-pay {
        width: 100%;
        padding: 16px;
        background: #1F3B2C;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 8px;
    }

    .btn-pay:hover {
        opacity: 0.88;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(31,59,44,0.3);
    }

    .order-summary {
        background: white;
        border-radius: 20px;
        padding: 26px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.08);
        border: 1px solid rgba(0,0,0,0.04);
        position: sticky;
        top: 100px;
    }

    .order-summary h4 {
        font-size: 17px;
        font-weight: 700;
        color: #1F3B2C;
        margin-bottom: 18px;
        padding-bottom: 14px;
        border-bottom: 1px solid #f0f0f0;
    }

    .summary-course {
        display: flex;
        gap: 14px;
        align-items: center;
        margin-bottom: 18px;
        padding-bottom: 18px;
        border-bottom: 1px solid #f0f0f0;
    }

    .summary-course img {
        width: 70px;
        height: 70px;
        border-radius: 12px;
        object-fit: cover;
        flex-shrink: 0;
    }

    .summary-course .info h5 {
        font-size: 14px;
        font-weight: 700;
        color: #1F3B2C;
        margin: 0 0 4px;
        line-height: 1.3;
    }

    .summary-course .info p {
        font-size: 12px;
        color: #8A9188;
        margin: 0;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 14px;
        color: #5B6B5E;
    }

    .summary-row.total {
        border-top: 2px solid #f0f0f0;
        margin-top: 8px;
        padding-top: 14px;
        font-size: 18px;
        font-weight: 800;
        color: #1F3B2C;
    }

    .security-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 18px;
        padding: 12px;
        background: #FAF9F4;
        border-radius: 10px;
        font-size: 12px;
        color: #6B7568;
        line-height: 1.5;
    }

    .security-badge i {
        color: #1F3B2C;
        font-size: 16px;
        flex-shrink: 0;
    }

    .alert {
        padding: 14px 18px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    @@media (max-width: 900px) {
        .checkout-grid {
            grid-template-columns: 1fr;
        }

        .order-summary {
            position: static;
            order: -1;
        }
    }

    @@media (max-width: 500px) {
        .payment-methods {
            grid-template-columns: 1fr;
        }

        .payment-card {
            padding: 20px 16px;
        }
    }
</style>

<div class="checkout-wrapper">
    <div class="mb-4">
        <a href="/Learn/Details/@Model.CourseId" style="color:#6B7568; text-decoration:none; font-size:14px;">
            <i class="fas fa-arrow-left me-1"></i> Back to Course
        </a>
        <h2 style="font-family:'Georgia',serif; font-size:28px; color:#1F3B2C; margin-top:10px;">
            <i class="fas fa-lock me-2" style="font-size:22px;"></i>Secure Checkout
        </h2>
        <p style="color:#6B7568; font-size:14px;">Complete your payment to enroll in this course</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]</div>
    }

    <div class="checkout-grid">
        <!-- বাম: পেমেন্ট ফর্ম -->
        <div class="payment-card">
            <h3><i class="fas fa-qrcode"></i> Step 1: Scan &amp; Pay</h3>

            <div class="qr-section">
                <img src="https://i.ibb.co.com/j976L4sX/payment.jpg" alt="Payment QR Code" />
                <p class="scan-text">
                    <i class="fas fa-mobile-alt me-1"></i>
                    Scan this QR code with your <strong>bKash / Nagad / Rocket</strong> app
                </p>
                <p class="scan-text" style="font-size:12px; color:#8A9188; margin-top:4px;">
                    Send exactly <strong>৳@Model.Price.ToString("N0")</strong> to the number shown in the QR
                </p>
            </div>

            <div class="amount-display">
                <div>
                    <div class="label">Amount to Pay</div>
                    <div class="value">৳@Model.Price.ToString("N0")</div>
                </div>
                <i class="fas fa-money-bill-wave" style="font-size:36px; opacity:0.3;"></i>
            </div>

            <h3><i class="fas fa-check-circle"></i> Step 2: Submit Payment Info</h3>

            <form method="post" asp-controller="Payment" asp-action="SubmitPayment" id="paymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CourseId" value="@Model.CourseId" />
                <input type="hidden" name="CourseTitle" value="@Model.CourseTitle" />
                <input type="hidden" name="CourseImage" value="@Model.CourseImage" />
                <input type="hidden" name="Price" value="@Model.Price" />
                <input type="hidden" name="Instructor" value="@Model.Instructor" />
                <input type="hidden" name="Duration" value="@Model.Duration" />

                <div class="field-group">
                    <label>Select Payment Method <span class="req">*</span></label>
                    <div class="payment-methods">
                        <div class="payment-method-option">
                            <input type="radio" name="PaymentMethod" id="method-bkash" value="bKash" required />
                            <label for="method-bkash">
                                <span class="method-icon">💳</span>
                                <span class="method-name">bKash</span>
                                <span class="method-color">Pink</span>
                            </label>
                        </div>
                        <div class="payment-method-option">
                            <input type="radio" name="PaymentMethod" id="method-nagad" value="Nagad" required />
                            <label for="method-nagad">
                                <span class="method-icon">🟠</span>
                                <span class="method-name">Nagad</span>
                                <span class="method-color">Orange</span>
                            </label>
                        </div>
                        <div class="payment-method-option">
                            <input type="radio" name="PaymentMethod" id="method-rocket" value="Rocket" required />
                            <label for="method-rocket">
                                <span class="method-icon">🚀</span>
                                <span class="method-name">Rocket</span>
                                <span class="method-color">Purple</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="field-group">
                    <label>Transaction ID <span class="req">*</span></label>
                    <input type="text" name="TransactionId" id="transactionId"
                           placeholder="e.g., 8N7A2B3C4D" required
                           style="text-transform:uppercase;" />
                    <div class="hint"><i class="fas fa-info-circle me-1"></i>You'll find this in your payment confirmation SMS</div>
                </div>

                <div class="field-group">
                    <label>Your Payment Mobile Number <span class="req">*</span></label>
                    <input type="tel" name="SenderMobileNumber" id="senderMobile"
                           placeholder="01XXXXXXXXX" required
                           pattern="01[3-9][0-9]{8}" maxlength="11" />
                    <div class="hint"><i class="fas fa-info-circle me-1"></i>The number you sent the money from</div>
                </div>

                <div id="formError" class="alert alert-danger" style="display:none;"></div>

                <button type="submit" class="btn-pay" id="payBtn">
                    <i class="fas fa-paper-plane"></i> Submit Payment for Verification
                </button>

                <p style="text-align:center; font-size:12px; color:#8A9188; margin-top:14px;">
                    <i class="fas fa-shield-alt me-1"></i>
                    Your payment will be verified by our admin team within 24 hours
                </p>
            </form>
        </div>

        <!-- ডান: অর্ডার সামারি -->
        <div class="order-summary">
            <h4><i class="fas fa-receipt me-2"></i>Order Summary</h4>

            <div class="summary-course">
                <img src="@Model.CourseImage" alt="@Model.CourseTitle" />
                <div class="info">
                    <h5>@Model.CourseTitle</h5>
                    <p><i class="fas fa-user-graduate me-1"></i>@Model.Instructor</p>
                    <p><i class="fas fa-clock me-1"></i>@Model.Duration</p>
                </div>
            </div>

            <div class="summary-row">
                <span>Course Price</span>
                <span>৳@Model.Price.ToString("N0")</span>
            </div>
            <div class="summary-row">
                <span>Processing Fee</span>
                <span style="color:#2ecc71;">Free</span>
            </div>
            <div class="summary-row total">
                <span>Total</span>
                <span>৳@Model.Price.ToString("N0")</span>
            </div>

            <div class="security-badge">
                <i class="fas fa-lock"></i>
                <span>Your payment information is secure. We verify every transaction manually for your safety.</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('paymentForm').addEventListener('submit', function (e) {
            var method = document.querySelector('input[name="PaymentMethod"]:checked');
            var txId = document.getElementById('transactionId').value.trim();
            var mobile = document.getElementById('senderMobile').value.trim();
            var formError = document.getElementById('formError');

            if (!method) {
                e.preventDefault();
                formError.textContent = 'Please select a payment method (bKash, Nagad, or Rocket).';
                formError.style.display = 'block';
                return;
            }

            if (txId.length < 6) {
                e.preventDefault();
                formError.textContent = 'Transaction ID seems too short. Please enter the full ID.';
                formError.style.display = 'block';
                return;
            }

            if (!/^01[3-9][0-9]{8}$/.test(mobile)) {
                e.preventDefault();
                formError.textContent = 'Please enter a valid Bangladeshi mobile number (e.g., 01712345678).';
                formError.style.display = 'block';
                return;
            }

            formError.style.display = 'none';

            var btn = document.getElementById('payBtn');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
            btn.disabled = true;
        });

        document.getElementById('transactionId').addEventListener('input', function () {
            this.value = this.value.toUpperCase();
        });
    </script>
}