@model List<Tutorbub.Models.CourseOrder>

@{
    ViewData["Title"] = "My Orders";
    Layout = "_Layout";
}

<style>
    .orders-wrapper {
        max-width: 900px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .orders-wrapper h2 {
        font-family: 'Georgia', serif;
        font-size: 28px;
        color: #1F3B2C;
        margin-bottom: 6px;
    }

    .orders-wrapper .subtitle {
        color: #6B7568;
        font-size: 14px;
        margin-bottom: 24px;
    }

    .order-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.04);
        display: flex;
        gap: 18px;
        align-items: center;
        transition: box-shadow 0.3s;
    }

    .order-card:hover {
        box-shadow: 0 8px 30px rgba(0,0,0,0.1);
    }

    .order-card img {
        width: 90px;
        height: 90px;
        border-radius: 12px;
        object-fit: cover;
        flex-shrink: 0;
    }

    .order-info {
        flex: 1;
        min-width: 0;
    }

    .order-info h5 {
        font-size: 16px;
        font-weight: 700;
        color: #1F3B2C;
        margin: 0 0 6px;
    }

    .order-info .meta {
        font-size: 13px;
        color: #8A9188;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .order-info .meta span i {
        margin-right: 4px;
    }

    .status-badge {
        padding: 6px 16px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        flex-shrink: 0;
    }

    .status-badge.pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-badge.approved {
        background: #d4edda;
        color: #155724;
    }

    .status-badge.rejected {
        background: #f8d7da;
        color: #721c24;
    }

    .btn-view {
        padding: 8px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
        flex-shrink: 0;
    }

    .btn-view.pending {
        background: #FAF9F4;
        color: #1F3B2C;
        border: 1.5px solid #1F3B2C;
    }

    .btn-view.approved {
        background: #1F3B2C;
        color: white;
    }

    .btn-view.rejected {
        background: #f8d7da;
        color: #721c24;
        border: 1.5px solid #e74c3c;
    }

    .btn-view:hover {
        opacity: 0.8;
        color: inherit;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }

    .empty-state i {
        font-size: 56px;
        color: #E7E4D9;
        margin-bottom: 16px;
        display: block;
    }

    .empty-state h5 {
        color: #1F3B2C;
        margin-bottom: 6px;
    }

    .empty-state p {
        color: #8A9188;
        font-size: 14px;
        margin-bottom: 20px;
    }

    @@media (max-width: 600px) {
        .order-card {
            flex-direction: column;
            text-align: center;
        }

        .order-card img {
            width: 100%;
            height: 140px;
        }

        .order-info .meta {
            justify-content: center;
        }
    }
</style>

<div class="orders-wrapper">
    <h2><i class="fas fa-shopping-bag me-2"></i>My Orders</h2>
    <p class="subtitle">Track your course purchases and payment status</p>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-receipt"></i>
            <h5>No orders yet</h5>
            <p>You haven't purchased any courses. Browse our courses and start learning!</p>
            <a href="/Learn/Index" style="display:inline-flex; padding:12px 32px; background:#1F3B2C; color:white; border-radius:10px; text-decoration:none; font-weight:600;">
                <i class="fas fa-graduation-cap me-2"></i>Browse Courses
            </a>
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            var statusClass = order.PaymentStatus.ToLower();
            <div class="order-card">
                <img src="@order.CourseImage" alt="@order.CourseName" />
                <div class="order-info">
                    <h5>@order.CourseName</h5>
                    <div class="meta">
                        <span><i class="fas fa-money-bill-wave"></i> ৳@order.Price.ToString("N0")</span>
                        <span><i class="fas fa-credit-card"></i> @order.PaymentMethod</span>
                        <span><i class="fas fa-calendar"></i> @order.OrderDate.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
                <span class="status-badge @statusClass">@order.PaymentStatus</span>
                <a href="/Payment/PaymentStatus?orderId=@order.Id" class="btn-view @statusClass">
                    View Details
                </a>
            </div>
        }
    }
</div>