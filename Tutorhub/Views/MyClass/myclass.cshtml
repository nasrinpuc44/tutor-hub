@model List<Tutorbub.Models.EnrolledCourseViewModel>

@{
    ViewData["Title"] = "My Class - Smart Tutor Hub";
    Layout = "_Layout";
}

<style>
    .mc-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px 60px;
    }

    .mc-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .mc-header h1 {
        font-family: 'Georgia', serif;
        font-size: 34px;
        color: #1F3B2C;
        margin: 0 0 8px;
        font-weight: 700;
    }

    .mc-header p {
        color: #5B6B5E;
        font-size: 15.5px;
        margin: 0;
    }

    .mc-stats-bar {
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

    .mc-stat-pill {
        background: white;
        border-radius: 30px;
        padding: 10px 22px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: #1F3B2C;
        font-size: 14px;
    }

    .mc-stat-pill i {
        color: #1F3B2C;
    }

    /* ===== কোর্স কার্ড গ্রিড ===== */
    .mc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 22px;
    }

    .mc-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        transition: transform 0.3s, box-shadow 0.3s;
        display: flex;
        flex-direction: column;
    }

    .mc-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 34px rgba(31,59,44,0.12);
    }

    .mc-card .mc-thumb {
        position: relative;
        height: 160px;
        overflow: hidden;
        background: #E7E4D9;
    }

    .mc-card .mc-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .mc-card .mc-thumb .mc-badge-enrolled {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(46,204,113,0.95);
        color: white;
        padding: 4px 12px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .mc-card .mc-body {
        padding: 18px 20px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .mc-card .mc-body h4 {
        font-size: 16px;
        font-weight: 700;
        color: #1F3B2C;
        margin: 0 0 10px;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 44px;
    }

    .mc-meta-row {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 13px;
        color: #6B7568;
        margin-bottom: 14px;
    }

    .mc-meta-row span i {
        width: 16px;
        color: #1F3B2C;
        margin-right: 6px;
        text-align: center;
    }

    .mc-progress {
        margin-top: auto;
        margin-bottom: 14px;
    }

    .mc-progress .bar-bg {
        height: 6px;
        background: #EEF2F6;
        border-radius: 10px;
        overflow: hidden;
    }

    .mc-progress .bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #1F3B2C, #2ecc71);
        width: 0%;
        border-radius: 10px;
        transition: width 0.6s ease;
    }

    .mc-progress .bar-label {
        display: flex;
        justify-content: space-between;
        font-size: 11.5px;
        color: #8A9188;
        margin-top: 5px;
        font-weight: 600;
    }

    .mc-btn-continue {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #1F3B2C;
        color: white;
        text-decoration: none;
        padding: 12px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.25s;
        border: none;
        cursor: pointer;
    }

    .mc-btn-continue:hover {
        opacity: 0.9;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(31,59,44,0.25);
    }

    /* ===== খালি স্টেট ===== */
    .mc-empty {
        text-align: center;
        padding: 70px 20px;
        background: white;
        border-radius: 18px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.04);
    }

    .mc-empty .mc-empty-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #F3F1E7;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .mc-empty .mc-empty-icon i {
        font-size: 40px;
        color: #A8B5A9;
    }

    .mc-empty h4 {
        font-size: 20px;
        color: #1F3B2C;
        margin: 0 0 8px;
        font-weight: 700;
    }

    .mc-empty p {
        color: #6B7568;
        font-size: 14.5px;
        margin: 0 0 22px;
        max-width: 400px;
        margin-left: auto;
        margin-right: auto;
    }

    .mc-btn-browse {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 30px;
        background: #1F3B2C;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14.5px;
        transition: all 0.25s;
    }

    .mc-btn-browse:hover {
        opacity: 0.9;
        color: white;
        transform: translateY(-1px);
    }

    @@media (max-width: 576px) {
        .mc-header h1 { font-size: 24px; }
        .mc-grid { grid-template-columns: 1fr; }
        .mc-card .mc-thumb { height: 150px; }
    }
</style>

<div class="mc-wrapper">

    <!-- ===== হেডার ===== -->
    <div class="mc-header">
        <h1><i class="fas fa-chalkboard me-2" style="color:#1F3B2C;"></i>My Class</h1>
        <p>All the courses you've enrolled in — continue your learning journey</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" style="max-width:600px; margin:0 auto 20px;">@ViewBag.Error</div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <!-- ===== খালি স্টেট ===== -->
        <div class="mc-empty">
            <div class="mc-empty-icon"><i class="fas fa-book-open"></i></div>
            <h4>No classes yet</h4>
            <p>You haven't enrolled in any course yet. Browse our courses and start learning today!</p>
            <a href="/Learn/Index" class="mc-btn-browse">
                <i class="fas fa-graduation-cap"></i> Browse Courses
            </a>
        </div>
    }
    else
    {
        <!-- ===== স্ট্যাটস বার ===== -->
        <div class="mc-stats-bar">
            <div class="mc-stat-pill">
                <i class="fas fa-book"></i> @Model.Count Enrolled Course@(Model.Count > 1 ? "s" : "")
            </div>
            <div class="mc-stat-pill">
                <i class="fas fa-check-circle" style="color:#2ecc71;"></i> All Active
            </div>
        </div>

        <!-- ===== কোর্স গ্রিড ===== -->
        <div class="mc-grid">
            @foreach (var course in Model)
            {
                var image = string.IsNullOrEmpty(course.CourseImage)
                    ? "https://i.ibb.co/fd9sY88Y/IMG-6916-1.png"
                    : course.CourseImage;

                <div class="mc-card">
                    <div class="mc-thumb">
                        <img src="@image" alt="@course.CourseName" />
                        <span class="mc-badge-enrolled"><i class="fas fa-check me-1"></i>Enrolled</span>
                    </div>
                    <div class="mc-body">
                        <h4>@course.CourseName</h4>

                        <div class="mc-meta-row">
                            <span><i class="fas fa-user-graduate"></i>@course.Instructor</span>
                            <span><i class="fas fa-clock"></i>@course.Duration</span>
                            <span><i class="fas fa-book-open"></i>@course.Lessons Lessons</span>
                            <span><i class="fas fa-signal"></i>@course.Level</span>
                        </div>

                        <div class="mc-progress">
                            <div class="bar-bg">
                                <div class="bar-fill" style="width: 5%;"></div>
                            </div>
                            <div class="bar-label">
                                <span>Just started</span>
                                <span>5%</span>
                            </div>
                        </div>

                        <a href="/MyClass/Classroom?courseId=@course.CourseId" class="mc-btn-continue">
                            <i class="fas fa-play-circle"></i> Continue Learning
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>