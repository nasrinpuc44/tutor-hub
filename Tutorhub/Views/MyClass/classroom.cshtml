@model Tutorbub.Models.ClassroomViewModel

@{
    ViewData["Title"] = Model.CourseTitle + " - Classroom";
    Layout = "_Layout";

    var configuration = Context.RequestServices.GetService<IConfiguration>()!;
    var dbHelperForSubmission = new Tutorbub.Models.DatabaseHelper(configuration);
    var userIdForSubmission = int.Parse(Context.Session.GetString("UserId") ?? "0");
}

<style>
    /* ===== Classroom wrapper ===== */
    .cr-wrapper {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 24px;
        background: #F3F1E7;
        padding: 24px;
        min-height: calc(100vh - 80px);
    }

    .cr-left {
        min-width: 0;
    }

    /* ===== Assignment Banner ===== */
    .cr-assignment-banner {
        background: linear-gradient(135deg, #FFF9E6 0%, #FFFAF0 100%);
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 18px;
        border-left: 5px solid #F4C744;
        box-shadow: 0 4px 14px rgba(244, 199, 68, 0.15);
        transition: all 0.3s;
    }

        .cr-assignment-banner.graded {
            background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
            border-left-color: #2ecc71;
            box-shadow: 0 4px 14px rgba(46, 204, 113, 0.15);
        }

        .cr-assignment-banner.submitted {
            background: linear-gradient(135deg, #FFF9E6 0%, #FFFAF0 100%);
            border-left-color: #f39c12;
        }

        .cr-assignment-banner h6 {
            color: #1F3B2C;
            font-weight: 700;
            margin: 0 0 8px;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

            .cr-assignment-banner h6 > i {
                color: #D98E1F;
            }

        .cr-assignment-banner.graded h6 > i {
            color: #2ecc71;
        }

    .status-badge-banner {
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-left: auto;
    }

        .status-badge-banner.graded {
            background: #2ecc71;
            color: white;
        }

        .status-badge-banner.submitted {
            background: #fff3cd;
            color: #856404;
        }

        .status-badge-banner.resubmitted {
            background: #cfe2ff;
            color: #084298;
        }

        .status-badge-banner.pending {
            background: #e7e4d9;
            color: #6B7568;
        }

    .cr-assignment-banner .assign-meta {
        display: flex;
        gap: 16px;
        font-size: 12.5px;
        color: #6B7568;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

        .cr-assignment-banner .assign-meta i {
            color: #D98E1F;
            margin-right: 5px;
        }

    .cr-assignment-banner.graded .assign-meta i {
        color: #2ecc71;
    }

    .cr-assignment-banner .assign-title {
        color: #1F3B2C;
        font-weight: 700;
        font-size: 14.5px;
        margin: 0 0 4px;
    }

    .cr-assignment-banner .assign-desc {
        color: #5B6B5E;
        font-size: 13px;
        margin: 0 0 8px;
        line-height: 1.55;
    }

    .cr-assignment-banner details {
        margin-top: 8px;
    }

    .cr-assignment-banner summary {
        cursor: pointer;
        color: #1F3B2C;
        font-size: 12.5px;
        font-weight: 600;
        list-style: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .cr-assignment-banner summary::-webkit-details-marker,
        .cr-assignment-banner summary::marker {
            display: none;
        }

        .cr-assignment-banner summary i {
            transition: transform 0.2s;
            font-size: 10px;
        }

    .cr-assignment-banner details[open] summary i {
        transform: rotate(90deg);
    }

    .cr-assignment-banner .instr-box {
        margin-top: 8px;
        padding-left: 14px;
        border-left: 3px solid #F4C744;
        font-size: 12.5px;
        color: #5B6B5E;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .cr-submit-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        padding: 11px 24px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
        font-size: 13.5px;
        transition: all 0.25s;
        border: none;
        cursor: pointer;
    }

        .cr-submit-btn.primary {
            background: #1F3B2C;
            color: white;
        }

            .cr-submit-btn.primary:hover {
                opacity: 0.9;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(31,59,44,0.25);
                color: white;
            }

        .cr-submit-btn.graded {
            background: #2ecc71;
            color: white;
        }

            .cr-submit-btn.graded:hover {
                background: #27ae60;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(46,204,113,0.35);
                color: white;
            }

        .cr-submit-btn.pending {
            background: #f39c12;
            color: white;
        }

            .cr-submit-btn.pending:hover {
                background: #e67e22;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(243,156,18,0.35);
                color: white;
            }

    /* ===== Video wrap ===== */
    .cr-video-wrap {
        background: #1F3B2C;
        border-radius: 16px;
        overflow: hidden;
        aspect-ratio: 16 / 9;
        position: relative;
        box-shadow: 0 10px 34px rgba(31,59,44,0.18);
    }

        .cr-video-wrap video {
            width: 100%;
            height: 100%;
            display: block;
            background: #1F3B2C;
        }

    /* ===== Lesson info card ===== */
    .cr-info-card {
        background: white;
        border-radius: 16px;
        padding: 22px 24px;
        margin-top: 18px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.04);
    }

    .cr-eyebrow {
        font-size: 11.5px;
        color: #8A9188;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .cr-info-card h2 {
        font-size: 22px;
        font-weight: 700;
        color: #1F3B2C;
        margin: 0 0 12px;
        line-height: 1.3;
        font-family: 'Georgia', serif;
    }

    .cr-lesson-meta {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        font-size: 13px;
        color: #6B7568;
        padding-top: 12px;
        border-top: 1px solid #f0f0f0;
    }

        .cr-lesson-meta span i {
            margin-right: 6px;
            color: #1F3B2C;
        }

    .cr-nav-buttons {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .cr-nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 26px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.25s;
        border: none;
    }

    .cr-nav-prev {
        background: white;
        color: #1F3B2C;
        border: 1.5px solid #1F3B2C;
    }

        .cr-nav-prev:hover {
            background: #F3F1E7;
        }

    .cr-nav-next {
        background: #1F3B2C;
        color: white;
        box-shadow: 0 6px 18px rgba(31,59,44,0.25);
    }

        .cr-nav-next:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            box-shadow: 0 8px 22px rgba(31,59,44,0.35);
        }

    /* ===== Tabs card ===== */
    .cr-tabs-card {
        background: white;
        border-radius: 16px;
        margin-top: 18px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.04);
        overflow: hidden;
    }

    .cr-tabs {
        display: flex;
        gap: 4px;
        padding: 0 12px;
        border-bottom: 1px solid #f0f0f0;
        overflow-x: auto;
        background: #FAF9F4;
    }

    .cr-tab {
        background: transparent;
        border: none;
        color: #6B7568;
        padding: 15px 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

        .cr-tab:hover {
            color: #1F3B2C;
        }

        .cr-tab.active {
            color: #1F3B2C;
            border-bottom-color: #1F3B2C;
        }

        .cr-tab i {
            font-size: 14px;
        }

    .cr-tab-content {
        padding: 22px 24px 26px;
        color: #4B5648;
        font-size: 14px;
        line-height: 1.7;
        min-height: 180px;
    }

        .cr-tab-content textarea {
            width: 100%;
            background: #FAF9F4;
            border: 1.5px solid #E5E1D3;
            border-radius: 10px;
            color: #1F3B2C;
            padding: 14px 16px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            resize: vertical;
            min-height: 120px;
            transition: border-color 0.2s;
        }

            .cr-tab-content textarea:focus {
                border-color: #1F3B2C;
                box-shadow: 0 0 0 3px rgba(31,59,44,0.08);
                background: white;
            }

    .cr-btn-save {
        background: #1F3B2C;
        color: white;
        border: none;
        padding: 11px 28px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
        margin-top: 14px;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .cr-btn-save:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    /* ===== RIGHT: Module Sidebar ===== */
    .cr-right {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.04);
        overflow: hidden;
        position: sticky;
        top: 100px;
        max-height: calc(100vh - 120px);
        display: flex;
        flex-direction: column;
    }

    .cr-right-head {
        padding: 20px 20px 16px;
        border-bottom: 1px solid #f0f0f0;
        background: #FAF9F4;
    }

    .cr-search {
        position: relative;
        margin-bottom: 16px;
    }

        .cr-search input {
            width: 100%;
            background: white;
            border: 1.5px solid #E5E1D3;
            border-radius: 10px;
            color: #1F3B2C;
            padding: 11px 14px 11px 42px;
            font-size: 13.5px;
            outline: none;
            transition: all 0.2s;
        }

            .cr-search input::placeholder {
                color: #A8B5A9;
            }

            .cr-search input:focus {
                border-color: #1F3B2C;
                box-shadow: 0 0 0 3px rgba(31,59,44,0.08);
            }

        .cr-search i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #8A9188;
            font-size: 14px;
        }

    .cr-progress-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12.5px;
        color: #6B7568;
        margin-bottom: 8px;
        font-weight: 500;
    }

        .cr-progress-info strong {
            color: #1F3B2C;
        }

    .cr-progress-bar {
        height: 6px;
        background: #E5E1D3;
        border-radius: 10px;
        overflow: hidden;
    }

    .cr-progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #1F3B2C, #2ecc71);
        border-radius: 10px;
        transition: width 0.6s ease;
    }

    /* ===== Modules list ===== */
    .cr-modules {
        flex: 1;
        overflow-y: auto;
        padding: 14px;
    }

        .cr-modules::-webkit-scrollbar {
            width: 6px;
        }

        .cr-modules::-webkit-scrollbar-thumb {
            background: #D5CFB8;
            border-radius: 10px;
        }

    /* ============================================================
           ✅ MILESTONE GROUP STYLING
           ============================================================ */
    .cr-milestone-group {
        background: #FFFFFF;
        border: 2px solid #E5E1D3;
        border-radius: 14px;
        padding: 14px;
        margin-bottom: 16px;
        transition: all 0.3s;
        position: relative;
    }

        .cr-milestone-group.current {
            border-color: #1F3B2C;
            box-shadow: 0 4px 16px rgba(31,59,44,0.12);
        }

        .cr-milestone-group.complete {
            border-color: #2ecc71;
            background: linear-gradient(180deg, #F0FAF3 0%, #FFFFFF 100%);
        }

    .cr-milestone-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 12px;
        margin-bottom: 12px;
        border-bottom: 2px dashed #E5E1D3;
        flex-wrap: wrap;
        gap: 8px;
    }

    .cr-milestone-group.complete .cr-milestone-header {
        border-bottom-color: #B8E6C9;
    }

    .cr-milestone-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #1F3B2C;
        color: #F4C744;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12.5px;
        font-weight: 800;
        letter-spacing: 0.3px;
        text-transform: uppercase;
    }

    .cr-milestone-group.complete .cr-milestone-badge {
        background: #2ecc71;
        color: #FFFFFF;
    }

    .cr-milestone-badge i {
        font-size: 12px;
    }

    .cr-milestone-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        font-weight: 600;
    }

    .cr-milestone-progress {
        background: #F3F1E7;
        color: #1F3B2C;
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: 700;
    }

    .cr-milestone-status {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 11.5px;
    }

        .cr-milestone-status.complete {
            background: #D4EDDA;
            color: #155724;
        }

        .cr-milestone-status.in-progress {
            background: #FFF3CD;
            color: #856404;
        }

    /* Milestone-এর ভেতরে module গুলো compact */
    .cr-milestone-group .cr-module {
        background: #FAF9F4;
        margin-bottom: 8px;
        border-radius: 10px;
    }

        .cr-milestone-group .cr-module:last-of-type {
            margin-bottom: 0;
        }

    /* ===== Regular module (no group) ===== */
    .cr-module {
        background: #FAF9F4;
        border-radius: 12px;
        margin-bottom: 10px;
        overflow: hidden;
        border: 1.5px solid #EFECE0;
        transition: border-color 0.2s;
    }

        .cr-module:hover {
            border-color: #D5CFB8;
        }

        .cr-module.open {
            border-color: #1F3B2C;
        }

    .cr-module-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 14px 16px;
        cursor: pointer;
        user-select: none;
        transition: background 0.2s;
    }

        .cr-module-header:hover {
            background: rgba(31,59,44,0.03);
        }

    .cr-module-title {
        flex: 1;
        min-width: 0;
    }

        .cr-module-title h6 {
            font-size: 13.5px;
            font-weight: 700;
            color: #1F3B2C;
            margin: 0 0 4px;
            line-height: 1.4;
        }

        .cr-module-title .cr-mod-meta {
            font-size: 11.5px;
            color: #8A9188;
            display: flex;
            gap: 8px;
            align-items: center;
            font-weight: 500;
            flex-wrap: wrap;
        }

            .cr-module-title .cr-mod-meta i {
                font-size: 10px;
                color: #1F3B2C;
            }

    .cr-module-caret {
        color: #8A9188;
        font-size: 13px;
        margin-left: 10px;
        transition: transform 0.25s;
        margin-top: 4px;
    }

    .cr-module.open .cr-module-caret {
        transform: rotate(180deg);
        color: #1F3B2C;
    }

    .cr-module-lessons {
        display: none;
        padding: 0 8px 10px;
        background: white;
    }

    .cr-module.open .cr-module-lessons {
        display: block;
    }

    .cr-lesson-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 11px 12px;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.2s;
        text-decoration: none;
        color: inherit;
        margin-top: 4px;
    }

        .cr-lesson-item:hover {
            background: #F3F1E7;
        }

        .cr-lesson-item.active {
            background: #F3F1E7;
            border-left: 3px solid #1F3B2C;
            padding-left: 9px;
        }

    .cr-lesson-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 11px;
        margin-top: 1px;
    }

        .cr-lesson-icon.completed {
            background: #2ecc71;
            color: #fff;
        }

        .cr-lesson-icon.pending {
            background: #E5E1D3;
            color: #6B7568;
        }

        .cr-lesson-icon.active-icon {
            background: #1F3B2C;
            color: #fff;
        }

    .cr-lesson-text {
        flex: 1;
        min-width: 0;
    }

        .cr-lesson-text .lt {
            font-size: 13px;
            color: #4B5648;
            font-weight: 500;
            line-height: 1.4;
            margin: 0 0 3px;
        }

    .cr-lesson-item.active .lt {
        color: #1F3B2C;
        font-weight: 700;
    }

    .cr-lesson-text .lt-meta {
        font-size: 11.5px;
        color: #8A9188;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .cr-lesson-text .lt-meta i {
            font-size: 10px;
        }

    /* ===== Quiz Button ===== */
    .cr-quiz-btn {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px;
        margin-top: 8px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        background: linear-gradient(135deg, #E8F0E9 0%, #F4F8F4 100%);
        border-left: 3px solid #1F3B2C;
    }

        .cr-quiz-btn:hover {
            background: linear-gradient(135deg, #D9EDDF 0%, #E8F0E9 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(31,59,44,0.12);
            color: inherit;
        }

        .cr-quiz-btn .quiz-icon {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #1F3B2C;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            flex-shrink: 0;
        }

        .cr-quiz-btn .quiz-text {
            flex: 1;
            min-width: 0;
        }

            .cr-quiz-btn .quiz-text .quiz-title {
                font-size: 13px;
                font-weight: 700;
                color: #1F3B2C;
                margin: 0 0 3px;
                line-height: 1.35;
            }

            .cr-quiz-btn .quiz-text .quiz-tag {
                font-size: 11.5px;
                color: #0c6b7c;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 5px;
            }

                .cr-quiz-btn .quiz-text .quiz-tag i {
                    font-size: 10px;
                }

    .cr-quiz-locked {
        padding: 12px;
        margin-top: 8px;
        background: #FFF9E6;
        border-radius: 8px;
        font-size: 12px;
        color: #8a5a00;
        text-align: center;
        border-left: 3px solid #F4C744;
    }

        .cr-quiz-locked i {
            margin-right: 5px;
        }

    /* ============================================================
           ✅ Milestone Assignment Link
           ============================================================ */
    .cr-milestone-assignment-link {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
        padding: 12px 14px;
        border-radius: 10px;
        text-decoration: none;
        color: inherit;
        transition: all 0.25s;
        border-left: 4px solid #F4C744;
        background: linear-gradient(135deg, #FFF9E6 0%, #FFFAF0 100%);
    }

        .cr-milestone-assignment-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(31,59,44,0.1);
            color: inherit;
        }

        .cr-milestone-assignment-link.graded {
            background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
            border-left-color: #2ecc71;
        }

        .cr-milestone-assignment-link.submitted {
            background: linear-gradient(135deg, #FFF9E6 0%, #FFFAF0 100%);
            border-left-color: #f39c12;
        }

        .cr-milestone-assignment-link.available {
            background: linear-gradient(135deg, #E8F0E9 0%, #F4F8F4 100%);
            border-left-color: #1F3B2C;
        }

    .cr-mal-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #1F3B2C;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .cr-milestone-assignment-link.graded .cr-mal-icon {
        background: #2ecc71;
    }

    .cr-milestone-assignment-link.submitted .cr-mal-icon {
        background: #f39c12;
    }

    .cr-mal-text {
        flex: 1;
        min-width: 0;
    }

    .cr-mal-title {
        font-size: 13px;
        font-weight: 700;
        color: #1F3B2C;
        margin: 0 0 3px;
        line-height: 1.35;
    }

    .cr-mal-sub {
        font-size: 11.5px;
        color: #6B7568;
        margin: 0;
    }

    .cr-mal-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #1F3B2C;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        flex-shrink: 0;
        text-decoration: none;
        transition: all 0.2s;
    }

        .cr-mal-btn:hover {
            transform: scale(1.1);
            background: #2d5a42;
            color: white;
        }

    .cr-milestone-assignment-link.graded .cr-mal-btn {
        background: #2ecc71;
    }

    .cr-milestone-assignment-link.submitted .cr-mal-btn {
        background: #f39c12;
    }

    /* ===== Animations ===== */
    @@keyframes quizSlideIn {
        from {
            opacity: 0;
            transform: translateY(-10px) scale(0.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(40px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* ===== Responsive ===== */
    @@media (max-width: 1100px) {
        .cr-wrapper {
            grid-template-columns: 1fr;
            padding: 16px;
        }

        .cr-right {
            position: static;
            max-height: none;
        }
    }

    @@media (max-width: 576px) {
        .cr-wrapper {
            padding: 10px;
            gap: 14px;
        }

        .cr-info-card {
            padding: 18px 16px;
        }

            .cr-info-card h2 {
                font-size: 17px;
            }

        .cr-nav-btn {
            padding: 10px 18px;
            font-size: 13px;
        }

        .cr-nav-buttons {
            justify-content: stretch;
        }

        .cr-nav-btn {
            flex: 1;
            justify-content: center;
        }

        .cr-tab {
            padding: 13px 14px;
            font-size: 13px;
        }

        .cr-tab-content {
            padding: 18px 16px;
        }

        .cr-right-head {
            padding: 16px 14px 12px;
        }

        .cr-modules {
            padding: 10px;
        }

        .status-badge-banner {
            margin-left: 0;
        }

        .cr-submit-btn {
            width: 100%;
            justify-content: center;
        }

        .cr-milestone-group {
            padding: 10px;
            margin-bottom: 12px;
        }

        .cr-milestone-badge {
            font-size: 11px;
            padding: 5px 11px;
        }

        .cr-milestone-meta {
            font-size: 11px;
        }

        .cr-milestone-progress,
        .cr-milestone-status {
            padding: 3px 8px;
            font-size: 10.5px;
        }
