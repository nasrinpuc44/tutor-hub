@{
    ViewData["Title"] = "Learn - Smart Tutor Hub";
    Layout = "_Layout";
    
    // ✅ ডেটাবেস থেকে আসা কোর্সগুলো ViewBag থেকে নিন
    var allCourses = ViewBag.AllCourses as List<Tutorbub.Models.Course> ?? new List<Tutorbub.Models.Course>();
}

<style>
    .course-card {
        border-radius: 16px;
        overflow: hidden;
        background: #FFFFFF;
        border: 1px solid rgba(0,0,0,0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .course-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 40px rgba(31, 59, 44, 0.12);
    }

    .course-card .course-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        background-color: #E7E4D9;
    }

    .course-card .course-body {
        padding: 20px 22px 22px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .course-card .course-title {
        font-size: 17px;
        font-weight: 700;
        color: #1F3B2C;
        margin-bottom: 8px;
        line-height: 1.3;
    }

    .course-card .course-desc {
        font-size: 14px;
        color: #6B7568;
        line-height: 1.5;
        margin-bottom: 14px;
        flex: 1;
    }

    .course-card .course-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        border-top: 1px solid #f0f0f0;
        padding-top: 14px;
        margin-top: 4px;
    }

    .course-card .course-price {
        font-size: 20px;
        font-weight: 800;
        color: #1F3B2C;
    }

    .course-card .course-students {
        font-size: 13px;
        color: #8A9188;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .course-card .course-students i {
        color: #1F3B2C;
    }

    .btn-enroll {
        background: #1F3B2C;
        color: #fff;
        padding: 8px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        border: none;
        transition: opacity 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-enroll:hover {
        opacity: 0.8;
        color: #fff;
    }

    .btn-outline-dark-custom {
        border: 2px solid #1F3B2C;
        color: #1F3B2C;
        background: transparent;
        padding: 8px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-outline-dark-custom:hover {
        background: #1F3B2C;
        color: #fff;
    }

    .filter-section {
        background: #FAF9F4;
        border-radius: 12px;
        padding: 16px 20px;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .filter-section select,
    .filter-section input {
        border-radius: 8px;
        border: 1px solid #ddd;
        padding: 8px 14px;
        font-size: 14px;
        background: #fff;
    }

    .filter-section select:focus,
    .filter-section input:focus {
        border-color: #1F3B2C;
        box-shadow: 0 0 0 3px rgba(31, 59, 44, 0.12);
        outline: none;
    }

    .section-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .section-header h2 {
        font-family: 'Georgia', serif;
        font-size: 38px;
        color: #1F3B2C;
        margin-bottom: 6px;
    }

    .section-header p {
        color: #6B7568;
        font-size: 16px;
    }

    .btn-reset {
        background: #FFFFFF;
        color: #1F3B2C;
        border: 2px solid #1F3B2C;
        border-radius: 8px;
        padding: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        width: 100%;
    }

    .btn-reset:hover {
        background: #1F3B2C;
        color: #FFFFFF;
    }

    @@media (max-width: 768px) {
        .section-header h2 {
            font-size: 28px;
        }

        .course-card .course-image {
            height: 160px;
        }

        .course-card .course-body {
            padding: 16px 18px 18px;
        }

        .course-card .course-title {
            font-size: 15px;
        }
    }
</style>

<!-- ===== হিরো / হেডার ===== -->
<section class="py-5" style="background-color:#F3F1E7;">
    <div class="container">
        <div class="section-header">
            <h2><i class="fas fa-graduation-cap me-2" style="color:#1F3B2C;"></i>Explore Our Courses</h2>
            <p>Learn from industry experts and take your skills to the next level</p>
        </div>

        <!-- ===== ফিল্টার বার ===== -->
        <div class="filter-section mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="fw-semibold" style="color:#1F3B2C; font-size:13px;">Search</label>
                    <input type="text" id="searchInput" class="form-control" placeholder="Search courses..." />
                </div>
                <div class="col-md-3">
                    <label class="fw-semibold" style="color:#1F3B2C; font-size:13px;">Category</label>
                    <select id="categoryFilter" class="form-select">
                        <option value="all">All Categories</option>
                        <option value="Language">Language</option>
                        <option value="Web Development">Web Development</option>
                        <option value="Frontend">Frontend</option>
                        <option value="Backend">Backend</option>
                        <option value="Design">Design</option>
                        <option value="Mobile Development">Mobile Development</option>
                        <option value="Data Science">Data Science</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="fw-semibold" style="color:#1F3B2C; font-size:13px;">Sort By</label>
                    <select id="sortFilter" class="form-select">
                        <option value="popular">Most Popular</option>
                        <option value="newest">Newest</option>
                        <option value="price-low">Price: Low to High</option>
                        <option value="price-high">Price: High to Low</option>
                    </select>
                </div>
                <div class="col-md-2 text-md-end">
                    <button class="btn-reset" onclick="resetFilters()">
                        <i class="fas fa-undo me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== কোর্স গ্রিড ===== -->
<section class="py-4" style="background-color:#F3F1E7;">
    <div class="container">
        <div class="row g-4" id="courseGrid">
            <!-- কোর্স কার্ডগুলো JS দিয়ে রেন্ডার হবে -->
        </div>

        <!-- লোড মোর বাটন -->
        <div class="text-center mt-5">
            <button class="btn-outline-dark-custom" id="loadMoreBtn" onclick="loadMoreCourses()">
                <i class="fas fa-plus-circle me-1"></i> Load More Courses
            </button>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // ✅ ডেটাবেস থেকে Razor-এর মাধ্যমে আসা কোর্সগুলো JS অবজেক্টে রূপান্তর
        const allCourses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            allCourses,
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
        ));

        console.log('📚 Total courses loaded from DB:', allCourses.length);
        if (allCourses.length > 0) {
            console.log('First course:', allCourses[0]);
        }

        let displayedCourses = [];
        let currentPage = 0;
        const pageSize = 6;

        // ===== কোর্স রেন্ডার =====
        function renderCourses(courses) {
            const grid = document.getElementById('courseGrid');

            if (!courses || courses.length === 0) {
                grid.innerHTML = `
                    <div class="col-12 text-center py-5">
                        <i class="fas fa-search" style="font-size:48px; color:#ccc;"></i>
                        <h5 class="mt-3" style="color:#6B7568;">No courses found</h5>
                        <p style="color:#8A9188;">Try adjusting your filters, or check back later!</p>
                    </div>
                `;
                return;
            }

            let html = '';
            courses.forEach(course => {
                const rating = course.rating || 0;
                const ratingStars = '★'.repeat(Math.floor(rating)) + '☆'.repeat(5 - Math.floor(rating));
                const students = course.students || 0;
                const price = course.price || 0;

                html += `
                    <div class="col-md-6 col-lg-4">
                        <div class="course-card" data-id="${course.id}">
                            <div>
                                <img src="${course.image || 'https://i.ibb.co/fd9sY88Y/IMG-6916-1.png'}" 
                                     alt="${course.title}" 
                                     class="course-image"
                                     onerror="this.src='https://i.ibb.co/fd9s88Y/IMG-6916-1.png'" />
                            </div>
                            <div class="course-body">
                                <h5 class="course-title">${course.title}</h5>
                                <p class="course-desc">
                                    ${(course.description || '').substring(0, 70)}${(course.description || '').length > 70 ? '...' : ''}
                                </p>
                                <div class="course-meta">
                                    <div>
                                        <span class="course-price">৳${price.toLocaleString()}</span>
                                    </div>
                                    <div class="course-students">
                                        <i class="fas fa-users"></i> ${(students / 1000).toFixed(1)}k
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span style="font-size:13px; color:#D98E1F;">${ratingStars} ${rating}</span>
                                    <a href="/Learn/Details/${course.id}" class="btn-enroll">
                                        View Details <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            grid.innerHTML = html;
        }

        // ===== ফিল্টার ও সর্ট =====
        function filterAndSortCourses() {
            const search = document.getElementById('searchInput').value.toLowerCase().trim();
            const category = document.getElementById('categoryFilter').value;
            const sort = document.getElementById('sortFilter').value;

            let filtered = [...allCourses];

            // সার্চ
            if (search) {
                filtered = filtered.filter(c =>
                    (c.title || '').toLowerCase().includes(search) ||
                    (c.description || '').toLowerCase().includes(search) ||
                    (c.category || '').toLowerCase().includes(search)
                );
            }

            // ক্যাটাগরি
            if (category !== 'all') {
                filtered = filtered.filter(c => c.category === category);
            }

            // সর্ট
            switch (sort) {
                case 'popular':
                    filtered.sort((a, b) => (b.students || 0) - (a.students || 0));
                    break;
                case 'newest':
                    filtered.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
                    break;
                case 'price-low':
                    filtered.sort((a, b) => (a.price || 0) - (b.price || 0));
                    break;
                case 'price-high':
                    filtered.sort((a, b) => (b.price || 0) - (a.price || 0));
                    break;
            }

            displayedCourses = filtered;
            currentPage = 0;

            const paginated = displayedCourses.slice(0, pageSize);
            renderCourses(paginated);

            // Load More বাটন দেখানো/লুকানো
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            if (loadMoreBtn) {
                loadMoreBtn.style.display = displayedCourses.length > pageSize ? 'inline-flex' : 'none';
            }
        }

        // ===== লোড মোর =====
        function loadMoreCourses() {
            currentPage++;
            const end = (currentPage + 1) * pageSize;
            const paginated = displayedCourses.slice(0, end);
            renderCourses(paginated);

            const loadMoreBtn = document.getElementById('loadMoreBtn');
            if (loadMoreBtn && end >= displayedCourses.length) {
                loadMoreBtn.style.display = 'none';
            }
        }

        // ===== রিসেট =====
        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('categoryFilter').value = 'all';
            document.getElementById('sortFilter').value = 'popular';
            filterAndSortCourses();
        }

        // ===== শুরু =====
        document.addEventListener('DOMContentLoaded', function () {
            filterAndSortCourses();

            document.getElementById('searchInput').addEventListener('input', filterAndSortCourses);
            document.getElementById('categoryFilter').addEventListener('change', filterAndSortCourses);
            document.getElementById('sortFilter').addEventListener('change', filterAndSortCourses);
        });
    </script>
}