﻿@{
    ViewData["Title"] = "Practice - Quiz Game";
    Layout = "_Layout";
}

<style>
    /* ===== গেম কন্টেইনার ===== */
    .game-container {
        max-width: 750px;
        margin: 0 auto;
        padding: 20px;
        min-height: 80vh;
    }

    /* ===== হেডার ===== */
    .game-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        padding: 16px 24px;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 10px;
    }

        .game-header .score-box {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #1F3B2C;
            color: white;
            padding: 8px 20px;
            border-radius: 30px;
            font-weight: 700;
            font-size: 18px;
        }

            .game-header .score-box i {
                font-size: 20px;
            }

        .game-header .level-badge {
            background: #F3F1E7;
            padding: 6px 18px;
            border-radius: 30px;
            font-weight: 600;
            color: #1F3B2C;
            font-size: 14px;
        }

        .game-header .progress-text {
            color: #6B7568;
            font-weight: 500;
            font-size: 14px;
        }

    /* ===== প্রশ্ন কার্ড ===== */
    .question-card {
        background: white;
        border-radius: 20px;
        padding: 32px 28px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        animation: slideUp 0.4s ease;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .question-card .q-number {
        font-size: 13px;
        font-weight: 600;
        color: #8A9188;
        letter-spacing: 1px;
        margin-bottom: 6px;
    }

    .question-card .q-text {
        font-size: 22px;
        font-weight: 700;
        color: #1F3B2C;
        margin-bottom: 24px;
        line-height: 1.4;
    }

    /* ===== অপশন বাটন ===== */
    .option-btn {
        display: block;
        width: 100%;
        padding: 14px 20px;
        margin-bottom: 10px;
        border: 2px solid #E7E4D9;
        border-radius: 12px;
        background: #FAF9F4;
        text-align: left;
        font-size: 16px;
        font-weight: 500;
        color: #1F3B2C;
        transition: all 0.25s ease;
        cursor: pointer;
    }

        .option-btn:hover:not(.disabled) {
            border-color: #1F3B2C;
            background: #F3F1E7;
            transform: translateX(4px);
        }

        .option-btn.correct {
            border-color: #2ecc71;
            background: #d4edda;
            color: #155724;
        }

        .option-btn.wrong {
            border-color: #e74c3c;
            background: #f8d7da;
            color: #721c24;
        }

        .option-btn.selected {
            border-color: #1F3B2C;
            background: #E7E4D9;
        }

        .option-btn.disabled {
            cursor: not-allowed;
            opacity: 0.7;
        }

        .option-btn .option-letter {
            display: inline-block;
            width: 28px;
            height: 28px;
            line-height: 28px;
            text-align: center;
            background: #E7E4D9;
            border-radius: 50%;
            font-weight: 700;
            font-size: 13px;
            color: #1F3B2C;
            margin-right: 12px;
            transition: 0.3s;
        }

        .option-btn.correct .option-letter {
            background: #2ecc71;
            color: white;
        }

        .option-btn.wrong .option-letter {
            background: #e74c3c;
            color: white;
        }

        .option-btn.selected .option-letter {
            background: #1F3B2C;
            color: white;
        }

    /* ===== প্রগ্রেস বার ===== */
    .progress-bar-container {
        width: 100%;
        height: 6px;
        background: #E7E4D9;
        border-radius: 10px;
        margin-bottom: 20px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        background: #1F3B2C;
        border-radius: 10px;
        transition: width 0.5s ease;
        width: 0%;
    }

    /* ===== নেভিগেশন বাটন ===== */
    .nav-buttons {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 20px;
    }

    .nav-btn {
        padding: 12px 28px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 15px;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .nav-btn:hover:not(:disabled) {
            transform: translateY(-2px);
        }

        .nav-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
        }

    .nav-btn-prev {
        background: #F3F1E7;
        color: #1F3B2C;
    }

        .nav-btn-prev:hover:not(:disabled) {
            background: #E7E4D9;
        }

    .nav-btn-next {
        background: #1F3B2C;
        color: white;
    }

        .nav-btn-next:hover:not(:disabled) {
            opacity: 0.8;
        }

    .nav-btn-submit {
        background: #2ecc71;
        color: white;
    }

        .nav-btn-submit:hover:not(:disabled) {
            background: #27ae60;
        }

    /* ===== ফলাফল পেইজ ===== */
    .result-box {
        text-align: center;
        padding: 30px 20px;
    }

        .result-box .big-icon {
            font-size: 72px;
            margin-bottom: 16px;
        }

        .result-box .result-score {
            font-size: 56px;
            font-weight: 800;
            color: #1F3B2C;
        }

        .result-box .result-label {
            color: #6B7568;
            font-size: 18px;
        }

        .result-box .result-details {
            margin: 12px 0;
            color: #6B7568;
            font-size: 15px;
        }

            .result-box .result-details .correct-count {
                color: #2ecc71;
                font-weight: 700;
            }

            .result-box .result-details .wrong-count {
                color: #e74c3c;
                font-weight: 700;
            }

        .result-box .result-message {
            color: #1F3B2C;
            font-weight: 600;
            font-size: 18px;
            margin-top: 8px;
        }

    .btn-restart {
        background: #1F3B2C;
        color: white;
        border: none;
        padding: 14px 50px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 16px;
        transition: all 0.3s;
        cursor: pointer;
        margin-top: 20px;
    }

        .btn-restart:hover {
            opacity: 0.8;
            transform: translateY(-2px);
            color: white;
        }

    /* ===== কনফেটি ===== */
    .confetti-container {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        pointer-events: none;
        z-index: 999;
        overflow: hidden;
    }

    .confetti {
        position: absolute;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        animation: confettiFall 3s ease-in forwards;
        opacity: 0;
    }

    @@keyframes confettiFall {
        0% {
            transform: translateY(-20px) rotate(0deg);
            opacity: 1;
        }

        100% {
            transform: translateY(100vh) rotate(720deg);
            opacity: 0;
        }
    }

    /* ===== রেস্পন্সিভ ===== */
    @@media (max-width: 576px) {
        .game-container {
            padding: 12px;
        }

        .question-card {
            padding: 20px 16px;
        }

            .question-card .q-text {
                font-size: 18px;
            }

        .option-btn {
            font-size: 14px;
            padding: 12px 16px;
        }

        .game-header {
            padding: 12px 16px;
        }

            .game-header .score-box {
                font-size: 15px;
                padding: 6px 14px;
            }

        .result-box .result-score {
            font-size: 40px;
        }

        .result-box .big-icon {
            font-size: 56px;
        }

        .nav-btn {
            padding: 10px 16px;
            font-size: 13px;
        }

        .nav-buttons {
            flex-wrap: wrap;
        }

            .nav-buttons .nav-btn {
                flex: 1;
                justify-content: center;
            }
    }
</style>

<div class="game-container">
    <!-- ===== হেডার ===== -->
    <div class="game-header" id="gameHeader">
        <div>
            <span class="level-badge" id="levelBadge">🎯 Easy</span>
        </div>
        <div>
            <span class="progress-text" id="progressText">1 / 10</span>
        </div>
        <div class="score-box">
            <i class="fas fa-star"></i>
            <span id="scoreDisplay">0</span>
        </div>
    </div>

    <!-- ===== প্রগ্রেস বার ===== -->
    <div class="progress-bar-container">
        <div class="progress-bar-fill" id="progressBar"></div>
    </div>

    <!-- ===== কুইজ এরিয়া ===== -->
    <div id="quizArea">
        <!-- প্রশ্ন কার্ড JS দিয়ে রেন্ডার হবে -->
    </div>
</div>

<!-- ===== কনফেটি কন্টেইনার ===== -->
<div class="confetti-container" id="confettiContainer"></div>

@section Scripts {
    <script>
        console.log('🎮 Practice page loaded!');

        // ===== ১০টি প্রশ্ন =====
        var questions = [
            {
                id: 1,
                question: "বাংলাদেশের রাজধানী কোনটি?",
                options: ["ঢাকা", "চট্টগ্রাম", "রাজশাহী", "খুলনা"],
                correctAnswerIndex: 0,
                level: "Easy"
            },
            {
                id: 2,
                question: "লাল গ্রহ নামে পরিচিত কোনটি?",
                options: ["শুক্র", "মঙ্গল", "বৃহস্পতি", "শনি"],
                correctAnswerIndex: 1,
                level: "Easy"
            },
            {
                id: 3,
                question: "পানির রাসায়নিক সংকেত কি?",
                options: ["H2O", "CO2", "NaCl", "HCl"],
                correctAnswerIndex: 0,
                level: "Medium"
            },
            {
                id: 4,
                question: "'The Great Gatsby' বইটির লেখক কে?",
                options: ["আর্নেস্ট হেমিংওয়ে", "এফ. স্কট ফিটজেরাল্ড", "মার্ক টোয়েন", "জেন অস্টেন"],
                correctAnswerIndex: 1,
                level: "Medium"
            },
            {
                id: 5,
                question: "সবচেয়ে দ্রুতগতির স্থলজ প্রাণী কোনটি?",
                options: ["সিংহ", "চিতা", "চিতাবাঘ", "বাঘ"],
                correctAnswerIndex: 1,
                level: "Easy"
            },
            {
                id: 6,
                question: "আর্টিফিশিয়াল ইন্টেলিজেন্সের জন্য কোন প্রোগ্রামিং ভাষা বেশি ব্যবহৃত হয়?",
                options: ["Python", "Java", "C++", "Ruby"],
                correctAnswerIndex: 0,
                level: "Hard"
            },
            {
                id: 7,
                question: "পৃথিবীর বৃহত্তম মহাসাগর কোনটি?",
                options: ["আটলান্টিক", "ভারতীয়", "প্যাসিফিক", "আর্কটিক"],
                correctAnswerIndex: 2,
                level: "Easy"
            },
            {
                id: 8,
                question: "১৪৪ এর বর্গমূল কত?",
                options: ["১০", "১১", "১২", "১৩"],
                correctAnswerIndex: 2,
                level: "Medium"
            },
            {
                id: 9,
                question: "বিশ্বের সবচেয়ে বেশি জনসংখ্যার দেশ কোনটি?",
                options: ["চীন", "ভারত", "মার্কিন যুক্তরাষ্ট্র", "ইন্দোনেশিয়া"],
                correctAnswerIndex: 1,
                level: "Medium"
            },
            {
                id: 10,
                question: "সবচেয়ে শক্ত প্রাকৃতিক পদার্থ কোনটি?",
                options: ["সোনা", "লোহা", "হীরক", "প্লাটিনাম"],
                correctAnswerIndex: 2,
                level: "Hard"
            }
        ];

        // ===== প্রতিটি প্রশ্নের জন্য ইউজারের উত্তর সংরক্ষণ =====
        var userAnswers = new Array(questions.length).fill(null);

        // ===== গেম স্টেট =====
        let currentIndex = 0;
        let score = 0;
        let totalQuestions = questions.length;
        let correctAnswers = 0;
        let wrongAnswers = 0;

        const letters = ['A', 'B', 'C', 'D'];

        // ===== DOM রেফারেন্স =====
        const quizArea = document.getElementById('quizArea');
        const scoreDisplay = document.getElementById('scoreDisplay');
        const progressText = document.getElementById('progressText');
        const levelBadge = document.getElementById('levelBadge');
        const progressBar = document.getElementById('progressBar');

        // ===== স্কোর রিক্যালকুলেট (প্রতি সঠিক উত্তরে ১ পয়েন্ট) =====
        function recalculateScore() {
            score = 0;
            correctAnswers = 0;
            wrongAnswers = 0;

            for (let i = 0; i < questions.length; i++) {
                if (userAnswers[i] !== null) {
                    if (userAnswers[i] === questions[i].correctAnswerIndex) {
                        score += 1;  // ← ৫ এর পরিবর্তে ১ পয়েন্ট
                        correctAnswers++;
                    } else {
                        wrongAnswers++;
                    }
                }
            }
            scoreDisplay.textContent = score;
        }

        // ===== প্রশ্ন রেন্ডার =====
        function renderQuestion() {
            console.log('📝 Rendering question', currentIndex + 1, 'of', totalQuestions);

            if (currentIndex >= totalQuestions) {
                showResult();
                return;
            }

            const q = questions[currentIndex];
            const userAnswer = userAnswers[currentIndex];

            // ===== হেডার আপডেট =====
            const levelEmojis = { 'Easy': '🟢', 'Medium': '🟡', 'Hard': '🔴' };
            levelBadge.innerHTML = `${levelEmojis[q.level] || '🎯'} ${q.level}`;
            progressText.textContent = `${currentIndex + 1} / ${totalQuestions}`;

            // ===== প্রগ্রেস বার =====
            const answeredCount = userAnswers.filter(a => a !== null).length;
            const progressPercent = (answeredCount / totalQuestions) * 100;
            progressBar.style.width = progressPercent + '%';

            // ===== প্রশ্ন কার্ড =====
            let html = `
                        <div class="question-card" id="questionCard">
                            <div class="q-number">📌 QUESTION ${currentIndex + 1}</div>
                            <div class="q-text">${q.question}</div>
                            <div class="options-container">
                    `;

            q.options.forEach((opt, idx) => {
                let btnClass = 'option-btn';
                if (userAnswer !== null) {
                    btnClass += ' disabled';
                    if (idx === q.correctAnswerIndex) {
                        btnClass += ' correct';
                    } else if (idx === userAnswer && idx !== q.correctAnswerIndex) {
                        btnClass += ' wrong';
                    }
                    if (idx === userAnswer) {
                        btnClass += ' selected';
                    }
                }
                html += `
                            <button class="${btnClass}" data-index="${idx}" onclick="selectOption(${idx})" ${userAnswer !== null ? 'disabled' : ''}>
                                <span class="option-letter">${letters[idx]}</span>
                                ${opt}
                            </button>
                        `;
            });

            html += `
                            </div>
                            <div class="nav-buttons">
                                <button class="nav-btn nav-btn-prev" onclick="goToQuestion(${currentIndex - 1})" ${currentIndex === 0 ? 'disabled' : ''}>
                                    <i class="fas fa-chevron-left"></i> Previous
                                </button>
                                ${currentIndex === totalQuestions - 1 ?
                    `<button class="nav-btn nav-btn-submit" onclick="submitQuiz()">
                                        <i class="fas fa-check-circle"></i> Submit Quiz
                                    </button>` :
                    `<button class="nav-btn nav-btn-next" onclick="goToQuestion(${currentIndex + 1})">
                                        Next <i class="fas fa-chevron-right"></i>
                                    </button>`
                }
                            </div>
                        </div>
                    `;

            quizArea.innerHTML = html;
            recalculateScore();

            // ===== অ্যানিমেশন =====
            const card = document.getElementById('questionCard');
            if (card) {
                card.style.animation = 'none';
                setTimeout(() => {
                    card.style.animation = 'slideUp 0.4s ease';
                }, 10);
            }
        }

        // ===== অপশন সিলেক্ট =====
        function selectOption(index) {
            if (userAnswers[currentIndex] !== null) return;

            userAnswers[currentIndex] = index;
            recalculateScore();
            renderQuestion();

            // ===== কনফেটি যদি সঠিক হয় =====
            if (index === questions[currentIndex].correctAnswerIndex) {
                createConfetti();
            }
        }

        // ===== নির্দিষ্ট প্রশ্নে যাওয়া =====
        function goToQuestion(index) {
            if (index < 0 || index >= totalQuestions) return;
            currentIndex = index;
            renderQuestion();
        }

        // ===== কুইজ সাবমিট =====
        function submitQuiz() {
            const unanswered = userAnswers.filter(a => a === null).length;
            if (unanswered > 0) {
                if (!confirm(`আপনি ${unanswered} টি প্রশ্নের উত্তর দেননি। আপনি কি নিশ্চিত যে আপনি সাবমিট করতে চান?`)) {
                    return;
                }
            }
            currentIndex = totalQuestions;
            showResult();
        }

        // ===== ফলাফল দেখানো =====
        function showResult() {
            console.log('🏁 Quiz completed!');

            const total = totalQuestions;
            const earned = score;
            const maxPossible = total * 1;  // ← প্রতি প্রশ্ন ১ পয়েন্ট
            const percentage = Math.round((earned / maxPossible) * 100);

            progressBar.style.width = '100%';

            let emoji, message, color;
            if (percentage >= 80) {
                emoji = '🏆';
                message = 'আমazing! আপনি একজন জিনিয়াস!';
                color = '#2ecc71';
            } else if (percentage >= 60) {
                emoji = '🌟';
                message = 'দারুণ! এভাবেই চালিয়ে যান!';
                color = '#f39c12';
            } else if (percentage >= 40) {
                emoji = '💪';
                message = 'ভাল চেষ্টা! আরও প্র্যাকটিস করুন।';
                color = '#3498db';
            } else {
                emoji = '😢';
                message = 'কষ্ট করে প্র্যাকটিস করুন। আপনি পারবেন!';
                color = '#e74c3c';
            }

            if (percentage >= 80) {
                setTimeout(() => {
                    for (let i = 0; i < 60; i++) {
                        setTimeout(() => createConfetti(), i * 50);
                    }
                }, 300);
            }

            // ===== প্রশ্নভিত্তিক রিভিউ =====
            let reviewHtml = '';
            for (let i = 0; i < totalQuestions; i++) {
                const q = questions[i];
                const answer = userAnswers[i];
                const isCorrect = answer === q.correctAnswerIndex;
                const statusIcon = answer !== null ? (isCorrect ? '✅' : '❌') : '⬜';
                reviewHtml += `
                            <div style="display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f0f0f0; font-size: 14px;">
                                <span>${i + 1}. ${q.question.substring(0, 30)}${q.question.length > 30 ? '...' : ''}</span>
                                <span>${statusIcon}</span>
                            </div>
                        `;
            }

            quizArea.innerHTML = `
                        <div class="question-card result-box" style="animation: slideUp 0.5s ease;">
                            <div class="big-icon">${emoji}</div>
                            <div class="result-score" style="color: ${color};">${earned}</div>
                            <div class="result-label">🏅 প্রাপ্ত পয়েন্ট</div>
                            <div class="result-details">
                                <span class="correct-count">✅ সঠিক: ${correctAnswers}</span> &nbsp;|&nbsp;
                                <span class="wrong-count">❌ ভুল: ${wrongAnswers}</span> &nbsp;|&nbsp;
                                <span style="color: #8A9188;">⬜ উত্তর নেই: ${totalQuestions - correctAnswers - wrongAnswers}</span> &nbsp;|&nbsp;
                                📊 ${percentage}%
                            </div>
                            <div class="result-message">${message}</div>
                            <div style="margin-top: 12px; font-size: 14px; color: #8A9188;">
                                মোট ${total} টি প্রশ্নের মধ্যে ${correctAnswers} টি সঠিক উত্তর দিয়েছেন
                            </div>

                            <div style="margin-top: 20px; text-align: left; max-height: 200px; overflow-y: auto; border: 1px solid #eee; border-radius: 8px; padding: 10px; background: #FAF9F4;">
                                <div style="font-weight: 600; margin-bottom: 8px; color: #1F3B2C;">📋 প্রশ্নের বিবরণ:</div>
                                ${reviewHtml}
                            </div>

                            <button class="btn-restart" onclick="restartGame()">
                                <i class="fas fa-redo me-2"></i>আবার খেলুন
                            </button>
                        </div>
                    `;

            progressText.textContent = '✅ সম্পূর্ণ!';
            levelBadge.innerHTML = `🎉 ${percentage}%`;
            levelBadge.style.borderLeft = `4px solid ${color}`;
        }

        // ===== গেম রিস্টার্ট =====
        function restartGame() {
            console.log('🔄 Restarting game...');
            currentIndex = 0;
            score = 0;
            correctAnswers = 0;
            wrongAnswers = 0;
            userAnswers = new Array(questions.length).fill(null);
            scoreDisplay.textContent = '0';
            progressBar.style.width = '0%';
            renderQuestion();
        }

        // ===== কনফেটি =====
        function createConfetti() {
            const container = document.getElementById('confettiContainer');
            const colors = ['#e74c3c', '#f1c40f', '#2ecc71', '#3498db', '#9b59b6', '#e67e22', '#1abc9c', '#ff6b6b', '#ffd93d'];

            for (let i = 0; i < 18; i++) {
                const el = document.createElement('div');
                el.className = 'confetti';
                el.style.left = Math.random() * 100 + '%';
                el.style.top = '-10px';
                el.style.background = colors[Math.floor(Math.random() * colors.length)];
                el.style.width = (Math.random() * 8 + 4) + 'px';
                el.style.height = (Math.random() * 8 + 4) + 'px';
                el.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
                el.style.animationDuration = (Math.random() * 2 + 1.5) + 's';
                el.style.animationDelay = (Math.random() * 0.6) + 's';
                el.style.transform = `rotate(${Math.random() * 360}deg)`;
                container.appendChild(el);

                setTimeout(() => el.remove(), 4000);
            }
        }

        // ===== কিবোর্ড সাপোর্ট =====
        document.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowRight' && currentIndex < totalQuestions - 1) {
                goToQuestion(currentIndex + 1);
            } else if (e.key === 'ArrowLeft' && currentIndex > 0) {
                goToQuestion(currentIndex - 1);
            } else if (e.key === 'Enter' && currentIndex === totalQuestions - 1) {
                submitQuiz();
            }

            const key = parseInt(e.key);
            if (key >= 1 && key <= 4) {
                const buttons = document.querySelectorAll('.option-btn:not(.disabled)');
                if (buttons[key - 1]) {
                    buttons[key - 1].click();
                }
            }
        });

        // ===== শুরু =====
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🚀 DOM loaded, starting quiz...');
            renderQuestion();
        });
    </script>
}