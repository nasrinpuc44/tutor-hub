@model List<Tutorbub.Models.Course>

@{
    ViewData["Title"] = "Manage Courses";
    Layout = "_Layout";
}

<style>
    /* ===== Admin Sidebar ===== */
    .admin-sidebar {
        position: fixed;
        top: 80px;
        left: 0;
        bottom: 0;
        width: 250px;
        background-color: #1F3B2C;
        color: white;
        padding: 20px 0;
        overflow-y: auto;
        z-index: 100;
        transition: transform 0.3s ease;
    }

    .admin-sidebar-brand {
        padding: 0 20px 20px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        margin-bottom: 15px;
    }

    .admin-sidebar-brand h4 {
        color: #F3F1E7;
        font-weight: 600;
        margin: 0;
    }

    .admin-sidebar-brand small {
        color: #8A9188;
        font-size: 12px;
    }

    .admin-sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .admin-sidebar-menu li a {
        display: flex;
        align-items: center;
        padding: 12px 20px;
        color: #C7D0C9;
        text-decoration: none;
        transition: all 0.3s ease;
        border-left: 3px solid transparent;
        font-size: 14px;
        cursor: pointer;
    }

    .admin-sidebar-menu li a:hover,
    .admin-sidebar-menu li a.active {
        background-color: rgba(255,255,255,0.08);
        color: #ffffff;
        border-left-color: #F4C744;
    }

    .admin-sidebar-menu li a i {
        width: 24px;
        margin-right: 10px;
        font-size: 16px;
        text-align: center;
    }

    .admin-main-content {
        margin-left: 250px;
        padding: 20px;
        min-height: calc(100vh - 80px);
    }

    .sidebar-toggle {
        display: none;
        position: fixed;
        top: 90px;
        left: 15px;
        z-index: 101;
        background-color: #1F3B2C;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 18px;
        cursor: pointer;
    }

    .sidebar-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0,0,0,0.5);
        z-index: 99;
    }

    .sidebar-overlay.active {
        display: block;
    }

    /* ===== Course Row ===== */
    .course-row {
        background: white;
        border-radius: 14px;
        padding: 16px;
        margin-bottom: 12px;
        display: flex;
        gap: 18px;
        align-items: center;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        border: 1px solid rgba(0,0,0,0.04);
        flex-wrap: wrap;
        transition: all 0.25s;
    }

    .course-row:hover {
        box-shadow: 0 6px 22px rgba(31,59,44,0.1);
        transform: translateY(-2px);
    }

    .course-row img {
        width: 80px;
        height: 80px;
        border-radius: 10px;
        object-fit: cover;
        flex-shrink: 0;
        background: #E7E4D9;
    }

    .course-row .info {
        flex: 1;
        min-width: 200px;
    }

    .course-row .info h5 {
        font-size: 16px;
        font-weight: 700;
        color: #1F3B2C;
        margin: 0 0 6px;
    }

    .course-row .info .meta {
        font-size: 13px;
        color: #6B7568;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .course-row .info .meta i {
        color: #1F3B2C;
        margin-right: 4px;
    }

    /* ===== Status Pill ===== */
    .status-pill {
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .status-pill.open {
        background: #d4edda;
        color: #155724;
    }

    .status-pill.closed {
        background: #f8d7da;
        color: #721c24;
    }

    /* ===== Action Buttons ===== */
    .course-row .actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-upload-lesson,
    .btn-quiz,
    .btn-toggle,
    .btn-delete {
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.25s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-upload-lesson {
        background: #0d6efd;
        color: white;
    }

    .btn-upload-lesson:hover {
        background: #0b5ed7;
        color: white;
        transform: translateY(-1px);
    }

    .btn-quiz {
        background: #8e63d9;
        color: white;
    }

    .btn-quiz:hover {
        background: #6f42c1;
        color: white;
        transform: translateY(-1px);
    }

    .btn-toggle.open {
        background: #1F3B2C;
        color: white;
    }

    .btn-toggle.closed {
        background: #2ecc71;
        color: white;
    }

    .btn-toggle:hover {
        opacity: 0.88;
        transform: translateY(-1px);
    }

    .btn-delete {
        background: #fff;
        color: #e74c3c;
        border: 1.5px solid #e74c3c;
    }

    .btn-delete:hover {
        background: #f8d7da;
    }

    /* ===== Empty State ===== */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .empty-state i {
        font-size: 56px;
        color: #E7E4D9;
        display: block;
        margin-bottom: 16px;
    }

    .empty-state h5 {
        color: #1F3B2C;
        font-size: 18px;
        font-weight: 700;
        margin: 0 0 8px;
    }

    .empty-state p {
        color: #8A9188;
        font-size: 14px;
        margin: 0 0 20px;
    }

    .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 26px;
        background: #1F3B2C;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-primary-custom:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(31,59,44,0.22);
        color: white;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 992px) {
        .admin-sidebar {
            transform: translateX(-100%);
        }

        .admin-sidebar.open {
            transform: translateX(0);
        }

        .sidebar-toggle {
            display: block;
        }

        .admin-main-content {
            margin-left: 0;
            padding: 20px 15px;
        }
    }

    @@media (max-width: 576px) {
        .course-row {
            flex-direction: column;
            align-items: stretch;
        }

        .course-row img {
            width: 100%;
            height: 160px;
        }

        .course-row .actions {
            justify-content: flex-start;
        }

        .btn-upload-lesson,
        .btn-quiz,
        .btn-toggle,
        .btn-delete {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<!-- ===== Sidebar Toggle (Mobile) ===== -->
<button class="sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- ===== Admin Sidebar ===== -->
<div class="admin-sidebar" id="sidebar">
    <div class="admin-sidebar-brand">
        <h4><i class="fas fa-shield-alt me-2"></i>Admin Panel</h4>
        <small>Smart Tutor Hub</small>
    </div>
    <ul class="admin-sidebar-menu">
        <li><a asp-controller="Admin" asp-action="Dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
        <li><a asp-controller="Admin" asp-action="TeacherRequests"><i class="fas fa-user-graduate"></i> Teacher Requests</a></li>
        <li><a asp-controller="Admin" asp-action="Payments"><i class="fas fa-money-check-alt"></i> Payments</a></li>
        <li><a asp-controller="Admin" asp-action="AddCourse"><i class="fas fa-plus-circle"></i> Add Course</a></li>
        <li><a asp-controller="Admin" asp-action="ManageCourses" class="active"><i class="fas fa-tasks"></i> Manage Courses</a></li>
        <li><a asp-controller="Admin" asp-action="QuizAssignmentOverview"><i class="fas fa-question-circle"></i> Quiz & Assignment</a></li>
        <li><a asp-controller="Admin" asp-action="ManageNotices"><i class="fas fa-newspaper"></i> News & Announcements</a></li>
        <li style="border-top: 1px solid rgba(255,255,255,0.05); margin-top: 10px; padding-top: 10px;">
            <form method="post" asp-controller="Account" asp-action="Logout" id="logoutForm">
                @Html.AntiForgeryToken()
                <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;" style="color: #e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </form>
        </li>
    </ul>
</div>

<!-- ===== Main Content ===== -->
<div class="admin-main-content">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 style="color:#1F3B2C; margin:0;"><i class="fas fa-tasks me-2"></i>Manage Courses</h2>
            <p style="color:#6B7568; margin:4px 0 0 0; font-size:14px;">সব কোর্স দেখুন, Edit করুন, এবং Quiz/Assignment Manage করুন</p>
        </div>
        <a asp-controller="Admin" asp-action="AddCourse" class="btn-primary-custom">
            <i class="fas fa-plus-circle"></i> Add New Course
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="border-radius:10px;">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="border-radius:10px;">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        </div>
    }

    @Html.AntiForgeryToken()

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-book"></i>
            <h5>No courses yet</h5>
            <p>শুরু করার জন্য প্রথমে একটি কোর্স তৈরি করুন।</p>
            <a asp-controller="Admin" asp-action="AddCourse" class="btn-primary-custom">
                <i class="fas fa-plus-circle"></i> Add First Course
            </a>
        </div>
    }
    else
    {
        foreach (var course in Model)
        {
            var imgSrc = string.IsNullOrEmpty(course.Image)
                ? "https://i.ibb.co/fd9s88Y/IMG-6916-1.png"
                : course.Image;

            <div class="course-row" id="course-@course.Id">
                <img src="@imgSrc" alt="@course.Title" />

                <div class="info">
                    <h5>@course.Title</h5>
                    <div class="meta">
                        <span><i class="fas fa-tag"></i>@course.Category</span>
                        <span><i class="fas fa-money-bill-wave"></i>৳@course.Price.ToString("N0")</span>
                        <span><i class="fas fa-user-graduate"></i>@course.Instructor</span>
                        <span><i class="fas fa-clock"></i>@course.Duration</span>
                    </div>
                </div>

                <span class="status-pill @(course.IsEnrollmentOpen ? "open" : "closed")">
                    @(course.IsEnrollmentOpen ? "Enrollment Open" : "Enrollment Closed")
                </span>

                <div class="actions">
                    <!-- ===== Upload Lesson ===== -->
                    <a asp-controller="Admin"
                       asp-action="UploadLesson"
                       asp-route-courseId="@course.Id"
                       class="btn-upload-lesson"
                       title="Upload Lesson Video">
                        <i class="fas fa-video"></i> Upload Lesson
                    </a>

                    <!-- ===== Quiz & Assignment (NEW) ===== -->
                    <a asp-controller="Admin"
                       asp-action="ManageQuizAssignment"
                       asp-route-courseId="@course.Id"
                       class="btn-quiz"
                       title="Manage Quiz & Assignment">
                        <i class="fas fa-question-circle"></i> Quiz & Assignment
                    </a>

                    <!-- ===== Toggle Enrollment ===== -->
                    @if (course.IsEnrollmentOpen)
                    {
                        <button class="btn-toggle open"
                                onclick="toggleEnrollment(@course.Id, false, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(course.Title))')"
                                title="Close Enrollment">
                            <i class="fas fa-lock"></i> Close
                        </button>
                    }
                    else
                    {
                        <button class="btn-toggle closed"
                                onclick="toggleEnrollment(@course.Id, true, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(course.Title))')"
                                title="Reopen Enrollment">
                            <i class="fas fa-lock-open"></i> Reopen
                        </button>
                    }

                    <!-- ===== Delete ===== -->
                    <button class="btn-delete"
                            onclick="deleteCourse(@course.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(course.Title))')"
                            title="Delete Course">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </div>
            </div>
        }
    }

</div>

@section Scripts {
    <script>
        // ===== Sidebar Toggle =====
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('active');
        });
        document.getElementById('sidebarOverlay')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        });

        // ===== Anti-Forgery Token Helper =====
        function getToken() {
            const t = document.querySelector('input[name="__RequestVerificationToken"]');
            return t ? t.value : '';
        }

        // ===== Toggle Enrollment =====
        function toggleEnrollment(courseId, isOpen, title) {
            const actionText = isOpen ? 'open' : 'close';
            if (!confirm(`Are you sure you want to ${actionText} enrollment for "${title}"?`)) return;

            const formData = new FormData();
            formData.append('id', courseId);
            formData.append('isOpen', isOpen);
            formData.append('__RequestVerificationToken', getToken());

            fetch('/Admin/ToggleEnrollment', { method: 'POST', body: formData })
                .then(r => r.json())
                .then(data => {
                    alert(data.message);
                    if (data.success) location.reload();
                })
                .catch(() => alert('Error updating enrollment.'));
        }

        // ===== Delete Course =====
        function deleteCourse(courseId, title) {
            if (!confirm(`⚠️ DELETE "${title}" permanently?\n\nThis will remove the course and all its lessons, quizzes, assignments, and orders. This action cannot be undone.`)) return;

            const formData = new FormData();
            formData.append('id', courseId);
            formData.append('__RequestVerificationToken', getToken());

            fetch('/Admin/DeleteCourse', { method: 'POST', body: formData })
                .then(r => r.json())
                .then(data => {
                    alert(data.message);
                    if (data.success) location.reload();
                })
                .catch(() => alert('Error deleting course.'));
        }
    </script>
}