@model List<Tutorbub.Models.AdminPaymentViewModel>

@{
    ViewData["Title"] = "Payment Management";
    Layout = "_Layout";
}

<style>
    /* ===== Main Content Layout ===== */
    .admin-main-content {
        margin-left: 250px;
        padding: 20px;
        min-height: calc(100vh - 80px);
    }

    /* ===== Payment Stats ===== */
    .pay-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .pay-stat-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        border-left: 4px solid #1F3B2C;
        transition: transform 0.2s;
    }

        .pay-stat-card:hover {
            transform: translateY(-3px);
        }

        .pay-stat-card.pending {
            border-left-color: #f39c12;
        }

        .pay-stat-card.approved {
            border-left-color: #2ecc71;
        }

        .pay-stat-card.rejected {
            border-left-color: #e74c3c;
        }

        .pay-stat-card.revenue {
            border-left-color: #9b59b6;
        }

        .pay-stat-card .num {
            font-size: 28px;
            font-weight: 800;
            color: #1F3B2C;
            line-height: 1.2;
        }

        .pay-stat-card .lbl {
            font-size: 13px;
            color: #6B7568;
            margin-top: 4px;
        }

            .pay-stat-card .lbl i {
                margin-right: 5px;
            }

    /* ===== Filter Tabs ===== */
    .filter-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .filter-tab {
        padding: 9px 22px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s;
        border: 1.5px solid #E5E1D3;
        color: #5B6B5E;
        background: white;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .filter-tab:hover {
            border-color: #1F3B2C;
            color: #1F3B2C;
        }

        .filter-tab.active {
            background: #1F3B2C;
            color: white;
            border-color: #1F3B2C;
        }

    /* ===== Payment Item ===== */
    .payment-item {
        background: white;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 14px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.04);
        display: flex;
        gap: 20px;
        align-items: center;
        flex-wrap: wrap;
        transition: all 0.25s;
    }

        .payment-item:hover {
            box-shadow: 0 6px 24px rgba(31,59,44,0.1);
        }

        .payment-item .course-thumb {
            width: 70px;
            height: 70px;
            border-radius: 12px;
            object-fit: cover;
            flex-shrink: 0;
            background: #E7E4D9;
        }

        .payment-item .pay-main {
            flex: 1;
            min-width: 250px;
        }

            .payment-item .pay-main h5 {
                font-size: 16px;
                font-weight: 700;
                color: #1F3B2C;
                margin: 0 0 6px;
            }

            .payment-item .pay-main .user-info {
                font-size: 13px;
                color: #6B7568;
                margin-bottom: 8px;
            }

                .payment-item .pay-main .user-info strong {
                    color: #1F3B2C;
                }

            .payment-item .pay-main .tx-details {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }

    /* ===== Transaction Tags ===== */
    .tx-tag {
        font-size: 12px;
        padding: 4px 12px;
        border-radius: 20px;
        background: #F3F1E7;
        color: #1F3B2C;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .tx-tag.method {
            background: #E8F4FD;
            color: #0c6b7c;
        }

        .tx-tag.amount {
            background: #d4edda;
            color: #155724;
        }

    /* ===== Payment Actions ===== */
    .payment-item .pay-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: stretch;
        min-width: 140px;
    }

    .status-pill {
        text-align: center;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

        .status-pill.pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-pill.approved {
            background: #d4edda;
            color: #155724;
        }

        .status-pill.rejected {
            background: #f8d7da;
            color: #721c24;
        }

    .btn-approve {
        background: #2ecc71;
        color: white;
        border: none;
        padding: 10px 16px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.25s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .btn-approve:hover {
            background: #27ae60;
            transform: translateY(-1px);
        }

    .btn-reject {
        background: white;
        color: #e74c3c;
        border: 1.5px solid #e74c3c;
        padding: 10px 16px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.25s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .btn-reject:hover {
            background: #f8d7da;
            transform: translateY(-1px);
        }

    /* ===== Empty State ===== */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

        .empty-state i {
            font-size: 56px;
            color: #E7E4D9;
            margin-bottom: 16px;
            display: block;
        }

        .empty-state h5 {
            color: #1F3B2C;
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 8px;
        }

        .empty-state p {
            color: #8A9188;
            font-size: 14px;
            margin: 0;
        }

    /* ===== Modal ===== */
    .modal-content {
        border-radius: 16px;
        border: none;
    }

    .modal-header {
        background: #1F3B2C;
        color: white;
        border-radius: 16px 16px 0 0;
        padding: 16px 22px;
    }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
        }

    .modal-body {
        padding: 24px;
    }

    .modal-footer {
        border-top: 1px solid #f0f0f0;
        padding: 14px 22px;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 992px) {
        .admin-main-content {
            margin-left: 0;
            padding: 20px 15px;
        }

        .pay-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .pay-stats {
            grid-template-columns: 1fr;
        }

        .payment-item {
            flex-direction: column;
            text-align: center;
        }

            .payment-item .pay-actions {
                flex-direction: row;
                width: 100%;
            }

                .payment-item .pay-actions button {
                    flex: 1;
                }
    }
</style>

<!-- ===== Admin Sidebar (Partial) ===== -->
<partial name="_AdminSidebar" />

<!-- ===== Main Content ===== -->
<div class="admin-main-content">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 style="color:#1F3B2C; margin:0;"><i class="fas fa-money-check-alt me-2"></i>Payment Management</h2>
            <p style="color:#6B7568; margin:4px 0 0 0; font-size:14px;">সব পেমেন্ট দেখুন, Approve বা Reject করুন</p>
        </div>
        <span class="badge bg-warning text-dark" style="font-size:13px; padding:8px 14px;">
            @(ViewBag.PendingCount ?? 0) Pending
        </span>
    </div>

    <!-- ===== Payment Stats ===== -->
    <div class="pay-stats">
        <div class="pay-stat-card pending">
            <div class="num">@(ViewBag.PendingCount ?? 0)</div>
            <div class="lbl"><i class="fas fa-clock"></i>Pending</div>
        </div>
        <div class="pay-stat-card approved">
            <div class="num">@(ViewBag.ApprovedCount ?? 0)</div>
            <div class="lbl"><i class="fas fa-check-circle"></i>Approved</div>
        </div>
        <div class="pay-stat-card rejected">
            <div class="num">@(ViewBag.RejectedCount ?? 0)</div>
            <div class="lbl"><i class="fas fa-times-circle"></i>Rejected</div>
        </div>
        <div class="pay-stat-card revenue">
            <div class="num">৳@Convert.ToDecimal(ViewBag.TotalRevenue ?? 0).ToString("N0")</div>
            <div class="lbl"><i class="fas fa-chart-line"></i>Total Revenue</div>
        </div>
    </div>

    <!-- ===== Filter Tabs ===== -->
    <div class="filter-tabs">
        <a href="/Admin/Payments?status=all" class="filter-tab @(ViewBag.CurrentFilter == "all" ? "active" : "")">
            <i class="fas fa-list me-1"></i> All
        </a>
        <a href="/Admin/Payments?status=Pending" class="filter-tab @(ViewBag.CurrentFilter == "Pending" ? "active" : "")">
            <i class="fas fa-clock me-1"></i> Pending
        </a>
        <a href="/Admin/Payments?status=Approved" class="filter-tab @(ViewBag.CurrentFilter == "Approved" ? "active" : "")">
            <i class="fas fa-check-circle me-1"></i> Approved
        </a>
        <a href="/Admin/Payments?status=Rejected" class="filter-tab @(ViewBag.CurrentFilter == "Rejected" ? "active" : "")">
            <i class="fas fa-times-circle me-1"></i> Rejected
        </a>
    </div>

    <!-- ===== Payment List ===== -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h5>No payments found</h5>
            <p>There are no payments matching your filter.</p>
        </div>
    }
    else
    {
        foreach (var p in Model)
        {
            var statusClass = (p.PaymentStatus ?? "Pending").ToLower();
            var imgSrc = string.IsNullOrEmpty(p.CourseImage)
                ? "https://i.ibb.co/fd9s88Y/IMG-6916-1.png"
                : p.CourseImage;

            <div class="payment-item" id="payment-@p.Id">
                <img src="@imgSrc" alt="@p.CourseName" class="course-thumb" />

                <div class="pay-main">
                    <h5>@p.CourseName</h5>
                    <div class="user-info">
                        <i class="fas fa-user me-1"></i> <strong>@p.UserFullName</strong>
                        (@p.UserName)
                        <span class="mx-1">•</span>
                        <i class="fas fa-envelope me-1"></i>@p.UserEmail
                    </div>
                    <div class="tx-details">
                        <span class="tx-tag method"><i class="fas fa-credit-card"></i> @p.PaymentMethod</span>
                        <span class="tx-tag"><i class="fas fa-fingerprint"></i> @p.TransactionId</span>
                        <span class="tx-tag"><i class="fas fa-mobile-alt"></i> @p.SenderMobileNumber</span>
                        <span class="tx-tag amount"><i class="fas fa-money-bill-wave"></i> ৳@p.Price.ToString("N0")</span>
                        <span class="tx-tag"><i class="fas fa-calendar"></i> @p.OrderDate.ToString("dd MMM, hh:mm tt")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(p.AdminNote))
                    {
                        <div style="margin-top:8px; padding:8px 12px; background:#FAF9F4; border-radius:8px; font-size:12.5px; color:#5B6B5E; border-left:3px solid #F4C744;">
                            <strong>Admin Note:</strong> @p.AdminNote
                        </div>
                    }
                </div>

                <div class="pay-actions">
                    <span class="status-pill @statusClass">@p.PaymentStatus</span>
                    @if (p.PaymentStatus == "Pending")
                    {
                        <button class="btn-approve"
                                onclick="approvePayment(@p.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.UserFullName))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.CourseName))')">
                            <i class="fas fa-check"></i> Approve
                        </button>
                        <button class="btn-reject"
                                onclick="rejectPayment(@p.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.UserFullName))')">
                            <i class="fas fa-times"></i> Reject
                        </button>
                    }
                </div>
            </div>
        }
    }

</div>

<!-- ===== Note Modal ===== -->
<div class="modal fade" id="noteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="noteModalTitle">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="noteAction" />
                <input type="hidden" id="noteOrderId" />
                <p id="noteMessage" style="font-size:14px; color:#5B6B5E; margin-bottom:16px;"></p>
                <label class="form-label fw-bold" style="font-size:13px; color:#1F3B2C;">
                    <i class="fas fa-pen me-1"></i>Admin Note (Optional)
                </label>
                <textarea id="adminNote" class="form-control" rows="3"
                          placeholder="Add a note (visible to the user)..."
                          style="border-radius:10px; padding:11px 14px;"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius:8px;">Cancel</button>
                <button type="button" class="btn" id="confirmBtn" onclick="confirmAction()"
                        style="background:#1F3B2C; color:white; border-radius:8px; padding:9px 28px; font-weight:600;">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ===== Approve Payment =====
        function approvePayment(id, userName, courseName) {
            document.getElementById('noteAction').value = 'Approve';
            document.getElementById('noteOrderId').value = id;
            document.getElementById('noteModalTitle').innerHTML = '<i class="fas fa-check-circle me-2"></i>Approve Payment';
            document.getElementById('noteMessage').innerHTML =
                'Are you sure you want to approve the payment from <strong>' + userName + '</strong> for <strong>' + courseName + '</strong>?<br>' +
                '<small style="color:#2ecc71;">The user will get instant access to this course.</small>';
            document.getElementById('confirmBtn').style.background = '#2ecc71';
            document.getElementById('adminNote').value = '';
            new bootstrap.Modal(document.getElementById('noteModal')).show();
        }

        // ===== Reject Payment =====
        function rejectPayment(id, userName) {
            document.getElementById('noteAction').value = 'Reject';
            document.getElementById('noteOrderId').value = id;
            document.getElementById('noteModalTitle').innerHTML = '<i class="fas fa-times-circle me-2"></i>Reject Payment';
            document.getElementById('noteMessage').innerHTML =
                'Are you sure you want to reject the payment from <strong>' + userName + '</strong>?<br>' +
                '<small style="color:#e74c3c;">The user will be notified and can try again.</small>';
            document.getElementById('confirmBtn').style.background = '#e74c3c';
            document.getElementById('adminNote').value = '';
            new bootstrap.Modal(document.getElementById('noteModal')).show();
        }

        // ===== Confirm Action =====
        function confirmAction() {
            var action = document.getElementById('noteAction').value;
            var orderId = document.getElementById('noteOrderId').value;
            var note = document.getElementById('adminNote').value;

            var url = action === 'Approve' ? '/Admin/ApprovePayment' : '/Admin/RejectPayment';

            var formData = new FormData();
            formData.append('id', orderId);
            formData.append('adminNote', note);

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var headers = {};
            if (token) { headers['RequestVerificationToken'] = token.value; }

            var btn = document.getElementById('confirmBtn');
            var originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Processing...';
            btn.disabled = true;

            fetch(url, { method: 'POST', body: formData, headers: headers })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    alert(data.message);
                    if (data.success) { location.reload(); }
                })
                .catch(function (error) {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    alert('Error: ' + error.message);
                });
        }
    </script>
}