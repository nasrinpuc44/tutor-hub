        // ===== Milestone Config =====
        function saveMilestoneConfig() {
            const value = parseInt(document.getElementById('modulesPerMilestone').value) || 0;

            if (value < 1 || value > 20) {
                alert('Modules per milestone must be between 1 and 20.');
                return;
            }

            const formData = new FormData();
            formData.append('courseId', COURSE_ID);
            formData.append('modulesPerMilestone', value);
            formData.append('__RequestVerificationToken', getToken());

            fetch('/Admin/SetModulesPerMilestone', { method: 'POST', body: formData })
                .then(r => r.json())
                .then(data => {
                    alert(data.message);
                    if (data.success) location.reload();
                })
                .catch(() => alert('Error saving configuration.'));
        }
