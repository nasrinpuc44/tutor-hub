@model Tutorbub.Models.Course

@{
    ViewData["Title"] = "Add New Course";
    Layout = "_Layout";
}

<style>
    /* ===== Admin Sidebar ===== */
    .admin-sidebar {
        position: fixed;
        top: 80px;
        left: 0;
        bottom: 0;
        width: 250px;
        background-color: #1F3B2C;
        color: white;
        padding: 20px 0;
        overflow-y: auto;
        z-index: 100;
        transition: transform 0.3s ease;
    }

    .admin-sidebar-brand {
        padding: 0 20px 20px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        margin-bottom: 15px;
    }

    .admin-sidebar-brand h4 {
        color: #F3F1E7;
        font-weight: 600;
        margin: 0;
    }

    .admin-sidebar-brand small {
        color: #8A9188;
        font-size: 12px;
    }

    .admin-sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .admin-sidebar-menu li a {
        display: flex;
        align-items: center;
        padding: 12px 20px;
        color: #C7D0C9;
        text-decoration: none;
        transition: all 0.3s ease;
        border-left: 3px solid transparent;
        font-size: 14px;
        cursor: pointer;
    }

    .admin-sidebar-menu li a:hover,
    .admin-sidebar-menu li a.active {
        background-color: rgba(255,255,255,0.08);
        color: #ffffff;
        border-left-color: #F4C744;
    }

    .admin-sidebar-menu li a i {
        width: 24px;
        margin-right: 10px;
        font-size: 16px;
        text-align: center;
    }

    .admin-main-content {
        margin-left: 250px;
        padding: 20px;
        min-height: calc(100vh - 80px);
    }

    .sidebar-toggle {
        display: none;
        position: fixed;
        top: 90px;
        left: 15px;
        z-index: 101;
        background-color: #1F3B2C;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 18px;
        cursor: pointer;
    }

    .sidebar-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0,0,0,0.5);
        z-index: 99;
    }

    .sidebar-overlay.active {
        display: block;
    }

    /* ===== Form Card ===== */
    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.04);
    }

    .form-label {
        font-weight: 700;
        color: #1F3B2C;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        border: 1.5px solid #E5E1D3;
        padding: 11px 14px;
        font-size: 14px;
        background: #FAF9F4;
        transition: all 0.2s;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #1F3B2C;
        box-shadow: 0 0 0 3px rgba(31,59,44,0.1);
        background: white;
    }

    .form-control::placeholder {
        color: #A8B5A9;
    }

    .btn-save {
        background: #1F3B2C;
        color: white;
        padding: 12px 40px;
        border-radius: 10px;
        border: none;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-save:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(31,59,44,0.22);
        color: white;
    }

    .btn-cancel {
        background: white;
        color: #6B7568;
        padding: 12px 32px;
        border-radius: 10px;
        border: 1.5px solid #E5E1D3;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-cancel:hover {
        background: #FAF9F4;
        color: #1F3B2C;
        border-color: #1F3B2C;
    }

    .upload-btn-label {
        display: block;
        width: 100%;
        padding: 11px;
        background-color: #F3F1E7;
        color: #1F3B2C;
        border: 1.5px dashed #1F3B2C;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13.5px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .upload-btn-label:hover {
        background-color: #E7E4D9;
    }

    .req-star {
        color: #e74c3c;
    }

    .info-note {
        font-size: 12px;
        color: #8A9188;
        margin-top: 6px;
        display: block;
    }

    .info-note i {
        color: #1F3B2C;
        margin-right: 4px;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 992px) {
        .admin-sidebar {
            transform: translateX(-100%);
        }

        .admin-sidebar.open {
            transform: translateX(0);
        }

        .sidebar-toggle {
            display: block;
        }

        .admin-main-content {
            margin-left: 0;
            padding: 20px 15px;
        }
    }
</style>

<!-- ===== Sidebar Toggle (Mobile) ===== -->
<button class="sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- ===== Admin Sidebar ===== -->
<div class="admin-sidebar" id="sidebar">
    <div class="admin-sidebar-brand">
        <h4><i class="fas fa-shield-alt me-2"></i>Admin Panel</h4>
        <small>Smart Tutor Hub</small>
    </div>
    <ul class="admin-sidebar-menu">
        <li><a asp-controller="Admin" asp-action="Dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
        <li><a asp-controller="Admin" asp-action="TeacherRequests"><i class="fas fa-user-graduate"></i> Teacher Requests</a></li>
        <li><a asp-controller="Admin" asp-action="Payments"><i class="fas fa-money-check-alt"></i> Payments</a></li>
        <li><a asp-controller="Admin" asp-action="AddCourse" class="active"><i class="fas fa-plus-circle"></i> Add Course</a></li>
        <li><a asp-controller="Admin" asp-action="ManageCourses"><i class="fas fa-tasks"></i> Manage Courses</a></li>
        <li><a asp-controller="Admin" asp-action="QuizAssignmentOverview"><i class="fas fa-question-circle"></i> Quiz & Assignment</a></li>
        <li><a asp-controller="Admin" asp-action="ManageNotices"><i class="fas fa-newspaper"></i> News & Announcements</a></li>
        <li style="border-top: 1px solid rgba(255,255,255,0.05); margin-top: 10px; padding-top: 10px;">
            <form method="post" asp-controller="Account" asp-action="Logout" id="logoutForm">
                @Html.AntiForgeryToken()
                <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;" style="color: #e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </form>
        </li>
    </ul>
</div>

<!-- ===== Main Content ===== -->
<div class="admin-main-content">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 style="color:#1F3B2C; margin:0;"><i class="fas fa-plus-circle me-2"></i>Add New Course</h2>
            <p style="color:#6B7568; margin:4px 0 0 0; font-size:14px;">নতুন একটি কোর্স তৈরি করুন</p>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn-cancel">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="border-radius:10px;">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" style="border-radius:10px;">
            <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error
        </div>
    }

    <div class="form-card p-4">
        <form method="post" asp-controller="Admin" asp-action="AddCourse">
            @Html.AntiForgeryToken()

            <!-- ===== Title + Category ===== -->
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Title" class="form-label">Course Title <span class="req-star">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Complete Web Development" required />
                    <span asp-validation-for="Title" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Category" class="form-label">Category <span class="req-star">*</span></label>
                    <select asp-for="Category" class="form-select" required>
                        <option value="">Select Category</option>
                        <option value="Web Development">Web Development</option>
                        <option value="Frontend">Frontend</option>
                        <option value="Backend">Backend</option>
                        <option value="Design">Design</option>
                        <option value="Mobile Development">Mobile Development</option>
                        <option value="Data Science">Data Science</option>
                        <option value="Language">Language</option>
                    </select>
                </div>
            </div>

            <!-- ===== Description ===== -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description <span class="req-star">*</span></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Write course description..." required></textarea>
            </div>

            <!-- ===== Features (What You'll Learn) ===== -->
            <div class="mb-3">
                <label asp-for="Features" class="form-label">
                    <i class="fas fa-check-circle me-1" style="color:#1F3B2C;"></i> What You'll Learn (Features)
                </label>
                <textarea asp-for="Features" id="featuresInput" class="form-control" rows="3"
                          placeholder="যেমন: Certificate Included, Lifetime Access, 24/7 Support, Interactive Quizzes"></textarea>
                <span class="info-note">
                    <i class="fas fa-info-circle"></i>
                    কমা (,) দিয়ে আলাদা করে লিখুন। যেমন: <strong>Certificate Included, Lifetime Access, 24/7 Support</strong>
                </span>

                <div id="featuresPreview" class="mt-2" style="display:none;">
                    <small class="fw-bold" style="color:#1F3B2C;">Preview:</small>
                    <ul id="featuresList" style="margin-top:5px; padding-left:20px;"></ul>
                </div>
            </div>

            <!-- ===== Image ===== -->
            <div class="mb-3">
                <label asp-for="Image" class="form-label">Course Image <span class="req-star">*</span></label>

                <div class="row g-2 align-items-center">
                    <div class="col-md-8">
                        <input asp-for="Image" id="courseImageUrl" class="form-control" placeholder="https://i.ibb.co/your-image.jpg" required />
                    </div>
                    <div class="col-md-4">
                        <label for="courseImageFile" class="upload-btn-label">
                            <i class="fas fa-upload me-1"></i> Upload from Device
                        </label>
                        <input type="file" id="courseImageFile" accept="image/*" style="display:none;" />
                    </div>
                </div>

                <span class="info-note">
                    <i class="fas fa-info-circle"></i>
                    Direct image link দিন অথবা ডিভাইস থেকে ছবি আপলোড করুন (Max 5MB)
                </span>

                <div id="imagePreviewWrapper" class="mt-3" style="display:none;">
                    <p class="mb-1 fw-bold" style="font-size:12px; color:#1F3B2C;">Preview:</p>
                    <img id="imagePreview" src="" alt="Preview"
                         style="max-width: 220px; max-height: 150px; border-radius: 10px; border: 2px solid #E7E4D9; object-fit: cover;" />
                </div>
            </div>

            <!-- ===== Price / Instructor / Duration / Lessons / Level ===== -->
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Price" class="form-label">Price (৳) <span class="req-star">*</span></label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="1499" required />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Instructor" class="form-label">Instructor <span class="req-star">*</span></label>
                    <input asp-for="Instructor" class="form-control" placeholder="e.g. Dr. Sarah Ahmed" required />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Duration" class="form-label">Duration</label>
                    <input asp-for="Duration" class="form-control" placeholder="12 Weeks" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Lessons" class="form-label">Lessons</label>
                    <input asp-for="Lessons" type="number" class="form-control" placeholder="48" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Level" class="form-label">Level</label>
                    <select asp-for="Level" class="form-select">
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                        <option value="Beginner to Intermediate">Beginner to Intermediate</option>
                    </select>
                </div>
            </div>

            <!-- ===== Action Buttons ===== -->
            <div class="d-flex gap-3 mt-4 flex-wrap">
                <a asp-controller="Admin" asp-action="Dashboard" class="btn-cancel">
                    <i class="fas fa-times"></i> Cancel
                </a>
                <button type="submit" class="btn-save">
                    <i class="fas fa-save"></i> Save Course
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // ===== Sidebar Toggle =====
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('active');
        });
        document.getElementById('sidebarOverlay')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        });

        // ===== Features Preview =====
        const featuresInput = document.getElementById('featuresInput');
        const featuresPreview = document.getElementById('featuresPreview');
        const featuresList = document.getElementById('featuresList');

        if (featuresInput) {
            featuresInput.addEventListener('input', function () {
                const value = this.value.trim();
                if (!value) {
                    featuresPreview.style.display = 'none';
                    featuresList.innerHTML = '';
                    return;
                }
                const items = value.split(',').map(s => s.trim()).filter(s => s);
                featuresList.innerHTML = items.map(item =>
                    `<li style="color:#4B5648; font-size:13px; margin-bottom:3px;"><i class="fas fa-check-circle me-1" style="color:#1F3B2C;"></i>${item}</li>`
                ).join('');
                featuresPreview.style.display = 'block';
            });
        }

        // ===== Image URL + Preview =====
        const fileInput = document.getElementById('courseImageFile');
        const urlInput = document.getElementById('courseImageUrl');
        const previewWrapper = document.getElementById('imagePreviewWrapper');
        const previewImg = document.getElementById('imagePreview');

        urlInput.addEventListener('input', function () {
            const url = this.value.trim();
            if (url) {
                previewImg.src = url;
                previewWrapper.style.display = 'block';
            } else {
                previewWrapper.style.display = 'none';
            }
        });

        // ===== Image Upload =====
        fileInput.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;

            const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
            if (!allowedTypes.includes(file.type)) {
                alert('Only JPG, PNG, GIF, or WEBP images are allowed.');
                this.value = '';
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert('Image size must be less than 5MB.');
                this.value = '';
                return;
            }

            // Local preview
            const reader = new FileReader();
            reader.onload = function (e) {
                previewImg.src = e.target.result;
                previewWrapper.style.display = 'block';
            };
            reader.readAsDataURL(file);

            // Upload to server
            const formData = new FormData();
            formData.append('courseImage', file);

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            const headers = {};
            if (token) { headers['RequestVerificationToken'] = token.value; }

            const uploadLabel = document.querySelector('label[for="courseImageFile"]');
            const originalHtml = uploadLabel.innerHTML;
            uploadLabel.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Uploading...';
            uploadLabel.style.pointerEvents = 'none';

            fetch('/Admin/UploadCourseImage', {
                method: 'POST',
                body: formData,
                headers: headers
            })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                uploadLabel.innerHTML = originalHtml;
                uploadLabel.style.pointerEvents = 'auto';

                if (data.success) {
                    urlInput.value = data.imageUrl;
                    previewImg.src = data.imageUrl;
                    previewWrapper.style.display = 'block';
                } else {
                    alert(data.message || 'Failed to upload image.');
                    fileInput.value = '';
                }
            })
            .catch(function (error) {
                uploadLabel.innerHTML = originalHtml;
                uploadLabel.style.pointerEvents = 'auto';
                alert('Error uploading image: ' + error.message);
                fileInput.value = '';
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}