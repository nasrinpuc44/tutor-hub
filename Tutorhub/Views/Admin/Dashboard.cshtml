<!-- 📁 Views/Admin/Dashboard.cshtml -->
<!-- লোকেশন: Tutorbub/Views/Admin/Dashboard.cshtml -->

@model List<Tutorbub.Models.User>

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
    
    // পেন্ডিং টিচার রিকোয়েস্ট কাউন্ট
    var pendingCount = 0;
    try
    {
        var configuration = Context.RequestServices.GetService<IConfiguration>();
        var dbHelper = new Tutorbub.Models.DatabaseHelper(configuration);
        var requests = dbHelper.GetAllTeacherRequests();
        pendingCount = requests.Count(r => r.Status == "Pending");
    }
    catch { }
    ViewBag.PendingCount = pendingCount;
}

<style>
    /* ===== সাইডবার স্টাইল ===== */
    .sidebar {
        position: fixed;
        top: 80px;
        left: 0;
        bottom: 0;
        width: 250px;
        background-color: #1F3B2C;
        color: white;
        padding: 20px 0;
        overflow-y: auto;
        z-index: 100;
        transition: transform 0.3s ease;
    }

    .sidebar-brand {
        padding: 0 20px 20px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 15px;
    }

        .sidebar-brand h4 {
            color: #F3F1E7;
            font-weight: 600;
            margin: 0;
        }

        .sidebar-brand small {
            color: #8A9188;
            font-size: 12px;
        }

    .sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .sidebar-menu li {
            padding: 0;
        }

            .sidebar-menu li a {
                display: flex;
                align-items: center;
                padding: 12px 20px;
                color: #C7D0C9;
                text-decoration: none;
                transition: all 0.3s ease;
                border-left: 3px solid transparent;
                font-size: 14px;
                cursor: pointer;
            }

                .sidebar-menu li a:hover {
                    background-color: rgba(255, 255, 255, 0.05);
                    color: #ffffff;
                    border-left-color: #F4C744;
                }

                .sidebar-menu li a.active {
                    background-color: rgba(255, 255, 255, 0.08);
                    color: #ffffff;
                    border-left-color: #F4C744;
                }

                .sidebar-menu li a i {
                    width: 24px;
                    margin-right: 10px;
                    font-size: 16px;
                    text-align: center;
                }

                .sidebar-menu li a .badge-sidebar {
                    margin-left: auto;
                    background-color: rgba(255, 255, 255, 0.15);
                    padding: 2px 10px;
                    border-radius: 12px;
                    font-size: 11px;
                    color: #F3F1E7;
                }

    /* ===== মেইন কন্টেন্ট ===== */
    .main-content {
        margin-left: 250px;
        padding: 20px;
        min-height: calc(100vh - 80px);
    }

    /* ===== মোবাইল সাইডবার ===== */
    .sidebar-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 99;
    }

        .sidebar-overlay.active {
            display: block;
        }

    .sidebar-toggle {
        display: none;
        position: fixed;
        top: 90px;
        left: 15px;
        z-index: 101;
        background-color: #1F3B2C;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 18px;
        cursor: pointer;
    }

        .sidebar-toggle:hover {
            background-color: #2d5a42;
        }

    /* ===== Stats Card ===== */
    .stats-card {
        transition: transform 0.2s;
    }

        .stats-card:hover {
            transform: translateY(-5px);
        }

    /* ===== টেবিল স্টাইল ===== */
    .table-striped tbody tr:nth-of-type(odd) {
        background-color: rgba(0, 0, 0, .02);
    }

    .badge {
        padding: 0.5em 0.75em;
        font-weight: 600;
    }

    .card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 6px rgba(0, 0, 0, .07);
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
    }

    .table th {
        font-weight: 600;
        color: #1F3B2C;
    }

    .btn-sm {
        margin: 2px;
    }

    /* ===== ইউজার ডিটেইলস মোডাল স্টাইল ===== */
    .user-detail-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #1F3B2C;
    }

    .detail-section {
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid #f0f0f0;
    }

        .detail-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

    .detail-section-title {
        font-weight: 600;
        color: #1F3B2C;
        font-size: 14px;
        margin-bottom: 8px;
        padding: 5px 10px;
        background-color: #F3F1E7;
        border-radius: 5px;
    }

        .detail-section-title i {
            margin-right: 8px;
            color: #1F3B2C;
        }

    .detail-row {
        display: flex;
        padding: 6px 10px;
        font-size: 13px;
        border-bottom: 1px solid #f8f8f8;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        width: 140px;
        color: #6B7568;
        flex-shrink: 0;
        font-weight: 500;
    }

    .detail-value {
        color: #1F3B2C;
        word-break: break-all;
    }

        .detail-value a {
            color: #1F3B2C;
            text-decoration: underline;
        }

    /* ===== মোডাল ফিক্স ===== */
    .modal-content {
        background-color: #ffffff !important;
        border-radius: 16px !important;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15) !important;
    }

    .modal-header {
        background-color: #1F3B2C !important;
        color: white !important;
        border-radius: 16px 16px 0 0 !important;
        padding: 15px 20px !important;
    }

        .modal-header .btn-close {
            filter: brightness(0) invert(1) !important;
        }

    .modal-body {
        padding: 20px !important;
        max-height: 70vh !important;
        overflow-y: auto !important;
        background-color: #ffffff !important;
    }

        .modal-body::-webkit-scrollbar {
            width: 6px;
        }

        .modal-body::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .modal-body::-webkit-scrollbar-thumb {
            background: #1F3B2C;
            border-radius: 10px;
        }

            .modal-body::-webkit-scrollbar-thumb:hover {
                background: #2d5a42;
            }

    .modal-footer {
        border-top: 1px solid #f0f0f0 !important;
        padding: 12px 20px !important;
        border-radius: 0 0 16px 16px !important;
        background-color: #fafafa !important;
    }

    .modal-backdrop {
        background-color: rgba(0, 0, 0, 0.4) !important;
    }

        .modal-backdrop.show {
            opacity: 1 !important;
        }

    .modal.fade .modal-dialog {
        transition: transform 0.3s ease-out;
        transform: scale(0.95);
    }

    .modal.show .modal-dialog {
        transform: scale(1);
    }

    /* ===== রেস্পন্সিভ ===== */
    @@media (max-width: 992px) {
        .sidebar {
            transform: translateX(-100%);
        }

            .sidebar.open {
                transform: translateX(0);
            }

        .sidebar-toggle {
            display: block;
        }

        .sidebar-overlay.active {
            display: block;
        }

        .main-content {
            margin-left: 0;
            padding: 20px 15px;
        }
    }

    @@media (max-width: 576px) {
        .detail-row {
            flex-direction: column;
            padding: 8px 10px;
        }

        .detail-label {
            width: 100%;
            font-weight: 600;
        }

        .detail-section-title {
            font-size: 13px;
        }

        .modal-body {
            max-height: 60vh !important;
            padding: 15px !important;
        }

        .user-detail-avatar {
            width: 60px;
            height: 60px;
        }
    }
</style>

<!-- ===== সাইডবার টগল বাটন (মোবাইলের জন্য) ===== -->
<button class="sidebar-toggle" id="sidebarToggle">
    <i class="fas fa-bars"></i>
</button>

<!-- ===== সাইডবার ওভারলে (মোবাইলের জন্য) ===== -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- ===== সাইডবার ===== -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <h4><i class="fas fa-shield-alt me-2"></i>Admin Panel</h4>
        <small>Smart Tutor Hub</small>
    </div>

    <ul class="sidebar-menu">
        <li>
            <a href="#" class="active">
                <i class="fas fa-chart-pie"></i> Dashboard
                <span class="badge-sidebar">@Model.Count</span>
            </a>
        </li>
        <!-- ===== Users বাটন রিমুভ করা হয়েছে ===== -->
        <!-- ===== Teacher Request বাটন যোগ করা হয়েছে ===== -->
        <li>
            <a asp-controller="Admin" asp-action="TeacherRequests">
                <i class="fas fa-user-graduate"></i> Teacher Requests
                <span class="badge-sidebar" style="background-color:#F4C744; color:#1F3B2C;">@ViewBag.PendingCount</span>
            </a>
        </li>
        <li>
            <a href="#" onclick="loadContent('add-user')">
                <i class="fas fa-user-plus"></i> Add User
            </a>
        </li>
        <li>
            <a href="#" onclick="loadContent('roles')">
                <i class="fas fa-user-tag"></i> Roles
            </a>
        </li>
        <li>
            <a href="#" onclick="loadContent('settings')">
                <i class="fas fa-cog"></i> Settings
            </a>
        </li>
        <li style="border-top: 1px solid rgba(255,255,255,0.05); margin-top: 10px; padding-top: 10px;">
            <a href="#" onclick="changeAdminPassword()" style="color: #F4C744;">
                <i class="fas fa-key"></i> Change Password
            </a>
        </li>
        <li>
            <form method="post" asp-controller="Account" asp-action="Logout" id="logoutForm">
                @Html.AntiForgeryToken()
                <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;" style="color: #e74c3c;">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </form>
        </li>
    </ul>

    <div style="position: absolute; bottom: 20px; left: 0; right: 0; padding: 0 20px; text-align: center; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 15px;">
        <small style="color: #6B7568; font-size: 11px;">
            <i class="fas fa-circle" style="color: #2ecc71; font-size: 8px;"></i>
            Logged in as: <strong style="color: #F3F1E7;">@Context.Session.GetString("UserFullName")</strong>
        </small>
    </div>
</div>

<!-- ===== মেইন কন্টেন্ট ===== -->
<div class="main-content">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color:#1F3B2C;">
            <i class="fas fa-chart-pie me-2"></i>Dashboard
        </h2>
        <div>
            <span class="me-3" style="color:#1F3B2C;">
                <i class="fas fa-user-circle me-1"></i>
                @Context.Session.GetString("UserFullName")
            </span>
            <span class="badge bg-success">@Context.Session.GetString("UserRole")</span>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card stats-card text-white" style="background: linear-gradient(135deg, #1F3B2C, #2d5a42);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6><i class="fas fa-users me-2"></i>Total Users</h6>
                            <h2 class="fw-bold">@Model.Count</h2>
                        </div>
                        <div style="font-size: 40px; opacity: 0.3;">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card stats-card text-white" style="background: linear-gradient(135deg, #2d7d46, #3a9e5a);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6><i class="fas fa-user-check me-2"></i>Active Users</h6>
                            @{
                                var activeCount = 0;
                                foreach (var u in Model)
                                {
                                    if (u.IsActive) activeCount++;
                                }
                            }
                            <h2 class="fw-bold">@activeCount</h2>
                        </div>
                        <div style="font-size: 40px; opacity: 0.3;">
                            <i class="fas fa-user-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card stats-card text-white" style="background: linear-gradient(135deg, #b8860b, #daa520);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6><i class="fas fa-user-cog me-2"></i>Admins</h6>
                            @{
                                var adminCount = 0;
                                foreach (var u in Model)
                                {
                                    if (u.Role == "Admin") adminCount++;
                                }
                            }
                            <h2 class="fw-bold">@adminCount</h2>
                        </div>
                        <div style="font-size: 40px; opacity: 0.3;">
                            <i class="fas fa-user-cog"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card shadow">
        <div class="card-header" style="background-color:#1F3B2C; color:white;">
            <h5 class="mb-0"><i class="fas fa-list me-2"></i>All Users</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Username</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Last Login</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td><strong>@user.UserName</strong></td>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    @{
                                        var roleClass = user.Role == "Admin" ? "bg-warning" : (user.Role == "Teacher" ? "bg-info" : "bg-secondary");
                                    }
                                    <span class="badge @roleClass">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var statusClass = user.IsActive ? "bg-success" : "bg-danger";
                                        var statusText = user.IsActive ? "Active" : "Inactive";
                                    }
                                    <span class="badge @statusClass">
                                        @statusText
                                    </span>
                                </td>
                                <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @{
                                        var lastLogin = user.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Never";
                                    }
                                    @lastLogin
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-info text-white" onclick="viewUser(@user.Id)" title="View Full Profile">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-warning" onclick="changePassword(@user.Id)" title="Change Password">
                                        <i class="fas fa-key"></i>
                                    </button>
                                    @{
                                        var toggleClass = user.IsActive ? "btn-secondary" : "btn-success";
                                        var toggleIcon = user.IsActive ? "fa-pause" : "fa-play";
                                        var toggleTitle = user.IsActive ? "Disable" : "Enable";
                                    }
                                    <button class="btn btn-sm @toggleClass"
                                            onclick="toggleStatus(@user.Id, @(user.IsActive ? "false" : "true"))"
                                            title="@toggleTitle">
                                        <i class="fas @toggleIcon"></i>
                                    </button>
                                    @if (user.UserName != "admin")
                                    {
                                        <button class="btn btn-sm btn-danger" onclick="deleteUser(@user.Id)" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ===== ইউজার ডিটেইলস মোডাল ===== -->
<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user me-2"></i>User Full Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="userDetails">
                <div class="text-center py-5">
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading user profile...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== পাসওয়ার্ড মোডাল ===== -->
<div class="modal fade" id="passwordModal" tabindex="-1" aria-labelledby="passwordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#1F3B2C; color:white;">
                <h5 class="modal-title" id="passwordModalLabel">
                    <i class="fas fa-key me-2"></i>Change Password
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 25px;">
                <input type="hidden" id="passwordUserId" />
                
                <div class="text-center mb-4">
                    <i class="fas fa-lock" style="font-size: 48px; color: #1F3B2C; opacity: 0.3;"></i>
                    <p class="text-muted mt-2">Enter new password for the user</p>
                </div>
                
                <div class="mb-3">
                    <label for="newPassword" class="form-label fw-bold" style="color: #1F3B2C;">
                        <i class="fas fa-key me-1"></i> New Password
                    </label>
                    <input type="password" id="newPassword" class="form-control" 
                           placeholder="Min 6 characters" 
                           style="border-radius: 8px; padding: 12px 15px;" />
                    <small class="text-muted" style="display: block; margin-top: 5px;">
                        <i class="fas fa-info-circle me-1"></i> Password must be at least 6 characters
                    </small>
                </div>
                
                <div class="mb-3">
                    <label for="confirmNewPassword" class="form-label fw-bold" style="color: #1F3B2C;">
                        <i class="fas fa-check-double me-1"></i> Confirm Password
                    </label>
                    <input type="password" id="confirmNewPassword" class="form-control" 
                           placeholder="Confirm new password" 
                           style="border-radius: 8px; padding: 12px 15px;" />
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #eee; padding: 15px 25px;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 8px;">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-success" onclick="submitPassword()" 
                        style="background-color: #1F3B2C; border-color: #1F3B2C; border-radius: 8px; padding: 10px 25px;">
                    <i class="fas fa-save me-1"></i> Update Password
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ===== সাইডবার টগল (মোবাইলের জন্য) =====
        document.getElementById('sidebarToggle').addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('active');
        });

        document.getElementById('sidebarOverlay').addEventListener('click', function() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        });

        function loadContent(page) {
            var links = document.querySelectorAll('.sidebar-menu li a');
            for (var i = 0; i < links.length; i++) {
                links[i].classList.remove('active');
            }
            if (event && event.currentTarget) {
                event.currentTarget.classList.add('active');
            }
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
            alert('Loading ' + page + ' page... (Coming soon)');
        }

        // ===== অ্যাডমিন নিজের পাসওয়ার্ড চেঞ্জ =====
        function changeAdminPassword() {
            var currentUserId = '@Context.Session.GetString("UserId")';
            if (currentUserId) {
                changePassword(parseInt(currentUserId));
            } else {
                alert('User ID not found. Please login again.');
            }
        }

        var userId = 0;

        // ===== পাসওয়ার্ড চেঞ্জ ফাংশন =====
        function changePassword(id) {
            userId = id;
            document.getElementById('passwordUserId').value = id;
            document.getElementById('newPassword').value = '';
            document.getElementById('confirmNewPassword').value = '';
            
            // মোডাল সঠিকভাবে শো করা
            var modalElement = document.getElementById('passwordModal');
            var modal = new bootstrap.Modal(modalElement);
            modal.show();
        }

        // ===== পাসওয়ার্ড সাবমিট ফাংশন =====
        function submitPassword() {
            var password = document.getElementById('newPassword').value;
            var confirmPassword = document.getElementById('confirmNewPassword').value;
            
            if (password.length < 6) {
                alert('Password must be at least 6 characters');
                return;
            }
            
            if (password !== confirmPassword) {
                alert('Passwords do not match');
                return;
            }
            
            var id = document.getElementById('passwordUserId').value;
            if (!id) {
                alert('User ID not found');
                return;
            }
            
            var formData = new FormData();
            formData.append('id', id);
            formData.append('newPassword', password);
            
            // Anti-forgery token নেওয়া
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var headers = {};
            if (token) {
                headers['RequestVerificationToken'] = token.value;
            }
            
            // লোডিং ইন্ডিকেটর
            var btn = document.querySelector('#passwordModal .btn-success');
            var originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Updating...';
            btn.disabled = true;
            
            fetch('/Admin/UpdatePassword', {
                method: 'POST',
                body: formData,
                headers: headers
            })
            .then(function(response) {
                return response.json();
            })
            .then(function(data) {
                btn.innerHTML = originalText;
                btn.disabled = false;
                
                alert(data.message);
                if (data.success) {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('passwordModal'));
                    if (modal) {
                        modal.hide();
                    }
                    location.reload();
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
                btn.innerHTML = originalText;
                btn.disabled = false;
                alert('Error updating password: ' + error.message);
            });
        }

        // ===== ইউজার ভিউ (সম্পূর্ণ প্রোফাইল) =====
        function viewUser(id) {
            var detailsDiv = document.getElementById('userDetails');
            detailsDiv.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-success" role="status"><span class="visually-hidden">Loading...</span></div><p class="mt-2 text-muted">Loading user profile...</p></div>';

            fetch('/Admin/UserDetails?id=' + id)
                .then(function(response) {
                    return response.json();
                })
                .then(function(data) {
                    if (data.success) {
                        var u = data.user;
                        var profileImage = u.profileImageLink || 'https://i.ibb.co/fd9sY88Y/IMG-6916-1.png';
                        var roleBadge = u.role == 'Admin' ? 'bg-warning' : (u.role == 'Teacher' ? 'bg-info' : 'bg-secondary');
                        var statusBadge = u.isActive ? 'bg-success' : 'bg-danger';
                        var statusText = u.isActive ? 'Active' : 'Inactive';
                        var notProvided = 'Not provided';

                        var html = '';

                        // ===== প্রোফাইল হেডার =====
                        html += '<div class="text-center mb-3">';
                        html += '<img src="' + profileImage + '" alt="Profile" class="user-detail-avatar" />';
                        html += '<h5 class="mt-2" style="color:#1F3B2C;">' + u.fullName + '</h5>';
                        html += '<div>';
                        html += '<span class="badge ' + roleBadge + '">' + u.role + '</span>';
                        html += '<span class="badge ' + statusBadge + ' ms-1">' + statusText + '</span>';
                        html += '</div>';
                        html += '<p class="text-muted small mt-1">' + u.userName + ' • ' + u.email + '</p>';
                        html += '</div>';

                        // ===== বেসিক ইনফো =====
                        html += '<div class="detail-section">';
                        html += '<div class="detail-section-title"><i class="fas fa-id-card"></i>Basic Information</div>';
                        html += '<div class="detail-row"><span class="detail-label">ID</span><span class="detail-value">' + u.id + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Username</span><span class="detail-value"><strong>' + u.userName + '</strong></span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Full Name</span><span class="detail-value">' + u.fullName + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Email</span><span class="detail-value">' + u.email + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Mobile Number</span><span class="detail-value">' + (u.mobileNumber || notProvided) + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Created At</span><span class="detail-value">' + u.createdAt + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Last Login</span><span class="detail-value">' + u.lastLoginAt + '</span></div>';
                        html += '</div>';

                        // ===== অ্যাডিশনাল ইনফো =====
                        html += '<div class="detail-section">';
                        html += '<div class="detail-section-title"><i class="fas fa-info-circle"></i>Additional Information</div>';
                        html += '<div class="detail-row"><span class="detail-label">Gender</span><span class="detail-value">' + (u.gender || notProvided) + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Age Range</span><span class="detail-value">' + (u.ageRange || notProvided) + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Primary Device</span><span class="detail-value">' + (u.primaryDeviceType || notProvided) + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Years of Experience</span><span class="detail-value">' + (u.yearsOfExperience || notProvided) + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Area Type</span><span class="detail-value">' + (u.areaType || notProvided) + '</span></div>';
                        html += '</div>';

                        // ===== অ্যাড্রেস =====
                        html += '<div class="detail-section">';
                        html += '<div class="detail-section-title"><i class="fas fa-map-marker-alt"></i>Address</div>';
                        html += '<div class="detail-row"><span class="detail-label">Country</span><span class="detail-value">' + (u.country || notProvided) + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Street Address</span><span class="detail-value">' + (u.streetAddress || notProvided) + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Permanent Address</span><span class="detail-value">' + (u.permanentAddress || notProvided) + '</span></div>';
                        html += '</div>';

                        // ===== এডুকেশন =====
                        html += '<div class="detail-section">';
                        html += '<div class="detail-section-title"><i class="fas fa-graduation-cap"></i>Education</div>';
                        html += '<div class="detail-row"><span class="detail-label">Education Level</span><span class="detail-value">' + (u.educationLevel || notProvided) + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Currently Studying</span><span class="detail-value">' + (u.currentStudyStatus || 'No') + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Exam/Degree Title</span><span class="detail-value">' + (u.examDegreeTitle || notProvided) + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Institution Name</span><span class="detail-value">' + (u.institutionName || notProvided) + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Passing Year</span><span class="detail-value">' + (u.passingYear || notProvided) + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">CSE/CS Student</span><span class="detail-value">' + (u.isCSEStudent ? 'Yes' : 'No') + '</span></div>';
                        html += '</div>';

                        // ===== ইম্পোর্ট্যান্ট লিংক =====
                        html += '<div class="detail-section">';
                        html += '<div class="detail-section-title"><i class="fas fa-link"></i>Important Links</div>';

                        var cvLink = u.cvLink ? '<a href="' + u.cvLink + '" target="_blank">View CV <i class="fas fa-external-link-alt"></i></a>' : notProvided;
                        var githubLink = u.githubProfile ? '<a href="' + u.githubProfile + '" target="_blank">View Github <i class="fas fa-external-link-alt"></i></a>' : notProvided;
                        var portfolioLink = u.portfolioLink ? '<a href="' + u.portfolioLink + '" target="_blank">View Portfolio <i class="fas fa-external-link-alt"></i></a>' : notProvided;
                        var linkedinLink = u.linkedInProfile ? '<a href="' + u.linkedInProfile + '" target="_blank">View LinkedIn <i class="fas fa-external-link-alt"></i></a>' : notProvided;
                        var profileImageLink = u.profileImageLink ? '<a href="' + u.profileImageLink + '" target="_blank">View Image <i class="fas fa-external-link-alt"></i></a>' : notProvided;

                        html += '<div class="detail-row"><span class="detail-label">CV Link</span><span class="detail-value">' + cvLink + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Github Profile</span><span class="detail-value">' + githubLink + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Portfolio Link</span><span class="detail-value">' + portfolioLink + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">LinkedIn Profile</span><span class="detail-value">' + linkedinLink + '</span></div>';
                        html += '<div class="detail-row"><span class="detail-label">Profile Image</span><span class="detail-value">' + profileImageLink + '</span></div>';
                        html += '</div>';

                        // ===== প্রোফাইল সম্পূর্ণতার স্ট্যাটাস =====
                        var fields = [
                            { name: 'Full Name', value: u.fullName },
                            { name: 'Email', value: u.email },
                            { name: 'Mobile Number', value: u.mobileNumber },
                            { name: 'Gender', value: u.gender },
                            { name: 'Age Range', value: u.ageRange },
                            { name: 'Primary Device', value: u.primaryDeviceType },
                            { name: 'Country', value: u.country },
                            { name: 'Education Level', value: u.educationLevel }
                        ];

                        var completed = 0;
                        for (var i = 0; i < fields.length; i++) {
                            if (fields[i].value && fields[i].value !== '') {
                                completed++;
                            }
                        }
                        var total = fields.length;
                        var percentage = Math.round((completed / total) * 100);
                        var statusColor = percentage >= 80 ? 'success' : (percentage >= 50 ? 'warning' : 'danger');
                        var statusText2 = percentage >= 80 ? 'Complete' : (percentage >= 50 ? 'Partial' : 'Incomplete');

                        html += '<div class="detail-section mt-3" style="border: 2px solid #1F3B2C; border-radius: 8px; padding: 10px; background-color: #f8f9fa;">';
                        html += '<div class="detail-section-title"><i class="fas fa-check-circle"></i>Profile Status</div>';
                        html += '<div class="detail-row">';
                        html += '<span class="detail-label">Profile Completeness</span>';
                        html += '<span class="detail-value">';
                        html += '<div class="d-flex align-items-center gap-2">';
                        html += '<span>' + percentage + '%</span>';
                        html += '<div class="progress flex-grow-1" style="height: 10px; width: 150px;">';
                        html += '<div class="progress-bar bg-' + statusColor + '" role="progressbar" style="width: ' + percentage + '%;"></div>';
                        html += '</div>';
                        html += '<span class="badge bg-' + statusColor + '">' + statusText2 + '</span>';
                        html += '<small class="text-muted">(' + completed + '/' + total + ' fields)</small>';
                        html += '</div>';
                        html += '</span>';
                        html += '</div>';
                        html += '</div>';

                        detailsDiv.innerHTML = html;
                        var modal = new bootstrap.Modal(document.getElementById('userModal'));
                        modal.show();
                    } else {
                        detailsDiv.innerHTML = '<div class="alert alert-danger text-center">User not found</div>';
                    }
                })
                .catch(function(error) {
                    console.error('Error:', error);
                    detailsDiv.innerHTML = '<div class="alert alert-danger text-center">Error loading user details</div>';
                    alert('Error loading user details');
                });
        }

        // ===== স্ট্যাটাস টগল =====
        function toggleStatus(id, isActive) {
            var action = isActive ? 'activate' : 'deactivate';
            if (!confirm('Are you sure you want to ' + action + ' this user?')) {
                return;
            }

            var formData = new FormData();
            formData.append('id', id);
            formData.append('isActive', isActive);

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var headers = {};
            if (token) {
                headers['RequestVerificationToken'] = token.value;
            }

            fetch('/Admin/ToggleUserStatus', {
                method: 'POST',
                body: formData,
                headers: headers
            })
                .then(function(response) {
                    return response.json();
                })
                .then(function(data) {
                    alert(data.message);
                    if (data.success) {
                        location.reload();
                    }
                })
                .catch(function(error) {
                    console.error('Error:', error);
                    alert('Error toggling user status');
                });
        }

        // ===== ইউজার ডিলিট =====
        function deleteUser(id) {
            if (!confirm('Delete this user permanently? This action cannot be undone!')) {
                return;
            }

            var formData = new FormData();
            formData.append('id', id);

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var headers = {};
            if (token) {
                headers['RequestVerificationToken'] = token.value;
            }

            fetch('/Admin/DeleteUser', {
                method: 'POST',
                body: formData,
                headers: headers
            })
                .then(function(response) {
                    return response.json();
                })
                .then(function(data) {
                    alert(data.message);
                    if (data.success) {
                        location.reload();
                    }
                })
                .catch(function(error) {
                    console.error('Error:', error);
                    alert('Error deleting user');
                });
        }

        // Enter key press support for password fields
        document.addEventListener('DOMContentLoaded', function() {
            var passwordField = document.getElementById('newPassword');
            var confirmField = document.getElementById('confirmNewPassword');
            
            if (passwordField) {
                passwordField.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        confirmField.focus();
                    }
                });
            }
            
            if (confirmField) {
                confirmField.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        submitPassword();
                    }
                });
            }
        });
    </script>
}