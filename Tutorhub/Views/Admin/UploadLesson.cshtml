@{
    ViewData["Title"] = "Upload Lesson Video";
    Layout = "_Layout";
    var course = ViewBag.Course as Tutorbub.Models.Course;
    var lessons = ViewBag.Lessons as List<Tutorbub.Models.CourseLesson> ?? new List<Tutorbub.Models.CourseLesson>();
}

<style>
    .admin-sidebar { position: fixed; top: 80px; left: 0; bottom: 0; width: 250px; background-color: #1F3B2C; color: white; padding: 20px 0; overflow-y: auto; z-index: 100; }
    .admin-sidebar-brand { padding: 0 20px 20px 20px; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 15px; }
    .admin-sidebar-brand h4 { color: #F3F1E7; font-weight: 600; margin: 0; }
    .admin-sidebar-brand small { color: #8A9188; font-size: 12px; }
    .admin-sidebar-menu { list-style: none; padding: 0; margin: 0; }
    .admin-sidebar-menu li a { display: flex; align-items: center; padding: 12px 20px; color: #C7D0C9; text-decoration: none; transition: all 0.3s ease; border-left: 3px solid transparent; font-size: 14px; cursor: pointer; }
    .admin-sidebar-menu li a:hover, .admin-sidebar-menu li a.active { background-color: rgba(255,255,255,0.08); color: #ffffff; border-left-color: #F4C744; }
    .admin-sidebar-menu li a i { width: 24px; margin-right: 10px; font-size: 16px; text-align: center; }
    .admin-sidebar-menu li a .badge-sidebar { margin-left: auto; background-color: rgba(255,255,255,0.15); padding: 2px 10px; border-radius: 12px; font-size: 11px; color: #F3F1E7; }
    .admin-main-content { margin-left: 250px; padding: 20px; min-height: calc(100vh - 80px); }
    .sidebar-toggle { display: none; position: fixed; top: 90px; left: 15px; z-index: 101; background-color: #1F3B2C; color: white; border: none; border-radius: 8px; padding: 10px 12px; font-size: 18px; cursor: pointer; }
    .sidebar-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.5); z-index: 99; }
    .sidebar-overlay.active { display: block; }

    .lesson-item { background: white; border-radius: 12px; padding: 16px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; border: 1px solid rgba(0,0,0,0.05); }
    .lesson-item .meta { font-size: 13px; color: #6B7568; }
    .lesson-item .meta strong { color: #1F3B2C; }
    .btn-delete-lesson { background: white; color: #e74c3c; border: 1.5px solid #e74c3c; padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; }
    .btn-delete-lesson:hover { background: #f8d7da; }
    @@media (max-width: 992px) {
        .admin-sidebar { transform: translateX(-100%); }
        .admin-sidebar.open { transform: translateX(0); }
        .sidebar-toggle { display: block; }
        .admin-main-content { margin-left: 0; padding: 20px 15px; }
    }
</style>

<button class="sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-sidebar" id="sidebar">
    <div class="admin-sidebar-brand">
        <h4><i class="fas fa-shield-alt me-2"></i>Admin Panel</h4>
        <small>Smart Tutor Hub</small>
    </div>
    <ul class="admin-sidebar-menu">
        <li><a asp-controller="Admin" asp-action="Dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
        <li><a asp-controller="Admin" asp-action="TeacherRequests"><i class="fas fa-user-graduate"></i> Teacher Requests</a></li>
        <li><a asp-controller="Admin" asp-action="Payments"><i class="fas fa-money-check-alt"></i> Payments</a></li>
        <li><a asp-controller="Admin" asp-action="AddCourse"><i class="fas fa-plus-circle"></i> Add Course</a></li>
        <li><a asp-controller="Admin" asp-action="ManageCourses" class="active"><i class="fas fa-tasks"></i> Manage Courses</a></li>
        <li style="border-top: 1px solid rgba(255,255,255,0.05); margin-top: 10px; padding-top: 10px;">
            <form method="post" asp-controller="Account" asp-action="Logout" id="logoutForm">
                @Html.AntiForgeryToken()
                <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;" style="color: #e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </form>
        </li>
    </ul>
</div>

<div class="admin-main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color:#1F3B2C;">
            <i class="fas fa-video me-2"></i>Upload Lesson Video
        </h2>
        <a asp-controller="Admin" asp-action="ManageCourses" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Manage Courses
        </a>
    </div>

    @if (course != null)
    {
        <div class="card shadow mb-4" style="border-radius: 14px;">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <img src="@(string.IsNullOrEmpty(course.Image) ? "https://i.ibb.co/fd9sY88Y/IMG-6916-1.png" : course.Image)"
                         style="width:70px; height:70px; border-radius:10px; object-fit:cover;" />
                    <div>
                        <h5 class="mb-1" style="color:#1F3B2C;">@course.Title</h5>
                        <small style="color:#6B7568;">
                            <i class="fas fa-tag me-1"></i>@course.Category
                            <span class="mx-2">•</span>
                            <i class="fas fa-user-graduate me-1"></i>@course.Instructor
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Upload Form -->
            <div class="col-lg-6">
                <div class="card shadow" style="border-radius: 14px;">
                    <div class="card-header" style="background:#1F3B2C; color:white; border-radius:14px 14px 0 0;">
                        <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Add New Lesson</h5>
                    </div>
                    <div class="card-body p-4">
                        <form id="lessonForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="courseId" value="@course.Id" />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Module Number <span class="text-danger">*</span></label>
                                    <input type="number" id="moduleNumber" class="form-control" value="1" min="1" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Lesson Number <span class="text-danger">*</span></label>
                                    <input type="number" id="lessonNumber" class="form-control" value="1" min="1" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Lesson Title <span class="text-danger">*</span></label>
                                <input type="text" id="lessonTitle" class="form-control"
                                       placeholder="e.g. 1-1 Welcome & Course Overview" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Duration</label>
                                <input type="text" id="lessonDuration" class="form-control"
                                       placeholder="e.g. 6 min" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Description</label>
                                <textarea id="lessonDescription" class="form-control" rows="2"
                                          placeholder="Optional description..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Video URL <span class="text-danger">*</span></label>
                                <input type="text" id="videoUrl" class="form-control"
                                       placeholder="https://example.com/video.mp4" required />
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Direct video link দিন অথবা নিচ থেকে ফাইল আপলোড করুন
                                </small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">অথবা ডিভাইস থেকে ভিডিও আপলোড করুন</label>
                                <label for="videoFile" class="btn w-100"
                                       style="background:#F3F1E7; color:#1F3B2C; border:1.5px dashed #1F3B2C; font-weight:600; padding:9px;">
                                    <i class="fas fa-upload me-1"></i> Select Video File
                                </label>
                                <input type="file" id="videoFile" accept="video/*" style="display:none;" />
                                <small class="text-muted d-block mt-1">
                                    <i class="fas fa-info-circle me-1"></i> Max 500MB • MP4, WEBM, OGG
                                </small>
                            </div>

                            <button type="submit" class="btn w-100"
                                    style="background:#1F3B2C; color:white; padding:12px; font-weight:600;">
                                <i class="fas fa-save me-2"></i>Save Lesson
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Existing Lessons -->
            <div class="col-lg-6">
                <div class="card shadow" style="border-radius: 14px;">
                    <div class="card-header" style="background:#1F3B2C; color:white; border-radius:14px 14px 0 0;">
                        <h5 class="mb-0"><i class="fas fa-list me-2"></i>Existing Lessons (@lessons.Count)</h5>
                    </div>
                    <div class="card-body p-3" style="max-height: 600px; overflow-y:auto;">
                        @if (lessons.Count == 0)
                        {
                            <div class="text-center py-4" style="color:#8A9188;">
                                <i class="fas fa-video" style="font-size:36px; opacity:0.3;"></i>
                                <p class="mt-2 mb-0">No lessons yet. Add your first lesson!</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var lesson in lessons)
                            {
                                <div class="lesson-item" id="lesson-@lesson.Id">
                                    <div style="flex:1; min-width:0;">
                                        <div class="meta">
                                            <strong>M@(lesson.ModuleNumber) • L@(lesson.LessonNumber)</strong>
                                            <span class="mx-1">|</span>
                                            @lesson.Title
                                        </div>
                                        <div class="meta mt-1">
                                            <i class="fas fa-clock me-1"></i>@lesson.Duration
                                            <span class="mx-2">•</span>
                                            <a href="@lesson.VideoUrl" target="_blank" style="color:#1F3B2C; text-decoration:underline;">
                                                <i class="fas fa-external-link-alt me-1"></i>View Video
                                            </a>
                                        </div>
                                    </div>
                                    <button class="btn-delete-lesson" onclick="deleteLesson(@lesson.Id, '@lesson.Title')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('active');
        });
        document.getElementById('sidebarOverlay')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        });

        // ===== File upload =====
        const videoFileInput = document.getElementById('videoFile');
        const videoUrlInput = document.getElementById('videoUrl');

        videoFileInput.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;

            const allowedTypes = ['video/mp4', 'video/webm', 'video/ogg', 'video/quicktime', 'video/x-msvideo', 'video/x-matroska'];
            if (!allowedTypes.includes(file.type) && !file.name.match(/\.(mp4|webm|ogg|mov|avi|mkv)$/i)) {
                alert('Only MP4, WEBM, OGG, MOV, AVI, or MKV videos are allowed.');
                this.value = '';
                return;
            }

            if (file.size > 500 * 1024 * 1024) {
                alert('Video size must be less than 500MB.');
                this.value = '';
                return;
            }

            const formData = new FormData();
            formData.append('lessonVideo', file);

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            const headers = {};
            if (token) headers['RequestVerificationToken'] = token.value;

            const uploadLabel = document.querySelector('label[for="videoFile"]');
            const originalHtml = uploadLabel.innerHTML;
            uploadLabel.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Uploading...';
            uploadLabel.style.pointerEvents = 'none';

            fetch('/Admin/UploadLessonVideo', {
                method: 'POST',
                body: formData,
                headers: headers
            })
            .then(r => r.json())
            .then(data => {
                uploadLabel.innerHTML = originalHtml;
                uploadLabel.style.pointerEvents = 'auto';

                if (data.success) {
                    videoUrlInput.value = data.videoUrl;
                    alert('✅ Video uploaded successfully!');
                } else {
                    alert(data.message || 'Failed to upload video.');
                    videoFileInput.value = '';
                }
            })
            .catch(err => {
                uploadLabel.innerHTML = originalHtml;
                uploadLabel.style.pointerEvents = 'auto';
                alert('Error uploading video: ' + err.message);
                videoFileInput.value = '';
            });
        });

        // ===== Submit form =====
        document.getElementById('lessonForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const courseId = parseInt(document.getElementById('courseId').value);
            const moduleNumber = parseInt(document.getElementById('moduleNumber').value);
            const lessonNumber = parseInt(document.getElementById('lessonNumber').value);
            const title = document.getElementById('lessonTitle').value.trim();
            const duration = document.getElementById('lessonDuration').value.trim();
            const description = document.getElementById('lessonDescription').value.trim();
            const videoUrl = document.getElementById('videoUrl').value.trim();

            if (!title) { alert('Lesson title is required.'); return; }
            if (!videoUrl) { alert('Video URL is required.'); return; }

            const formData = new FormData();
            formData.append('courseId', courseId);
            formData.append('moduleNumber', moduleNumber);
            formData.append('lessonNumber', lessonNumber);
            formData.append('title', title);
            formData.append('duration', duration);
            formData.append('description', description);
            formData.append('videoUrl', videoUrl);

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            const headers = {};
            if (token) headers['RequestVerificationToken'] = token.value;

            const btn = this.querySelector('button[type="submit"]');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Saving...';
            btn.disabled = true;

            fetch('/Admin/UploadLesson', {
                method: 'POST',
                body: formData,
                headers: headers
            })
            .then(r => r.json())
            .then(data => {
                btn.innerHTML = originalHtml;
                btn.disabled = false;

                alert(data.message);
                if (data.success) {
                    location.reload();
                }
            })
            .catch(err => {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                alert('Error: ' + err.message);
            });
        });

        // ===== Delete lesson =====
        function deleteLesson(id, title) {
            if (!confirm('Delete lesson "' + title + '"?\n\nThis action cannot be undone.')) return;

            const formData = new FormData();
            formData.append('id', id);

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            const headers = {};
            if (token) headers['RequestVerificationToken'] = token.value;

            fetch('/Admin/DeleteLesson', {
                method: 'POST',
                body: formData,
                headers: headers
            })
            .then(r => r.json())
            .then(data => {
                alert(data.message);
                if (data.success) location.reload();
            })
            .catch(() => alert('Error deleting lesson.'));
        }
    </script>
}