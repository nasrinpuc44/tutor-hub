@model List<Tutorbub.Models.Course>

@{
    ViewData["Title"] = "Quiz & Assignment";
    Layout = "_Layout";
    var quizCounts = ViewBag.QuizCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var assignCounts = ViewBag.AssignCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<style>
    /* ===== Admin Sidebar ===== */
    .admin-sidebar {
        position: fixed;
        top: 80px;
        left: 0;
        bottom: 0;
        width: 250px;
        background-color: #1F3B2C;
        color: white;
        padding: 20px 0;
        overflow-y: auto;
        z-index: 100;
        transition: transform 0.3s ease;
    }

    .admin-sidebar-brand {
        padding: 0 20px 20px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        margin-bottom: 15px;
    }

    .admin-sidebar-brand h4 {
        color: #F3F1E7;
        font-weight: 600;
        margin: 0;
    }

    .admin-sidebar-brand small {
        color: #8A9188;
        font-size: 12px;
    }

    .admin-sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .admin-sidebar-menu li a {
        display: flex;
        align-items: center;
        padding: 12px 20px;
        color: #C7D0C9;
        text-decoration: none;
        transition: all 0.3s ease;
        border-left: 3px solid transparent;
        font-size: 14px;
        cursor: pointer;
    }

    .admin-sidebar-menu li a:hover,
    .admin-sidebar-menu li a.active {
        background-color: rgba(255,255,255,0.08);
        color: #ffffff;
        border-left-color: #F4C744;
    }

    .admin-sidebar-menu li a i {
        width: 24px;
        margin-right: 10px;
        font-size: 16px;
        text-align: center;
    }

    .admin-main-content {
        margin-left: 250px;
        padding: 20px;
        min-height: calc(100vh - 80px);
    }

    .sidebar-toggle {
        display: none;
        position: fixed;
        top: 90px;
        left: 15px;
        z-index: 101;
        background-color: #1F3B2C;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 18px;
        cursor: pointer;
    }

    .sidebar-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0,0,0,0.5);
        z-index: 99;
    }

    .sidebar-overlay.active {
        display: block;
    }

    /* ===== Page Header ===== */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .page-header h2 {
        color: #1F3B2C;
        margin: 0;
        font-size: 24px;
        font-weight: 700;
    }

    .page-header .subtitle {
        color: #6B7568;
        font-size: 14px;
        margin-top: 4px;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 18px;
        background: white;
        color: #1F3B2C;
        border: 1.5px solid #1F3B2C;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13.5px;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-back:hover {
        background: #1F3B2C;
        color: white;
    }

    /* ===== Info Card ===== */
    .info-card {
        background: linear-gradient(135deg, #FFF9E6 0%, #FFFAF0 100%);
        border-radius: 14px;
        padding: 16px 20px;
        border-left: 5px solid #F4C744;
        margin-bottom: 22px;
        font-size: 13.5px;
        color: #4B5648;
        line-height: 1.6;
    }

    .info-card i.fa-info-circle {
        color: #D98E1F;
        margin-right: 6px;
        font-size: 16px;
    }

    .info-card strong {
        color: #1F3B2C;
    }

    /* ===== Course Row ===== */
    .course-row {
        background: white;
        border-radius: 14px;
        padding: 18px;
        margin-bottom: 12px;
        display: flex;
        gap: 18px;
        align-items: center;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        border: 1px solid rgba(0,0,0,0.04);
        flex-wrap: wrap;
        transition: all 0.25s;
    }

    .course-row:hover {
        box-shadow: 0 6px 22px rgba(31,59,44,0.1);
        transform: translateY(-2px);
    }

    .course-row img {
        width: 70px;
        height: 70px;
        border-radius: 10px;
        object-fit: cover;
        flex-shrink: 0;
        background: #E7E4D9;
    }

    .course-row .info {
        flex: 1;
        min-width: 220px;
    }

    .course-row .info h5 {
        font-size: 16px;
        font-weight: 700;
        color: #1F3B2C;
        margin: 0 0 6px;
        line-height: 1.4;
    }

    .course-row .info .meta {
        font-size: 12.5px;
        color: #6B7568;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .course-row .info .meta i {
        color: #1F3B2C;
        margin-right: 4px;
    }

    /* ===== Stat Badges ===== */
    .stats-badges {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .stat-badge {
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 12.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .stat-badge.quiz {
        background: #d1ecf1;
        color: #0c6b7c;
    }

    .stat-badge.assign {
        background: #fceacb;
        color: #8a5a00;
    }

    .stat-badge.zero {
        background: #e2e3e5;
        color: #6c757d;
    }

    /* ===== Manage Button ===== */
    .btn-manage {
        background: #8e63d9;
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.25s;
        border: none;
        white-space: nowrap;
    }

    .btn-manage:hover {
        background: #6f42c1;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(142,99,217,0.35);
    }

    /* ===== Empty State ===== */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .empty-state i {
        font-size: 56px;
        color: #E7E4D9;
        display: block;
        margin-bottom: 16px;
    }

    .empty-state h5 {
        color: #1F3B2C;
        font-size: 18px;
        font-weight: 700;
        margin: 0 0 8px;
    }

    .empty-state p {
        color: #8A9188;
        font-size: 14px;
        margin: 0 0 20px;
    }

    .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 26px;
        background: #1F3B2C;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-primary-custom:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(31,59,44,0.22);
        color: white;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 992px) {
        .admin-sidebar {
            transform: translateX(-100%);
        }

        .admin-sidebar.open {
            transform: translateX(0);
        }

        .sidebar-toggle {
            display: block;
        }

        .admin-main-content {
            margin-left: 0;
            padding: 20px 15px;
        }
    }

    @@media (max-width: 576px) {
        .page-header h2 {
            font-size: 20px;
        }

        .course-row {
            flex-direction: column;
            align-items: stretch;
        }

        .course-row img {
            width: 100%;
            height: 140px;
        }

        .stats-badges {
            justify-content: flex-start;
        }

        .btn-manage {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<!-- ===== Sidebar Toggle (Mobile) ===== -->
<button class="sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- ===== Admin Sidebar ===== -->
<div class="admin-sidebar" id="sidebar">
    <div class="admin-sidebar-brand">
        <h4><i class="fas fa-shield-alt me-2"></i>Admin Panel</h4>
        <small>Smart Tutor Hub</small>
    </div>
    <ul class="admin-sidebar-menu">
        <li><a asp-controller="Admin" asp-action="Dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
        <li><a asp-controller="Admin" asp-action="TeacherRequests"><i class="fas fa-user-graduate"></i> Teacher Requests</a></li>
        <li><a asp-controller="Admin" asp-action="Payments"><i class="fas fa-money-check-alt"></i> Payments</a></li>
        <li><a asp-controller="Admin" asp-action="AddCourse"><i class="fas fa-plus-circle"></i> Add Course</a></li>
        <li><a asp-controller="Admin" asp-action="ManageCourses"><i class="fas fa-tasks"></i> Manage Courses</a></li>
        <li><a asp-controller="Admin" asp-action="QuizAssignmentOverview" class="active"><i class="fas fa-question-circle"></i> Quiz & Assignment</a></li>
        <li><a asp-controller="Admin" asp-action="ManageNotices"><i class="fas fa-newspaper"></i> News & Announcements</a></li>
        <li style="border-top: 1px solid rgba(255,255,255,0.05); margin-top: 10px; padding-top: 10px;">
            <form method="post" asp-controller="Account" asp-action="Logout" id="logoutForm">
                @Html.AntiForgeryToken()
                <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;" style="color: #e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </form>
        </li>
    </ul>
</div>

<!-- ===== Main Content ===== -->
<div class="admin-main-content">

    <!-- ===== Page Header ===== -->
    <div class="page-header">
        <div>
            <h2><i class="fas fa-question-circle me-2"></i>Quiz & Assignment</h2>
            <div class="subtitle">প্রতিটি Course-এর Quiz এবং Assignment Manage করুন</div>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <!-- ===== Info Banner ===== -->
    <div class="info-card">
        <i class="fas fa-info-circle"></i>
        <strong>System Flow:</strong>
        প্রতি Module Complete → Module Quiz Available |
        প্রতি ৪টি Module Complete → Milestone Complete → Milestone Assignment Available
    </div>

    <!-- ===== Courses List ===== -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-book"></i>
            <h5>No courses yet</h5>
            <p>শুরু করার জন্য প্রথমে একটি Course তৈরি করুন।</p>
            <a asp-controller="Admin" asp-action="AddCourse" class="btn-primary-custom">
                <i class="fas fa-plus-circle"></i> Add New Course
            </a>
        </div>
    }
    else
    {
        foreach (var course in Model)
        {
            var quizCount = quizCounts.ContainsKey(course.Id) ? quizCounts[course.Id] : 0;
            var assignCount = assignCounts.ContainsKey(course.Id) ? assignCounts[course.Id] : 0;
            var imgSrc = string.IsNullOrEmpty(course.Image)
                ? "https://i.ibb.co/fd9s88Y/IMG-6916-1.png"
                : course.Image;

            <div class="course-row">
                <img src="@imgSrc" alt="@course.Title" />

                <div class="info">
                    <h5>@course.Title</h5>
                    <div class="meta">
                        <span><i class="fas fa-tag"></i>@course.Category</span>
                        <span><i class="fas fa-user-graduate"></i>@course.Instructor</span>
                        <span><i class="fas fa-clock"></i>@course.Duration</span>
                    </div>
                </div>

                <div class="stats-badges">
                    <span class="stat-badge quiz @(quizCount == 0 ? "zero" : "")">
                        <i class="fas fa-question-circle"></i> @quizCount Quiz
                    </span>
                    <span class="stat-badge assign @(assignCount == 0 ? "zero" : "")">
                        <i class="fas fa-tasks"></i> @assignCount Assignment
                    </span>
                </div>

                <a asp-controller="Admin"
                   asp-action="ManageQuizAssignment"
                   asp-route-courseId="@course.Id"
                   class="btn-manage">
                    <i class="fas fa-cog"></i> Manage Quiz & Assignment
                </a>
            </div>
        }
    }

</div>

@section Scripts {
    <script>
        // ===== Sidebar Toggle =====
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('active');
        });

        document.getElementById('sidebarOverlay')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        });
    </script>
}