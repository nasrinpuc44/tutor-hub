@model List<Tutorbub.Models.Course>

@{
    ViewData["Title"] = "Quiz & Assignment";
    Layout = "_Layout";
    var quizCounts = ViewBag.QuizCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var assignCounts = ViewBag.AssignCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<style>
    /* ===== Main Content Layout ===== */
    .admin-main-content {
        margin-left: 250px;
        padding: 20px;
        min-height: calc(100vh - 80px);
    }

    /* ===== Page Header ===== */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

        .page-header h2 {
            color: #1F3B2C;
            margin: 0;
            font-size: 24px;
            font-weight: 700;
        }

        .page-header .subtitle {
            color: #6B7568;
            font-size: 14px;
            margin-top: 4px;
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 18px;
        background: white;
        color: #1F3B2C;
        border: 1.5px solid #1F3B2C;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13.5px;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-back:hover {
            background: #1F3B2C;
            color: white;
        }

    /* ===== Info Card ===== */
    .info-card {
        background: linear-gradient(135deg, #FFF9E6 0%, #FFFAF0 100%);
        border-radius: 14px;
        padding: 16px 20px;
        border-left: 5px solid #F4C744;
        margin-bottom: 22px;
        font-size: 13.5px;
        color: #4B5648;
        line-height: 1.6;
    }

        .info-card i.fa-info-circle {
            color: #D98E1F;
            margin-right: 6px;
            font-size: 16px;
        }

        .info-card strong {
            color: #1F3B2C;
        }

    /* ===== Course Row ===== */
    .course-row {
        background: white;
        border-radius: 14px;
        padding: 18px;
        margin-bottom: 12px;
        display: flex;
        gap: 18px;
        align-items: center;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        border: 1px solid rgba(0,0,0,0.04);
        flex-wrap: wrap;
        transition: all 0.25s;
    }

        .course-row:hover {
            box-shadow: 0 6px 22px rgba(31,59,44,0.1);
            transform: translateY(-2px);
        }

        .course-row img {
            width: 70px;
            height: 70px;
            border-radius: 10px;
            object-fit: cover;
            flex-shrink: 0;
            background: #E7E4D9;
        }

        .course-row .info {
            flex: 1;
            min-width: 220px;
        }

            .course-row .info h5 {
                font-size: 16px;
                font-weight: 700;
                color: #1F3B2C;
                margin: 0 0 6px;
                line-height: 1.4;
            }

            .course-row .info .meta {
                font-size: 12.5px;
                color: #6B7568;
                display: flex;
                flex-wrap: wrap;
                gap: 12px;
            }

                .course-row .info .meta i {
                    color: #1F3B2C;
                    margin-right: 4px;
                }

    /* ===== Stat Badges ===== */
    .stats-badges {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .stat-badge {
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 12.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .stat-badge.quiz {
            background: #d1ecf1;
            color: #0c6b7c;
        }

        .stat-badge.assign {
            background: #fceacb;
            color: #8a5a00;
        }

        .stat-badge.zero {
            background: #e2e3e5;
            color: #6c757d;
        }

    /* ===== Manage Button ===== */
    .btn-manage {
        background: #8e63d9;
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.25s;
        border: none;
        white-space: nowrap;
    }

        .btn-manage:hover {
            background: #6f42c1;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(142,99,217,0.35);
        }

    /* ===== Empty State ===== */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

        .empty-state i {
            font-size: 56px;
            color: #E7E4D9;
            display: block;
            margin-bottom: 16px;
        }

        .empty-state h5 {
            color: #1F3B2C;
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 8px;
        }

        .empty-state p {
            color: #8A9188;
            font-size: 14px;
            margin: 0 0 20px;
        }

    .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 26px;
        background: #1F3B2C;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-primary-custom:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(31,59,44,0.22);
            color: white;
        }

    /* ===== Responsive ===== */
    @@media (max-width: 992px) {
        .admin-main-content {
            margin-left: 0;
            padding: 20px 15px;
        }
    }

    @@media (max-width: 576px) {
        .page-header h2 {
            font-size: 20px;
        }

        .course-row {
            flex-direction: column;
            align-items: stretch;
        }

            .course-row img {
                width: 100%;
                height: 140px;
            }

        .stats-badges {
            justify-content: flex-start;
        }

        .btn-manage {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<!-- ===== Admin Sidebar (Partial) ===== -->
<partial name="_AdminSidebar" />

<!-- ===== Main Content ===== -->
<div class="admin-main-content">

    <!-- ===== Page Header ===== -->
    <div class="page-header">
        <div>
            <h2><i class="fas fa-question-circle me-2"></i>Quiz &amp; Assignment</h2>
            <div class="subtitle">প্রতিটি Course-এর Quiz এবং Assignment Manage করুন</div>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <!-- ===== Info Banner ===== -->
    <div class="info-card">
        <i class="fas fa-info-circle"></i>
        <strong>System Flow:</strong>
        প্রতি Module Complete → Module Quiz Available |
        প্রতি ৪টি Module Complete → Milestone Complete → Milestone Assignment Available
    </div>

    <!-- ===== Courses List ===== -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-book"></i>
            <h5>No courses yet</h5>
            <p>শুরু করার জন্য প্রথমে একটি Course তৈরি করুন।</p>
            <a asp-controller="Admin" asp-action="AddCourse" class="btn-primary-custom">
                <i class="fas fa-plus-circle"></i> Add New Course
            </a>
        </div>
    }
    else
    {
        foreach (var course in Model)
        {
            var quizCount = quizCounts.ContainsKey(course.Id) ? quizCounts[course.Id] : 0;
            var assignCount = assignCounts.ContainsKey(course.Id) ? assignCounts[course.Id] : 0;
            var imgSrc = string.IsNullOrEmpty(course.Image)
                ? "https://i.ibb.co/fd9s88Y/IMG-6916-1.png"
                : course.Image;

            <div class="course-row">
                <img src="@imgSrc" alt="@course.Title" />

                <div class="info">
                    <h5>@course.Title</h5>
                    <div class="meta">
                        <span><i class="fas fa-tag"></i>@course.Category</span>
                        <span><i class="fas fa-user-graduate"></i>@course.Instructor</span>
                        <span><i class="fas fa-clock"></i>@course.Duration</span>
                    </div>
                </div>

                <div class="stats-badges">
                    <span class="stat-badge quiz @(quizCount == 0 ? "zero" : "")">
                        <i class="fas fa-question-circle"></i> @quizCount Quiz
                    </span>
                    <span class="stat-badge assign @(assignCount == 0 ? "zero" : "")">
                        <i class="fas fa-tasks"></i> @assignCount Assignment
                    </span>
                </div>

                <a asp-controller="Admin"
                   asp-action="ManageQuizAssignment"
                   asp-route-courseId="@course.Id"
                   class="btn-manage">
                    <i class="fas fa-cog"></i> Manage Quiz &amp; Assignment
                </a>
            </div>
        }
    }

</div>