            function submitTutorRequest(e) {
                e.preventDefault();
                var tutorId = document.getElementById('rtTutor').value;
                var tutor = allTutors.find(function (x) { return x.id == tutorId; });
                var reqId = generateRequestId();

                var tutorLine = tutor
                    ? 'Your request for <strong>' + escapeHtml(tutor.fullName) + '</strong> (' + escapeHtml(tutor.tutorId) + ') '
                    : '';

                document.getElementById('requestTutorBody').innerHTML = ''
                    + '<div class="success-panel">'
                    + '  <div class="success-icon"><i class="fas fa-check"></i></div>'
                    + '  <h4>Request Submitted Successfully!</h4>'
                    + '  <p>' + tutorLine + 'has been received. Our admin team will review your requirements and contact you soon.</p>'
                    + '  <div class="success-req-id"><span class="req-label">Request ID</span><span class="req-value">' + reqId + '</span></div>'
                    + '  <button class="btn-ok" onclick="closeModal(\'requestTutorModal\')">OK</button>'
                    + '</div>';
            }

