@model List<Tutorbub.Models.TutorProfile>

@{
    ViewData["Title"] = "Find Tutor - Smart Tutor Hub";
    Layout = "_Layout";
}

<style>
    /* ======================
           PAGE WRAPPER
           ====================== */
    .ft-page {
        background: #F3F1E7;
        padding: 40px 20px 70px;
        min-height: 80vh;
    }

    .ft-layout {
        max-width: 1280px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 30px;
        align-items: start;
    }

    .ft-header {
        text-align: center;
        margin-bottom: 30px;
        grid-column: 1 / -1;
    }

        .ft-header h1 {
            font-family: 'Georgia', serif;
            font-size: 36px;
            font-weight: 700;
            color: #1F3B2C;
            margin: 0 0 10px;
        }

        .ft-header p {
            color: #5B6B5E;
            font-size: 15.5px;
            margin: 0 auto;
            max-width: 640px;
            line-height: 1.6;
        }

    .ft-search {
        max-width: 620px;
        margin: 24px auto 0;
        display: flex;
        background: white;
        border-radius: 50px;
        padding: 6px 6px 6px 22px;
        box-shadow: 0 8px 30px rgba(31,59,44,0.08);
        align-items: center;
        gap: 10px;
        border: 2px solid transparent;
        transition: border-color 0.3s;
    }

        .ft-search:focus-within {
            border-color: #1F3B2C;
        }

        .ft-search i {
            color: #8A9188;
            font-size: 16px;
            flex-shrink: 0;
        }

        .ft-search input {
            flex: 1;
            border: none;
            outline: none;
            font-size: 14.5px;
            padding: 11px 0;
            background: transparent;
            color: #1F3B2C;
            min-width: 0;
        }

        .ft-search button {
            background: #1F3B2C;
            color: white;
            border: none;
            padding: 11px 24px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 13.5px;
            cursor: pointer;
            transition: opacity 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

            .ft-search button:hover {
                opacity: 0.88;
            }

    .quick-chips {
        display: flex;
        gap: 8px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    .quick-chip {
        background: white;
        color: #1F3B2C;
        border: 1.5px solid #E5E1D3;
        padding: 7px 16px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.25s;
        user-select: none;
    }

        .quick-chip:hover {
            border-color: #1F3B2C;
            transform: translateY(-1px);
        }

        .quick-chip.active {
            background: #1F3B2C;
            color: white;
            border-color: #1F3B2C;
        }

    .list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        flex-wrap: wrap;
        gap: 10px;
    }

        .list-header h3 {
            font-size: 18px;
            font-weight: 700;
            color: #1F3B2C;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .list-header .count-badge {
            background: #1F3B2C;
            color: white;
            font-size: 12px;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 600;
        }

        .list-header .sort-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #6B7568;
        }

            .list-header .sort-wrap select {
                border: 1.5px solid #E5E1D3;
                background: white;
                padding: 7px 12px;
                border-radius: 8px;
                font-size: 13px;
                color: #1F3B2C;
                outline: none;
                font-weight: 500;
                cursor: pointer;
            }

    .tutor-row {
        background: white;
        border-radius: 16px;
        padding: 22px;
        margin-bottom: 16px;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        transition: all 0.3s;
        display: grid;
        grid-template-columns: 90px 1fr auto;
        gap: 20px;
        align-items: center;
    }

        .tutor-row:hover {
            transform: translateX(3px);
            box-shadow: 0 8px 28px rgba(31,59,44,0.1);
            border-color: rgba(31,59,44,0.15);
        }

    .tr-avatar {
        position: relative;
        width: 90px;
        height: 90px;
    }

        .tr-avatar .avatar-circle {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1F3B2C, #2d5a42);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            font-weight: 700;
            border: 3px solid #F3F1E7;
            box-shadow: 0 4px 14px rgba(31,59,44,0.2);
            overflow: hidden;
        }

            .tr-avatar .avatar-circle img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .tr-avatar .v-tick {
            position: absolute;
            bottom: 3px;
            right: 3px;
            background: #2ecc71;
            color: white;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            border: 3px solid white;
        }

    .tr-info {
        min-width: 0;
    }

    .tr-name-line {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 4px;
    }

    .tr-name {
        font-size: 19px;
        font-weight: 700;
        color: #1F3B2C;
        margin: 0;
    }

    .tr-id {
        font-family: 'Courier New', monospace;
        background: #F3F1E7;
        color: #5B6B5E;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        letter-spacing: 0.4px;
    }

    .tr-top-badge {
        background: linear-gradient(135deg, #D98E1F, #B8760F);
        color: white;
        font-size: 10px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .tr-rating-line {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-size: 13px;
    }

        .tr-rating-line .stars {
            color: #D98E1F;
            font-weight: 600;
        }

        .tr-rating-line .count {
            color: #8A9188;
            font-size: 12.5px;
        }

    .tr-meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 6px 18px;
        font-size: 13px;
        color: #5B6B5E;
        margin-bottom: 10px;
    }

        .tr-meta .m-item {
            display: flex;
            align-items: center;
            gap: 7px;
            min-width: 0;
        }

            .tr-meta .m-item i {
                color: #1F3B2C;
                font-size: 12px;
                width: 14px;
                text-align: center;
                flex-shrink: 0;
            }

            .tr-meta .m-item span {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

    .tr-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .tr-tag {
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 20px;
        background: #F3F1E7;
        color: #1F3B2C;
        font-weight: 500;
    }

        .tr-tag.mode {
            background: #d1ecf1;
            color: #0c6b7c;
        }

    .tr-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: stretch;
        min-width: 150px;
    }

    .tr-fee {
        text-align: right;
        margin-bottom: 4px;
    }

        .tr-fee .fee-val {
            font-size: 19px;
            font-weight: 800;
            color: #1F3B2C;
            line-height: 1;
        }

        .tr-fee .fee-lbl {
            font-size: 10.5px;
            color: #8A9188;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            font-weight: 600;
        }

    .btn-view-tr {
        background: white;
        color: #1F3B2C;
        border: 1.5px solid #1F3B2C;
        padding: 9px 16px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.25s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .btn-view-tr:hover {
            background: #F3F1E7;
        }

    .btn-request-tr {
        background: #1F3B2C;
        color: white;
        border: none;
        padding: 10px 16px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: opacity 0.25s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .btn-request-tr:hover {
            opacity: 0.88;
        }

    .ft-sidebar {
        position: sticky;
        top: 100px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .sidebar-card {
        background: white;
        border-radius: 18px;
        padding: 26px 24px;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .area-tuition-card {
        background: linear-gradient(145deg, #1F3B2C 0%, #2d5a42 100%);
        color: white;
        border-radius: 18px;
        padding: 28px 24px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 34px rgba(31,59,44,0.25);
    }

        .area-tuition-card::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(244,199,68,0.18) 0%, transparent 65%);
            border-radius: 50%;
        }

        .area-tuition-card .atc-icon {
            width: 54px;
            height: 54px;
            border-radius: 14px;
            background: rgba(244,199,68,0.15);
            color: #F4C744;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 16px;
            position: relative;
        }

        .area-tuition-card h3 {
            font-family: 'Georgia', serif;
            font-size: 22px;
            font-weight: 700;
            color: white;
            margin: 0 0 10px;
            line-height: 1.25;
            position: relative;
        }

        .area-tuition-card p {
            font-size: 13.5px;
            line-height: 1.65;
            margin: 0 0 18px;
            color: #D6DED5;
            position: relative;
        }

        .area-tuition-card .atc-features {
            list-style: none;
            padding: 0;
            margin: 0 0 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            position: relative;
        }

            .area-tuition-card .atc-features li {
                display: flex;
                align-items: flex-start;
                gap: 9px;
                font-size: 13px;
                color: #E8EDE7;
                line-height: 1.5;
            }

                .area-tuition-card .atc-features li i {
                    color: #F4C744;
                    font-size: 13px;
                    margin-top: 3px;
                    flex-shrink: 0;
                }

    .btn-area-contact {
        width: 100%;
        background: #F4C744;
        color: #1F3B2C;
        border: none;
        padding: 13px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.25s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        position: relative;
    }

        .btn-area-contact:hover {
            background: #E8B92E;
            transform: translateY(-1px);
        }

    .helper-card h4 {
        font-family: 'Georgia', serif;
        font-size: 18px;
        color: #1F3B2C;
        margin: 0 0 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .helper-card h4 i {
            color: #D98E1F;
            font-size: 17px;
        }

    .helper-card p {
        font-size: 13.5px;
        color: #6B7568;
        line-height: 1.6;
        margin: 0 0 16px;
    }

    .btn-helper {
        width: 100%;
        background: white;
        color: #1F3B2C;
        border: 1.5px solid #1F3B2C;
        padding: 11px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
        transition: all 0.25s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

        .btn-helper:hover {
            background: #1F3B2C;
            color: white;
        }

    .tid-card {
        background: #FAF9F4;
        border-radius: 16px;
        padding: 20px 22px;
        border: 1.5px dashed #D5CFB8;
    }

        .tid-card h5 {
            font-size: 14.5px;
            font-weight: 700;
            color: #1F3B2C;
            margin: 0 0 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .tid-card h5 i {
                color: #1F3B2C;
            }

        .tid-card p {
            font-size: 12.5px;
            color: #6B7568;
            margin: 0 0 12px;
            line-height: 1.5;
        }

        .tid-card .tid-input {
            display: flex;
            gap: 6px;
        }

        .tid-card input {
            flex: 1;
            border: 1.5px solid #E5E1D3;
            background: white;
            padding: 9px 12px;
            border-radius: 8px;
            font-size: 13px;
            outline: none;
            font-family: 'Courier New', monospace;
            letter-spacing: 0.3px;
            min-width: 0;
        }

            .tid-card input:focus {
                border-color: #1F3B2C;
            }

        .tid-card button {
            background: #1F3B2C;
            color: white;
            border: none;
            padding: 9px 14px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 12.5px;
            cursor: pointer;
            transition: opacity 0.25s;
            flex-shrink: 0;
        }

            .tid-card button:hover {
                opacity: 0.88;
            }

    .empty-state {
        background: white;
        border-radius: 16px;
        padding: 50px 26px;
        text-align: center;
        border: 1px solid rgba(0,0,0,0.05);
    }

        .empty-state .es-icon {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #F3F1E7;
            color: #8A9188;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin-bottom: 14px;
        }

        .empty-state h4 {
            font-size: 17px;
            font-weight: 700;
            color: #1F3B2C;
            margin: 0 0 6px;
        }

        .empty-state p {
            color: #6B7568;
            font-size: 13.5px;
            margin: 0 0 18px;
        }

    .ft-modal .modal-content {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 24px 80px rgba(0,0,0,0.2);
    }

    .ft-modal .modal-header {
        background: #1F3B2C;
        color: white;
        border: none;
        padding: 20px 26px;
    }

        .ft-modal .modal-header .modal-title {
            font-size: 17px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .ft-modal .modal-header .btn-close {
            filter: brightness(0) invert(1);
            opacity: 0.9;
        }

    .ft-modal .modal-body {
        padding: 26px;
        max-height: 72vh;
        overflow-y: auto;
        background: #fff;
    }

    .tp-header {
        display: flex;
        gap: 20px;
        align-items: center;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
        margin-bottom: 22px;
    }

    .tp-avatar {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1F3B2C, #2d5a42);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 30px;
        flex-shrink: 0;
        position: relative;
        border: 3px solid white;
        box-shadow: 0 6px 20px rgba(31,59,44,0.2);
        overflow: hidden;
    }

        .tp-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .tp-avatar .v-tick {
            position: absolute;
            bottom: 0;
            right: 0;
            background: #2ecc71;
            color: white;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            border: 3px solid white;
        }

    .tp-name {
        font-size: 22px;
        font-weight: 700;
        color: #1F3B2C;
        margin: 0 0 6px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .tp-id {
        display: inline-block;
        background: #F3F1E7;
        color: #5B6B5E;
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        font-family: 'Courier New', monospace;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .tp-rating-line {
        color: #D98E1F;
        font-size: 14px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .tp-rating-line .count {
            color: #8A9188;
            font-size: 12.5px;
            font-weight: 400;
        }

    .tp-stat-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 22px;
    }

    .tp-stat {
        background: #F3F1E7;
        border-radius: 12px;
        padding: 14px;
        text-align: center;
    }

        .tp-stat .num {
            font-size: 20px;
            font-weight: 800;
            color: #1F3B2C;
            line-height: 1.2;
        }

        .tp-stat .lbl {
            font-size: 11px;
            color: #6B7568;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            font-weight: 600;
            margin-top: 3px;
        }

    .tp-block {
        margin-bottom: 22px;
    }

    .tp-block-title {
        font-size: 13.5px;
        font-weight: 700;
        color: #1F3B2C;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

        .tp-block-title i {
            color: #1F3B2C;
            font-size: 13px;
        }

    .tp-block p {
        font-size: 14px;
        color: #4B5648;
        line-height: 1.7;
        margin: 0;
    }

    .tp-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .tp-info-item {
        background: #FAF9F4;
        border-radius: 10px;
        padding: 12px 14px;
    }

        .tp-info-item .label {
            font-size: 10.5px;
            text-transform: uppercase;
            color: #8A9188;
            letter-spacing: 0.4px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .tp-info-item .value {
            font-size: 13.5px;
            font-weight: 600;
            color: #1F3B2C;
        }

    .tp-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .tp-chip {
        font-size: 12px;
        padding: 5px 12px;
        border-radius: 20px;
        background: #F3F1E7;
        color: #1F3B2C;
        font-weight: 500;
    }

    .tp-cta {
        background: #FAF9F4;
        border-radius: 12px;
        padding: 18px;
        text-align: center;
        border: 1.5px solid #E5E1D3;
        margin-top: 22px;
    }

        .tp-cta p {
            font-size: 13px;
            color: #6B7568;
            margin: 0 0 12px;
            line-height: 1.5;
        }

    .ft-form .form-intro {
        background: #FAF9F4;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 22px;
        border-left: 3px solid #1F3B2C;
    }

        .ft-form .form-intro p {
            font-size: 13px;
            color: #5B6B5E;
            margin: 0;
            line-height: 1.6;
        }

        .ft-form .form-intro strong {
            color: #1F3B2C;
        }

    .ft-form .form-section-label {
        font-size: 11.5px;
        font-weight: 700;
        color: #8A9188;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin: 22px 0 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .ft-form .form-section-label:first-child {
            margin-top: 0;
        }

        .ft-form .form-section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #eee;
        }

    .ft-form .field {
        margin-bottom: 14px;
    }

        .ft-form .field label {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: #1F3B2C;
            margin-bottom: 6px;
        }

            .ft-form .field label .req {
                color: #e74c3c;
            }

        .ft-form .field input,
        .ft-form .field select,
        .ft-form .field textarea {
            width: 100%;
            border-radius: 10px;
            border: 1.5px solid #E5E1D3;
            padding: 11px 14px;
            font-size: 14px;
            background: #FAF9F4;
            outline: none;
            transition: all 0.25s;
            font-family: inherit;
