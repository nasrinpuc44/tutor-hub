                    + '  <button type="submit" class="btn-submit"><i class="fas fa-headset"></i> Send to Admin</button>'
                    + '  <p style="font-size:12px; color:#8A9188; text-align:center; margin:12px 0 0;"><i class="fas fa-shield-alt me-1"></i> Our admin team will contact you within 24 hours.</p>'
