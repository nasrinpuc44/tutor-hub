        }

    @@media (max-width: 992px) {
        .ft-layout {
            grid-template-columns: 1fr;
        }

        .ft-sidebar {
            position: static;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .area-tuition-card {
            grid-column: 1 / -1;
