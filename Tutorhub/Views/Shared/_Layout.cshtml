﻿
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Tutor Hub</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Tailwind Configuration -->
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            primary: '#1F3B2C',
                            cream: '#F3F1E7'
                        },
                        fontFamily: {
                            serif: ['Georgia', 'Cambria', '"Times New Roman"', 'Times', 'serif']
                        }
                    }
                }
            }
    </script>

    <style>
            body {
                background-color: #F3F1E7;
            }

            .navbar-custom {
                background-color: #F3F1E7 !important;
                border-bottom: 1px solid rgba(0,0,0,0.05);
            }

            .btn-primary-custom {
                background-color: #1F3B2C !important;
                border-color: #1F3B2C !important;
            }

                .btn-primary-custom:hover {
                    background-color: #152a1f !important;
                    border-color: #152a1f !important;
                }

            .text-primary-custom {
                color: #1F3B2C !important;
            }

            .bg-primary-custom {
                background-color: #1F3B2C !important;
            }

            .border-primary-custom {
                border-color: #1F3B2C !important;
            }

            .footer-custom {
                background-color: #F3F1E7;
                border-top: 1px solid rgba(0,0,0,0.05);
            }

            /* সাইডবার ওভারলে ফিক্স */
            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background-color: rgba(0, 0, 0, 0.5);
                z-index: 99;
            }

                .sidebar-overlay.active {
                    display: block;
                }

            /* পেজ কন্টেন্টের জন্য প্যাডিং */
            .page-content {
                padding-top: 80px;
            }

            /* অ্যাডমিন পেজের জন্য সাইডবার স্পেস */
            .admin-page .main-content {
                margin-left: 250px;
                padding: 20px;
                min-height: calc(100vh - 80px);
            }

            @@media (max-width: 992px) {
                .admin-page .main-content {
                    margin-left: 0;
                    padding: 20px 15px;
                }
            }

            /* ড্যাশবোর্ড সাইডবার স্টাইল - শুধু অ্যাডমিন পেজে */
            .admin-sidebar {
                position: fixed;
                top: 80px;
                left: 0;
                bottom: 0;
                width: 250px;
                background-color: #1F3B2C;
                color: white;
                padding: 20px 0;
                overflow-y: auto;
                z-index: 100;
                transition: transform 0.3s ease;
            }

            .admin-sidebar-brand {
                padding: 0 20px 20px 20px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                margin-bottom: 15px;
            }

                .admin-sidebar-brand h4 {
                    color: #F3F1E7;
                    font-weight: 600;
                    margin: 0;
                }

                .admin-sidebar-brand small {
                    color: #8A9188;
                    font-size: 12px;
                }

            .admin-sidebar-menu {
                list-style: none;
                padding: 0;
                margin: 0;
            }

                .admin-sidebar-menu li {
                    padding: 0;
                }

                    .admin-sidebar-menu li a {
                        display: flex;
                        align-items: center;
                        padding: 12px 20px;
                        color: #C7D0C9;
                        text-decoration: none;
                        transition: all 0.3s ease;
                        border-left: 3px solid transparent;
                        font-size: 14px;
                        cursor: pointer;
                    }

                        .admin-sidebar-menu li a:hover {
                            background-color: rgba(255, 255, 255, 0.05);
                            color: #ffffff;
                            border-left-color: #F4C744;
                        }

                        .admin-sidebar-menu li a.active {
                            background-color: rgba(255, 255, 255, 0.08);
                            color: #ffffff;
                            border-left-color: #F4C744;
                        }

                        .admin-sidebar-menu li a i {
                            width: 24px;
                            margin-right: 10px;
                            font-size: 16px;
                            text-align: center;
                        }

                        .admin-sidebar-menu li a .badge-sidebar {
                            margin-left: auto;
                            background-color: rgba(255, 255, 255, 0.15);
                            padding: 2px 10px;
                            border-radius: 12px;
                            font-size: 11px;
                            color: #F3F1E7;
                        }

            .admin-sidebar-footer {
                position: absolute;
                bottom: 20px;
                left: 0;
                right: 0;
                padding: 0 20px;
                text-align: center;
                border-top: 1px solid rgba(255,255,255,0.05);
                padding-top: 15px;
            }

                .admin-sidebar-footer small {
                    color: #6B7568;
                    font-size: 11px;
                }

                .admin-sidebar-footer strong {
                    color: #F3F1E7;
                }

            /* সাইডবার টগল বাটন */
            .sidebar-toggle-btn {
                display: none;
                position: fixed;
                top: 90px;
                left: 15px;
                z-index: 101;
                background-color: #1F3B2C;
                color: white;
                border: none;
                border-radius: 8px;
                padding: 10px 12px;
                font-size: 18px;
                cursor: pointer;
            }

                .sidebar-toggle-btn:hover {
                    background-color: #2d5a42;
                }

            @@media (max-width: 992px) {
                .admin-sidebar {
                    transform: translateX(-100%);
                }

                    .admin-sidebar.open {
                        transform: translateX(0);
                    }

                .sidebar-toggle-btn {
                    display: block;
                }

                .admin-page .main-content {
                    margin-left: 0;
                }
            }

            /* ===== ড্রপডাউন মেনু স্টাইল ===== */
            .profile-dropdown .dropdown-toggle {
                color: #1F3B2C !important;
                text-decoration: none !important;
                font-weight: 500;
                transition: opacity 0.3s;
                background: none;
                border: none;
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 0;
                cursor: pointer;
            }

            .profile-dropdown .dropdown-toggle:hover {
                opacity: 0.7;
            }

            .profile-dropdown .dropdown-toggle i {
                font-size: 18px;
            }

            .profile-dropdown .dropdown-toggle .caret {
                font-size: 12px;
                margin-left: 4px;
            }

            .profile-dropdown .dropdown-menu {
                border: none;
                border-radius: 12px;
                box-shadow: 0 8px 30px rgba(0,0,0,0.12);
                padding: 8px 0;
                min-width: 220px;
                background: white;
                margin-top: 8px;
            }

            .profile-dropdown .dropdown-menu .dropdown-header {
                padding: 10px 20px 6px;
                font-weight: 600;
                color: #1F3B2C;
                border-bottom: 1px solid #f0f0f0;
                margin-bottom: 4px;
            }

            .profile-dropdown .dropdown-menu .dropdown-header small {
                display: block;
                font-weight: 400;
                color: #6B7568;
                font-size: 12px;
            }

            .profile-dropdown .dropdown-menu .dropdown-item {
                padding: 10px 20px;
                color: #4B5648;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .profile-dropdown .dropdown-menu .dropdown-item:hover {
                background-color: #F3F1E7;
                color: #1F3B2C;
            }

            .profile-dropdown .dropdown-menu .dropdown-item i {
                width: 20px;
                text-align: center;
                color: #6B7568;
                font-size: 14px;
            }

            .profile-dropdown .dropdown-menu .dropdown-item:hover i {
                color: #1F3B2C;
            }

            .profile-dropdown .dropdown-menu .dropdown-divider {
                margin: 4px 0;
                border-color: #f0f0f0;
            }

            .profile-dropdown .dropdown-menu .dropdown-item.text-danger {
                color: #e74c3c;
            }

            .profile-dropdown .dropdown-menu .dropdown-item.text-danger i {
                color: #e74c3c;
            }

            .profile-dropdown .dropdown-menu .dropdown-item.text-danger:hover {
                background-color: #fde8e8;
            }

            .profile-dropdown .dropdown-menu .dropdown-item .badge-role {
                font-size: 10px;
                padding: 2px 10px;
                border-radius: 20px;
                font-weight: 600;
                background: #eef2f6;
                color: #6B7568;
                margin-left: auto;
            }

            .profile-dropdown .dropdown-menu .dropdown-item .badge-role.teacher {
                background: #d1ecf1;
                color: #0c6b7c;
            }

            .profile-dropdown .dropdown-menu .dropdown-item .badge-role.admin {
                background: #fff3cd;
                color: #b8860b;
            }

            /* ড্রপডাউন অ্যানিমেশন */
            .profile-dropdown .dropdown-menu {
                display: block;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-8px);
                transition: all 0.2s ease;
                pointer-events: none;
            }

            .profile-dropdown.show .dropdown-menu {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
                pointer-events: auto;
            }

            /* প্রোফাইল লিংক স্টাইল (পুরনো) */
            .profile-link {
                color: #1F3B2C !important;
                text-decoration: none !important;
                font-weight: 500;
                transition: opacity 0.3s;
            }

                .profile-link:hover {
                    opacity: 0.7;
                }

                .profile-link i {
                    margin-right: 5px;
                }
    </style>
</head>
<body>

    <!-- ========================================= -->
    <!-- NAVBAR -->
    <!-- ========================================= -->
    <header class="sticky-top z-50 border-b border-black/5" style="background-color:#F3F1E7;">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="h-20 flex items-center justify-between">

                <!-- Logo -->
                <div>
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                        <img src="https://i.ibb.co/fd9sY88Y/IMG-6916-1.png" alt="Smart Tutor Hub logo" class="w-12 h-12 rounded-full object-cover flex-shrink-0" />
                        <span class="font-serif text-lg sm:text-xl font-bold tracking-wide" style="color:#1F3B2C;">
                            SMART TUTOR HUB
                        </span>
                    </a>
                </div>

                <!-- Desktop Menu -->
                <div class="hidden lg:flex items-center gap-7 xl:gap-8">
                    <a asp-controller="Home" asp-action="Index" class="text-sm font-medium transition hover:opacity-70" style="color:#4B5648;">Home</a>
                    <a asp-controller="Learn" asp-action="Index" class="text-sm font-medium transition hover:opacity-70" style="color:#4B5648;">Learn</a>
                    <a asp-controller="Practice" asp-action="Index" class="text-sm font-medium transition hover:opacity-70" style="color:#4B5648;">Practice</a>
                    <a asp-controller="Progress" asp-action="Progress" class="text-sm font-medium transition hover:opacity-70" style="color:#4B5648;">Progress</a>
                    <a asp-controller="Leaderboard" asp-action="Leaderboard" class="text-sm font-medium transition hover:opacity-70" style="color:#4B5648;">Leaderboard</a>
                </div>

                <!-- Desktop Right Side - User Dropdown -->
                <div class="hidden lg:flex items-center">
                    @if (Context.Session.GetString("UserName") != null)
                    {
                        var userRole = Context.Session.GetString("UserRole");
                        var isTeacher = userRole == "Teacher";
                        var isAdmin = userRole == "Admin";
                        var userFullName = Context.Session.GetString("UserFullName") ?? Context.Session.GetString("UserName");
                        var userInitials = "";
                        if (!string.IsNullOrEmpty(userFullName))
                        {
                            var names = userFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            if (names.Length >= 2)
                            {
                                userInitials = names[0][0].ToString().ToUpper() + names[1][0].ToString().ToUpper();
                            }
                            else if (names.Length == 1 && names[0].Length > 0)
                            {
                                userInitials = names[0][0].ToString().ToUpper();
                            }
                            else
                            {
                                userInitials = "U";
                            }
                        }
                        else
                        {
                            userInitials = "U";
                        }

                        <div class="profile-dropdown dropdown" id="profileDropdown">
                            <button class="dropdown-toggle" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle"></i>
                                <span>@userFullName</span>
                                <span class="caret"><i class="fas fa-chevron-down"></i></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuButton">
                                <li class="dropdown-header">
                                    @userFullName
                                    <small>@Context.Session.GetString("UserName")</small>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                        <i class="fas fa-id-card"></i> My Profile
                                    </a>
                                </li>
                                @if (isTeacher)
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Teacher" asp-action="TeacherDashboard">
                                            <i class="fas fa-chalkboard-teacher"></i> Teacher Dashboard
                                            <span class="badge-role teacher">Teacher</span>
                                        </a>
                                    </li>
                                }
                                @if (isAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                            <i class="fas fa-shield-alt"></i> Admin Panel
                                            <span class="badge-role admin">Admin</span>
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-controller="Account" asp-action="Logout" id="logoutFormDesktop">
                                        @Html.AntiForgeryToken()
                                        <a class="dropdown-item text-danger" href="#" onclick="document.getElementById('logoutFormDesktop').submit(); return false;">
                                            <i class="fas fa-sign-out-alt"></i> Logout
                                        </a>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2">
                            <a asp-controller="Account" asp-action="Login" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full font-semibold text-white text-sm transition hover:opacity-90" style="background-color:#1F3B2C;">
                                <i class="fas fa-sign-in-alt"></i> Login
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0-4 4m4-4H3" />
                                </svg>
                            </a>
                        </div>
                    }
                </div>

                <!-- Mobile Menu Button -->
                <button id="mobileMenuButton" type="button" class="lg:hidden focus:outline-none" style="color:#1F3B2C;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-7 h-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                </button>
            </div>

            <!-- Mobile Menu -->
            <div id="mobileMenu" class="hidden lg:hidden pb-5">
                <div class="flex flex-col gap-4">
                    <a asp-controller="Home" asp-action="Index" class="text-sm" style="color:#4B5648;">Home</a>
                    <a asp-controller="Learn" asp-action="Index" class="text-sm" style="color:#4B5648;">Learn</a>
                    <a asp-controller="Practice" asp-action="Index" class="text-sm" style="color:#4B5648;">Practice</a>
                    <a asp-controller="Progress" asp-action="Progress" class="text-sm" style="color:#4B5648;">Progress</a>
                    <a asp-controller="Leaderboard" asp-action="Leaderboard" class="text-sm" style="color:#4B5648;">Leaderboard</a>

                    <hr class="border-black/5" />

                    @if (Context.Session.GetString("UserName") != null)
                    {
                        var userRoleMobile = Context.Session.GetString("UserRole");
                        var isTeacherMobile = userRoleMobile == "Teacher";
                        var isAdminMobile = userRoleMobile == "Admin";
                        var userFullNameMobile = Context.Session.GetString("UserFullName") ?? Context.Session.GetString("UserName");

                        <div class="flex flex-col gap-2">
                            <!-- মোবাইলে ইউজারের নাম দেখানো -->
                            <div class="text-sm font-semibold" style="color:#1F3B2C; padding: 4px 0;">
                                <i class="fas fa-user-circle me-2"></i> @userFullNameMobile
                                <span class="text-xs font-normal text-muted" style="color:#6B7568;">(@Context.Session.GetString("UserName"))</span>
                            </div>

                            <a asp-controller="Profile" asp-action="Index" class="text-sm font-medium" style="color:#1F3B2C;">
                                <i class="fas fa-id-card me-2"></i> My Profile
                            </a>

                            @if (isTeacherMobile)
                            {
                                <a asp-controller="Teacher" asp-action="TeacherDashboard" class="text-sm font-medium" style="color:#1F3B2C;">
                                    <i class="fas fa-chalkboard-teacher me-2"></i> Teacher Dashboard
                                    <span class="text-xs text-muted" style="color:#0c6b7c;">Teacher</span>
                                </a>
                            }

                            @if (isAdminMobile)
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="text-sm font-medium" style="color:#1F3B2C;">
                                    <i class="fas fa-shield-alt me-2"></i> Admin Panel
                                    <span class="text-xs text-muted" style="color:#b8860b;">Admin</span>
                                </a>
                            }

                            <hr class="border-black/5" />

                            <form method="post" asp-controller="Account" asp-action="Logout" id="logoutFormMobile">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-sm font-medium text-left" style="color:#e74c3c; background:none; border:none; cursor:pointer; width:100%; padding: 4px 0;">
                                    <i class="fas fa-sign-out-alt me-2"></i> Logout
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col gap-2">
                            <a asp-controller="Account" asp-action="Login" class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-full font-semibold text-white text-sm" style="background-color:#1F3B2C;">
                                <i class="fas fa-sign-in-alt"></i> Login
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- ========================================= -->
    <!-- PAGE CONTENT -->
    <!-- ========================================= -->
    <main>
        @RenderBody()
    </main>

    <!-- ========================================= -->
    <!-- FOOTER -->
    <!-- ========================================= -->
    <footer class="border-t border-black/5" style="background-color:#F3F1E7;">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
            <div class="flex flex-col sm:flex-row items-center sm:items-start justify-between gap-6">

                <!-- Logo + tagline -->
                <div class="flex items-start gap-2.5 text-center sm:text-left">
                    <img src="https://i.ibb.co/fd9sY88Y/IMG-6916-1.png" alt="Smart Tutor Hub logo" class="w-12 h-12 rounded-full object-cover flex-shrink-0" />
                    <div>
                        <p class="font-serif text-base sm:text-lg font-bold tracking-wide" style="color:#1F3B2C;">
                            SMART TUTOR HUB
                        </p>
                        <p class="mt-1 text-xs sm:text-sm" style="color:#6B7568;">
                            Personalized, adaptive, and interactive learning experiences powered by AI.
                        </p>
                    </div>
                </div>

                <!-- Follow us -->
                <div class="flex items-center gap-4">
                    <span class="text-sm" style="color:#8A9188;">Follow us</span>
                    <a href="#" aria-label="Twitter" class="transition hover:opacity-70" style="color:#8A9188;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                            <path d="M22.46 6c-.77.35-1.6.58-2.46.69a4.3 4.3 0 0 0 1.88-2.37 8.59 8.59 0 0 1-2.72 1.04 4.28 4.28 0 0 0-7.29 3.9 12.14 12.14 0 0 1-8.82-4.47 4.28 4.28 0 0 0 1.32 5.71A4.24 4.24 0 0 1 2.8 9.7v.05a4.28 4.28 0 0 0 3.43 4.2 4.3 4.3 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.97A8.6 8.6 0 0 1 2 18.57a12.1 12.1 0 0 0 6.56 1.92c7.88 0 12.2-6.53 12.2-12.2 0-.19 0-.37-.01-.56A8.72 8.72 0 0 0 22.46 6Z" />
                        </svg>
                    </a>
                    <a href="#" aria-label="YouTube" class="transition hover:opacity-70" style="color:#8A9188;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                            <path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.51 3.5 12 3.5 12 3.5s-7.51 0-9.38.55A3.02 3.02 0 0 0 .5 6.19 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.87.55 9.38.55 9.38.55s7.51 0 9.38-.55a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.81ZM9.6 15.6V8.4l6.27 3.6L9.6 15.6Z" />
                        </svg>
                    </a>
                    <a href="#" aria-label="Facebook" class="transition hover:opacity-70" style="color:#8A9188;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                            <path d="M13.5 22v-8.5h2.85l.43-3.31H13.5V8.06c0-.96.27-1.61 1.64-1.61h1.75V3.5c-.3-.04-1.35-.13-2.56-.13-2.53 0-4.27 1.55-4.27 4.38v2.44H7.2v3.31h2.86V22h3.44Z" />
                        </svg>
                    </a>
                    <a href="#" aria-label="Instagram" class="transition hover:opacity-70" style="color:#8A9188;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                            <rect x="3" y="3" width="18" height="18" rx="5" />
                            <circle cx="12" cy="12" r="4" />
                            <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Bottom line -->
            <div class="border-t border-black/10 mt-8 pt-6 text-center">
                <p class="text-xs sm:text-sm" style="color:#8A9188;">
                    &copy; @DateTime.Now.Year Smart Tutor Hub. All Rights Reserved.
                </p>
            </div>
        </div>
    </footer>

    <!-- ========================================= -->
    <!-- MOBILE MENU JAVASCRIPT -->
    <!-- ========================================= -->
    <script>
            const mobileMenuButton = document.getElementById("mobileMenuButton");
            const mobileMenu = document.getElementById("mobileMenu");

            mobileMenuButton.addEventListener("click", function() {
                mobileMenu.classList.toggle("hidden");
            });

            // ড্রপডাউন ম্যানুয়ালি টগল করার জন্য (Bootstrap 5 এর সাথে)
            document.addEventListener('DOMContentLoaded', function() {
                const dropdownToggle = document.querySelector('.profile-dropdown .dropdown-toggle');
                if (dropdownToggle) {
                    dropdownToggle.addEventListener('click', function(e) {
                        e.preventDefault();
                        const parent = this.closest('.profile-dropdown');
                        if (parent) {
                            parent.classList.toggle('show');
                        }
                    });
                }

                // ড্রপডাউনের বাইরে ক্লিক করলে বন্ধ
                document.addEventListener('click', function(e) {
                    const dropdown = document.querySelector('.profile-dropdown');
                    if (dropdown && !dropdown.contains(e.target)) {
                        dropdown.classList.remove('show');
                    }
                });
            });
    </script>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>